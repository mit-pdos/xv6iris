+Definition uexitst (m : regfile) : Z :=
+  bv_signed (subrange_vec_dec (m !!! Regidx (mword_of_int 10)) 31 0 : mword 32).
+
+Lemma uexitst_exit_xs (m : regfile) (pc : mword 64) :
+  exit_xs (tf_of m pc) = uexitst m.
