+    iDestruct "He" as (pa' Q0 Q') "[Hk [Hmy HQ]]".
+    iDestruct "Hmy" as (pa'' pid') "Hmy".
+    iDestruct (gen_agree with "Ht Hmy") as "[_ Heq]".
