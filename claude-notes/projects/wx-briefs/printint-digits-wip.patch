+(* THE DIGIT COUNT FITS THE RENDERER'S FUEL.  The fill loop's own bound is
+   the C array's 20 slots; what pins [k <= 20] is arithmetic -- a [k]-digit
+   value in base >= 10 is at least [10^(k-1)], and every value printint sees
+   is below [10^20]. *)
+Lemma pi_ndigits_le (base x : Z) (k : nat) :
+  10 <= base -> 0 <= x -> x < 10 ^ 20 ->
+  (k = 1%nat \/ x / base ^ Z.of_nat (k - 1) <> 0) -> (k <= 20)%nat.
+Proof.
+  intros Hb Hx Hlt Hmin.
+  destruct Hmin as [-> | Hnz]; [lia | ].
+  destruct (decide (k <= 20)%nat) as [Hle | Hgt]; [exact Hle | exfalso].
+  apply Hnz. apply Z.div_small. split; [exact Hx | ].
+  apply (Z.lt_le_trans _ (10 ^ 20)); [exact Hlt | ].
+  apply (Z.le_trans _ (10 ^ Z.of_nat (k - 1))).
+  - apply Z.pow_le_mono_r; lia.
+  - apply Z.pow_le_mono_l. lia.
+Qed.
