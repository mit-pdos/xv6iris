+(* the slots below [k] are all the emitted list reads *)
+Lemma pi_slots_ext (g h : nat -> bv 8) (k : nat) :
+  (forall j : nat, (j < k)%nat -> g j = h j) -> pi_slots g k = pi_slots h k.
+Proof.
+  revert g h. induction k as [|k IH]; intros g h Hgh; [reflexivity | ].
+  cbn [pi_slots]. rewrite (Hgh k ltac:(lia)). f_equal.
+  apply IH. intros j Hj. apply Hgh. lia.
+Qed.
