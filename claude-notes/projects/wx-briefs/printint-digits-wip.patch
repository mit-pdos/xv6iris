+Lemma pi_slots_digits (base x : Z) (k : nat) (g : nat -> bv 8) :
+  2 <= base -> 0 <= x -> (1 <= k)%nat -> (k <= 20)%nat ->
+  (forall j : nat, (j < k)%nat ->
+     g j = pi_digit ((x / base ^ Z.of_nat j) mod base)) ->
+  x / base ^ Z.of_nat k = 0 ->
+  (k = 1%nat \/ x / base ^ Z.of_nat (k - 1) <> 0) ->
+  pi_slots g k = printint_digits base x.
+Proof.
+  intros Hb Hx Hk1 Hk20 Hdig Hz Hmin.
+  rewrite /printint_digits.
+  exact (pi_slots_digits_aux base Hb 20%nat k g x Hx Hk1 Hk20 Hdig Hz Hmin).
+Qed.
