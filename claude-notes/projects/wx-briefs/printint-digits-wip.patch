+(* ---- the two-word arithmetic the sign path needs (milestone B) ------- *)
+
+(* a NEGATIVE signed value, as its unsigned word.  The mirror of
+   [RiscvExtras.sint64_unsigned], and it carries the range too, because the
+   negation below needs it. *)
+Lemma pi_sint_neg (b : mword 64) :
+  (sint b < 0)%Z ->
+  (9223372036854775808 <= bv_unsigned b)%Z /\
+  sint b = (bv_unsigned b - 18446744073709551616)%Z.
+Proof.
+  intro H.
+  assert (Hs : sint b = bv_signed b) by reflexivity.
+  pose proof (bv_unsigned_in_range _ b) as Hr.
+  assert (Hm : bv_modulus 64 = 18446744073709551616%Z) by (vm_compute; reflexivity).
+  assert (Hh : bv_half_modulus 64 = 9223372036854775808%Z) by (vm_compute; reflexivity).
+  rewrite Hm in Hr.
+  rewrite Hs in H |- *.
+  unfold bv_signed, bv_swrap, bv_wrap in H |- *.
+  rewrite Hh Hm in H |- *.
+  destruct (Z.lt_ge_cases (bv_unsigned b) 9223372036854775808%Z) as [Hlo | Hhi].
+  - exfalso.
+    rewrite (Z.mod_small (bv_unsigned b + 9223372036854775808) 18446744073709551616)
+      in H; lia.
+  - assert (Hq : ((bv_unsigned b + 9223372036854775808) mod 18446744073709551616)%Z
+                 = (bv_unsigned b - 9223372036854775808)%Z).
+    { replace (bv_unsigned b + 9223372036854775808)%Z
+        with ((bv_unsigned b - 9223372036854775808) + 1 * 18446744073709551616)%Z by lia.
+      rewrite Z.mod_add; [| lia]. apply Z.mod_small. lia. }
+    rewrite Hq. lia.
+Qed.
+
+(* [neg a0,a0] at +0x8e, in the only case the code runs it *)
+Lemma pi_neg_uint (a : mword 64) :
+  (sint a < 0)%Z -> uint (sub_vec (zero_reg : mword 64) a) = (- sint a)%Z.
+Proof.
+  intro H.
+  destruct (pi_sint_neg a H) as [Hhi Hsn].
+  pose proof (bv_unsigned_in_range _ a) as Hr.
+  assert (Hm : bv_modulus 64 = 18446744073709551616%Z) by (vm_compute; reflexivity).
+  rewrite Hm in Hr.
+  rewrite uint_unsigned sub_vec64_unsigned.
+  assert (Hz : bv_unsigned (zero_reg : mword 64) = 0%Z) by (vm_compute; reflexivity).
+  rewrite Hz. unfold bv_wrap. rewrite Hm.
+  replace (0 - bv_unsigned a)%Z
+    with ((18446744073709551616 - bv_unsigned a) + (-1) * 18446744073709551616)%Z by lia.
+  rewrite Z.mod_add; [| lia]. rewrite Z.mod_small; lia.
+Qed.
