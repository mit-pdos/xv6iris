+(* THE BYTES THE PRINT LOOP EMITS (milestone B): the buffer's slots
+   [k-1 .. 0], in that order -- printint fills [buf] least-significant-first
+   and prints it backwards.  Spelled as a fixpoint rather than [rev (seq …)]
+   so that one turn of the loop is a definitional step. *)
+Fixpoint pi_slots (g : nat -> bv 8) (k : nat) : list (bv 8) :=
+  match k with O => [] | S k' => g k' :: pi_slots g k' end.
+
+(* ...and the same list peeled at the OTHER end, which is the end
+   [PrintkRender.pi_digits_aux] recurses on. *)
+Lemma pi_slots_snoc (g : nat -> bv 8) (k : nat) :
+  pi_slots g (S k) = (pi_slots (fun j => g (S j)) k ++ [g 0%nat])%list.
+Proof.
+  revert g. induction k as [|k IH]; intro g; [reflexivity | ].
+  change (pi_slots g (S (S k))) with (g (S k) :: pi_slots g (S k)).
+  change (pi_slots (fun j => g (S j)) (S k))
+    with (g (S k) :: pi_slots (fun j => g (S j)) k).
+  cbn [app]. by rewrite (IH g).
+Qed.
+
+(* ONE DIGIT OFF (milestone B): dividing by the base once and then by
+   [base^k] is dividing by [base^(k+1)] -- the equation that turns the digit
+   loop's recursion on the QUOTIENT into a statement about the digits of the
+   value the loop was entered with. *)
+Lemma pi_div_pow_succ (x bb : Z) (k : nat) :
+  0 <= x -> 1 <= bb -> (x / bb) / bb ^ Z.of_nat k = x / bb ^ Z.of_nat (S k).
+Proof.
+  intros Hx Hb.
+  rewrite Z.div_div; [ | lia | apply Z.pow_pos_nonneg; lia ].
+  f_equal. rewrite Nat2Z.inj_succ Z.pow_succ_r; lia.
+Qed.
+
+(* THE BRIDGE (milestone B): the slots the two loops filled ARE the pure
+   rendering [PrintkRender.printint_digits].  The hypotheses are exactly what
+   the digit loop's post carries -- every slot below [k] is the base-[base]
+   digit at its own position, the value is exhausted at [k], and [k] is the
+   first such index ([k = 1] covers the [x = 0] run, which prints one '0'
+   because the fill loop is a do-while). *)
+Lemma pi_slots_digits_aux (base : Z) (Hb : 2 <= base) :
+  forall (f k : nat) (g : nat -> bv 8) (x : Z),
+  0 <= x -> (1 <= k)%nat -> (k <= f)%nat ->
+  (forall j : nat, (j < k)%nat ->
+     g j = pi_digit ((x / base ^ Z.of_nat j) mod base)) ->
+  x / base ^ Z.of_nat k = 0 ->
+  (k = 1%nat \/ x / base ^ Z.of_nat (k - 1) <> 0) ->
+  pi_slots g k = pi_digits_aux f base x.
+Proof.
+  induction f as [|f' IH]; intros k g x Hx Hk1 Hkf Hdig Hz Hmin; [lia | ].
+  cbn [pi_digits_aux].
+  assert (Hd0 : g 0%nat = pi_digit (x mod base)).
+  { rewrite (Hdig 0%nat ltac:(lia)). by rewrite Z.pow_0_r Z.div_1_r. }
+  destruct (Z.eqb (x / base) 0) eqn:Eq.
+  - (* one digit: the value is already exhausted, so [k] can only be 1 *)
+    apply Z.eqb_eq in Eq.
+    assert (Hk : k = 1%nat).
+    { destruct (decide (k = 1)%nat) as [Hke | Hne]; [exact Hke | exfalso].
+      destruct Hmin as [Hone | Hnz]; [lia | ]. apply Hnz.
+      replace (k - 1)%nat with (S (k - 2))%nat by lia.
+      rewrite -(pi_div_pow_succ x base (k - 2)%nat Hx ltac:(lia)) Eq.
+      apply Z.div_0_l. apply Z.pow_nonzero; lia. }
+    subst k. cbn [pi_slots app]. by rewrite Hd0.
+  - (* at least two: recurse on the quotient, one slot up *)
+    apply Z.eqb_neq in Eq.
+    assert (Hk2 : (2 <= k)%nat).
+    { destruct (decide (k = 1)%nat) as [Hke | Hne]; [ | lia].
+      exfalso. apply Eq. subst k. by rewrite Z.pow_1_r in Hz. }
+    assert (Hrec : pi_slots (fun j => g (S j)) (k - 1)%nat
+                   = pi_digits_aux f' base (x / base)).
+    { apply (IH (k - 1)%nat (fun j => g (S j)) (x / base)).
+      - apply Z.div_pos; lia.
+      - lia.
+      - lia.
+      - intros j Hj. rewrite (Hdig (S j) ltac:(lia)).
+        by rewrite (pi_div_pow_succ x base j Hx ltac:(lia)).
+      - rewrite (pi_div_pow_succ x base (k - 1)%nat Hx ltac:(lia)).
+        by replace (S (k - 1))%nat with k by lia.
+      - right. replace (k - 1 - 1)%nat with (k - 2)%nat by lia.
+        rewrite (pi_div_pow_succ x base (k - 2)%nat Hx ltac:(lia)).
+        replace (S (k - 2))%nat with (k - 1)%nat by lia.
+        destruct Hmin as [Hone | Hnz]; [lia | exact Hnz]. }
+    replace k with (S (k - 1))%nat by lia.
+    rewrite pi_slots_snoc Hrec Hd0. reflexivity.
+Qed.
