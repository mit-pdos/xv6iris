From 0d37370ee44ebfcebb9c73fb41e4f7cfbf973b11 Mon Sep 17 00:00:00 2001
From: Nickolai Zeldovich <kolyaz@gmail.com>
Date: Wed, 26 Aug 2026 19:45:32 -0400
Subject: [PATCH] Tag instruction fetches and page table walks at the
 concurrency interface

read_kind_of_flags picks the read kind from the acquire/release/reserved
flags alone, so an instruction fetch, a translation table walk and an
ordinary data load all arrive at sail_mem_read as the same event:
AK_explicit { variety = AV_plain, strength = AS_normal }.

The concurrency interface defines access kinds for exactly these two
classes (AK_ifetch and AK_ttw, in lib/concurrency_interface/read_write_v1.sail),
but the model never produces either. Read_ifetch is in enum read_kind and
does map to AK_ifetch, yet nothing in the model ever passes it, and no read
kind maps to AK_ttw at all.

That makes the emitted event stream unfaithful for anything that consumes
it as a concurrency trace. RVWMO constrains explicit accesses; instruction
fetch coherence (Zifencei) and translation table walk coherence
(sfence.vma, Svvptc) are separate architectural axes. A memory model
backend, a litmus test harness, or a port of the model into a concurrent
setting has to be able to tell the three classes apart, and today there is
nothing in the event stream to key on.

So choose the read kind from the access type rather than from the flags:

  InstructionFetch()   -> Read_ifetch -> AK_ifetch()
  Load(PageTableEntry) -> Read_ttw    -> AK_ttw()    (new read kind)
  everything else      -> unchanged, read_kind_of_flags(aq, rl, res)

The match is guarded on res so that a reserved read keeps its exclusive
kind whatever it is reading. Today check_pma asserts that a fetch or a PTE
access is never reserved, so the guard cannot fire; it is there so that an
implementation which reads a PTE under a reservation - an LR/SC based A/D
bit update, say - does not silently lose its exclusivity when it is added.

No existing read kind changes meaning, and sequential and functional
behaviour is unaffected: the read kind is only observed through the
concurrency interface's access kind, which the sequential backends ignore.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JydfJbMNN5S3672igkhL7e
---
 model/core/phys_mem_interface.sail |  7 +++++++
 model/sys/mem.sail                 | 18 +++++++++++++++++-
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/model/core/phys_mem_interface.sail b/model/core/phys_mem_interface.sail
index 688350c..95196a8 100644
--- a/model/core/phys_mem_interface.sail
+++ b/model/core/phys_mem_interface.sail
@@ -30,6 +30,12 @@ enum write_kind = {
 enum read_kind = {
   Read_plain,
   Read_ifetch,
+  // A translation table walk's read of a PTE. Like an instruction fetch this
+  // is an implicit access, not an explicit one: the RVWMO rules constrain
+  // explicit accesses, while fetch and walk coherence are separate
+  // architectural axes (Zifencei, sfence.vma / Svvptc). It therefore gets its
+  // own kind, which maps to the concurrency interface's AK_ttw.
+  Read_ttw,
   // Note: Read_RISCV_acquire and Read_RISCV_strong_acquire are currently
   // unused but removing them may break Isla, and they might be used in future
   // by Zalasr.
@@ -128,6 +134,7 @@ function read_ram(rk, Physaddr(addr), width, read_meta) = {
     access_kind = match rk {
       Read_plain => AK_explicit(struct { variety = AV_plain, strength = AS_normal }),
       Read_ifetch => AK_ifetch(),
+      Read_ttw => AK_ttw(),
       Read_RISCV_acquire => internal_error(__FILE__, __LINE__, "Read_RISCV_acquire is unused"),
       Read_RISCV_strong_acquire => internal_error(__FILE__, __LINE__, "Read_RISCV_strong_acquire is unused"),
       Read_RISCV_reserved => AK_explicit(struct { variety = AV_exclusive, strength = AS_normal }),
diff --git a/model/sys/mem.sail b/model/sys/mem.sail
index a99c084..d94fa5d 100644
--- a/model/sys/mem.sail
+++ b/model/sys/mem.sail
@@ -284,7 +284,23 @@ private function checked_mem_read forall 'n, 0 < 'n <= max_mem_access . (
   var i : range(0, 'N - 1) = first;
   var finished : bool = false;
 
-  let rk = read_kind_of_flags(aq, rl, res);
+  // The read kind is decided by the access type, not by the ordering flags
+  // alone. An instruction fetch and a translation table walk are implicit
+  // accesses rather than explicit ones, and the concurrency interface has
+  // kinds that say so (AK_ifetch / AK_ttw); tagging them here is what lets a
+  // concurrency backend constrain explicit accesses without also constraining
+  // fetch and walk coherence, which are separate architectural axes.
+  //
+  // A reserved read keeps its exclusive kind whatever it is reading, so the
+  // match is guarded on `res`. Today a fetch or a PTE read is never reserved
+  // (check_pma asserts as much), so the guard is dead, but it keeps this
+  // correct for an implementation that reads a PTE with a reservation, e.g.
+  // an LR/SC-based A/D bit update.
+  let rk : read_kind = match (access, res) {
+    (InstructionFetch(), false)   => Read_ifetch,
+    (Load(PageTableEntry), false) => Read_ttw,
+    (_, _)                        => read_kind_of_flags(aq, rl, res),
+  };
 
   repeat {
     let offset = i;

