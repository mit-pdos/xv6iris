/-
Weak: **THEOREM 2, STAGE 2 / certificate (a-), PREFIX WITNESS: THE CONCRETE GRAPH AND ITS
PREMISE BUNDLE** — `AxSpinT2p1c.gAm` = `AxSpinT2p1.gT1` at the recorded emissions of the drives
of `AxSpinT2p1a` (A) and `AxSpinT2p1b` (B) and the phantom C's empty emission, and on it every
stage-2 row / run premise of A and B that the computation half supplies, with BOTH harts
INCOMPLETE and neither at a cut.

Lean-only (no Rocq source).  Stage-2 design `notes/weak-lb-thm2-stage2.md` §C (certificate (a-),
acceptance (ii): `allocpidOpen2` applied with B incomplete — the application itself is the later
capstone's).

## What this file proves

`catAm : rvwmoCatConsistentT gAm`, `ctrlAm : ctrlClosed gAm` (GENERIC `graphOfSc` lemmas on the
drives' emission checks, read back — no drive re-run), `hartsAm` (gmo harts ⊆ [0, 1, 2]),
`runAm` (A's / B's RUN premise `nsteps (tierAAstep (gtAdGd gAm) nm i) (n i) (s0 i) (sN i)` from
the warm entry state `AxEpiRun.st (cpuOf i) (.pure ()) (regsE i) ibNone 0` to the row end, final
program `.pure`, hence `¬ midState`), and the bundle **`prefixWitness`**: for i ∈ {A = 0, B = 1}
with `q_A = q0`, `q_B = qB1`:
  `allocPre (grow (gtAdGd gAm) i) q_i i (sZ i) (pEx i)` ∧ `AllocPins2 (gtAdGd gAm) i q_i` ∧
  `¬ t2Cut (gtAdGd gAm) i (sZ i) (pEx i)` ∧ `¬ t2Complete (gtAdGd gAm) i (sZ i) (pEx i)`,
plus `HimgNoff` on the graph image and the row lengths (A: 101 = `t2KBd q0 + 66`, B: 38 =
`t2KSp qB1 + 1`).

## Pins / honesty
* As `AxSpinT2p1` (literal generated by the untrusted tracer; soundness from `drive2`; inherited
  (a′) scope: table shape, warm TLB, image).  The entry `entryOk` (incl. `ctrlOkSW`) is the
  stage-1 fact `AxSpinT2e3.entryR` (graph-independent); text / translation / `MapOk` are
  `AxSpinT2c5`'s (image-only); `textFixed` is `AxSpinT2p1.textFixed1`.

Reused: `AxSpinT2p1.*`, `AxSpinT2p1a.runA`/`emsA`, `AxSpinT2p1b.runB`/`emsB`,
`AxSpinT2c1.finNotMid`.  Names: Lean-only, `Weak.AxSpinT2p1c.*`.
-/
import Weak.AxSpinT2p1a
import Weak.AxSpinT2p1b

namespace Weak

open MachCSL MachCSL.Stdpp
open Sail Sail.ConcurrencyInterfaceV1
open LeanRV64D LeanRV64D.Functions
open AxSpinT2pt AxSpinT2p1
open AxSpinT2c1 (hartOkB q0 sZ)

namespace AxSpinT2p1c

/-- THE CONCRETE PREFIX-WITNESS GRAPH (A's and B's recorded emissions, the phantom's empty one). -/
noncomputable def gAm : GdexecT := gT1 [AxSpinT2p1a.emsA, AxSpinT2p1b.emsB, []]

theorem okA : hartOkB rows1 0 AxSpinT2p1a.emsA = true := by
  obtain ⟨_, _, _, h, _⟩ := AxSpinT2p1a.runA; exact h

theorem okB : hartOkB rows1 1 AxSpinT2p1b.emsB = true := by
  obtain ⟨_, _, _, h, _⟩ := AxSpinT2p1b.runB; exact h

/-- Consistency of the concrete graph, by the GENERIC SC lemma. -/
theorem catAm : rvwmoCatConsistentT gAm :=
  AxSpinT2p1.catOf rows1 il1 _ _ _ shil1 okA okB okC1

/-- Ctrl closure of the concrete graph. -/
theorem ctrlAm : ctrlClosed gAm := AxSpinT2p1.ctrlOf rows1 il1 _ _ _ okA okB okC1

/-- Only harts 0, 1 (2 is a phantom) emit memory events. -/
theorem hartsAm : ∀ e, e ∈ gAm.gtG.gxGmo → e.1 ∈ [0, 1, 2] := by
  intro e he
  have H : il1.all (fun e : Geid => decide (e.1 ∈ [0, 1, 2])) = true := by decide +kernel
  exact of_decide_eq_true (List.all_eq_true.1 H e he)

/-- A's and B's RUN premises on the concrete graph (to the row end, at an instruction boundary). -/
theorem runAm (i : Agent) (hi : i ∈ [0, 1]) : ∃ (u : Unit) (rs : RegFile) (ib : Ibch) (n : Nat),
    (∀ (N : Type) (nm : N), nsteps (tierAAstep (gtAdGd gAm) nm i) n
      (AxEpiRun.st (cpuOf i) (.pure ()) (regsE i) ibNone 0)
      (AxEpiRun.st (cpuOf i) (.pure u) rs ib (AxOpsem.grow (gtAdGd gAm) i).length)) ∧
    ¬ midState (AxEpiRun.st (cpuOf i) (.pure u) rs ib (AxOpsem.grow (gtAdGd gAm) i).length) := by
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl
  · obtain ⟨u, rs, ib, -, H⟩ := AxSpinT2p1a.runA
    obtain ⟨n, Hn⟩ := H [AxSpinT2p1a.emsA, AxSpinT2p1b.emsB, []]
    exact ⟨u, rs, ib, n, fun N nm => Hn _ N nm, AxSpinT2c1.finNotMid _ _ _ _ _⟩
  · obtain ⟨u, rs, ib, -, H⟩ := AxSpinT2p1b.runB
    obtain ⟨n, Hn⟩ := H [AxSpinT2p1a.emsA, AxSpinT2p1b.emsB, []]
    exact ⟨u, rs, ib, n, fun N nm => Hn _ N nm, AxSpinT2c1.finNotMid _ _ _ _ _⟩

/-- **THE PREFIX WITNESS (a-), premise bundle**: on the concrete graph, A (through `sw nextpid`)
and B (through one failed claim) are family rows with their guarded pins, NEITHER is at a cut,
and BOTH are incomplete. -/
theorem prefixWitness :
    (AxOpsem.grow (gtAdGd gAm) 0).length = t2KBd q0 + 66 ∧
    (AxOpsem.grow (gtAdGd gAm) 1).length = t2KSp qB1 + 1 ∧
    allocPre (AxOpsem.grow (gtAdGd gAm) 0) q0 0 (sZ 0) (AxSpinT2a.pEx 0) ∧
    allocPre (AxOpsem.grow (gtAdGd gAm) 1) qB1 1 (sZ 1) (AxSpinT2a.pEx 1) ∧
    AllocPins2 (gtAdGd gAm) 0 q0 ∧ AllocPins2 (gtAdGd gAm) 1 qB1 ∧
    ¬ t2Cut (gtAdGd gAm) 0 (sZ 0) (AxSpinT2a.pEx 0) ∧
    ¬ t2Cut (gtAdGd gAm) 1 (sZ 1) (AxSpinT2a.pEx 1) ∧
    ¬ t2Complete (gtAdGd gAm) 0 (sZ 0) (AxSpinT2a.pEx 0) ∧
    ¬ t2Complete (gtAdGd gAm) 1 (sZ 1) (AxSpinT2a.pEx 1) ∧
    HimgNoff (gtAdGd gAm).gdG.gxImg 0 1 :=
  ⟨by unfold gAm; rw [growA1]; exact ends1.1, by unfold gAm; rw [growB1]; exact ends1.2, preA1 _, preB1G _, pinsA1 _,
    pinsB1 _, notCutA1 _, notCutB1 _, notCompleteA1 _, notCompleteB1 _, imgNoff1 _⟩

end AxSpinT2p1c

end Weak
