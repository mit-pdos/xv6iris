/-
Weak/Prom: **the decoder check** (S0-P part (3); plan rev 7 §1A, decider of families C-D and C-R: "kernel `decide`
of the emitted label against the §rvwmo listing: sources and destinations per encoding class, plus the label's
aq/rl bits … and the label constructor per access kind").

For every class of `DecoderTable.classes` the EXPECTED roles (the listing, transcribed there) are compared with the
roles the emission puts on its labels, computed by the emission's OWN pure functions on the class's encoding:
* emission v2 (`Emit.lean`): `depsAddr`/`depsVsrc`/`depsCtrl` of `v2Roles`, `regSrcs` per register written,
  `dsrcOfRs1` for a Zicbom `LCmo` (`pureV2`);
* today's emission (`WeakEvInst.pnodeStep` / `WeakEvLang.erwOf`): `depsAsrc` (D-8), `depsVsrc`, and `erwOf`'s
  `erwSrcs dec ibRds` with DEC-7's dynamic read set (`pureToday`).
Which registers Sail writes, today's read sets and the memory events come from running the class through the Sail
model (`DecoderObs.obsData`, generated by `DecoderSail.lean`; that run also classifies the events with the
emissions and `obs_v2_eq`/`obs_today_eq` check that the pure projections here equal what the run emitted).
Every comparison below is evaluated by the KERNEL (`decide +kernel`); no `native_decide`.

## Polarity of a mismatch (plan §0 marks)

* an EXTRA address/data/control source, an extra carried source or memory result on a destination, a destination
  left STALE (`LSilent`: the register keeps the dependency the text kills, SR-19/SR-20), or a non-destination
  overwritten WITH sources ⇒ STRONGER (the machine orders more than the text);
* a MISSING source / carried source / memory result, a destination not tracked, a non-destination overwritten with
  `[]` (its dependency is lost) ⇒ WEAKER (sound);
* INERT (an extra source that cannot order anything), two rules, each argued at its definition:
  `inertF5` (a load's `rd` carrying the load's own address source, F5') and `inertRO` (a read-only CSR's key).

The verdict theorems are at the end (§4).
-/
import Weak.Prom.DecoderObs

namespace Weak.Prom.Dec

open Weak (Dsrc OpRoles depsOfIb depsCtrl depsAddr depsVsrc depsAsrc depsRd depsRd2 erwSrcs)
open Weak.Prom

/-! ## 1. The emissions' roles, as pure functions of the encoding and the Sail observation -/

/-- The announced bits of a class (a compressed parcel is zero-extended, as `ibOfBvn`). -/
def bitsOf (c : Cls) : Option (BitVec 32) := some (BitVec.ofNat 32 c.w)

def addU (l m : List R) : List R := m.foldl (fun acc r => if acc.contains r then acc else acc ++ [r]) l

/-- EMISSION v2's roles for class `c` with tracked keys written `keys` and memory events `mem`
(`(isWrite, excl, ok)`); `pcs ≠ []` iff `nextPC` was written. -/
def pureV2 (c : Cls) (keys : List Nat) (pcs : List (List Nat)) (mem : List (Bool × Bool × Bool)) : Emitted :=
  let b := bitsOf c
  let ro := v2Roles b
  let scOk := isSC b && mem.any (fun e => e.1 && e.2.1 && e.2.2)
  let live := mem.filter (fun e => !(e.1 && e.2.1 && isSC b && !e.2.2))
  let asrc0 := if live.isEmpty then [] else rsOf (depsAddr ro)
  let asrc := match b, cboKind b with
    | some w, some _ => addU asrc0 (rsOf (dsrcOfRs1 w))
    | _, _ => asrc0
  let dsrc := if live.any (·.1) then rsOf (depsVsrc ro) else []
  let ctrl := if pcs.isEmpty then [] else rsOf (depsCtrl ro)
  let ks := keys.eraseDups
  let dl : List (R × Option (List R × Bool)) := ks.map (fun n => (rOfKey n, some (rsOf (regSrcs b scOk n), memOf (regSrcs b scOk n))))
  v2Old b (Emitted.mk asrc dsrc ctrl dl)

/-- TODAY's `erwOf` on a tracked key (`erwDest` tried on `depsRd`, then `depsRd2`). -/
def erwKey (ro : OpRoles) (rds : List Nat) (n : Nat) : Option (List Dsrc) :=
  match depsRd ro with
  | some (rd, s) =>
    if rd = n then some (erwSrcs s rds)
    else match depsRd2 ro with
      | some (rd2, s2) => if rd2 = n then some (erwSrcs s2 rds) else none
      | none => none
  | none =>
    match depsRd2 ro with
    | some (rd2, s2) => if rd2 = n then some (erwSrcs s2 rds) else none
    | none => none

/-- TODAY's emission's roles for class `c` with write trace `wr` (key, DEC-7 read set), `nextPC` read sets `pcs`
and memory events `mem`. -/
def pureToday (c : Cls) (wr : List (Nat × List Nat)) (pcs : List (List Nat))
    (mem : List (Bool × Bool × Bool)) : Emitted :=
  let ro := depsOfIb (bitsOf c)
  let asrc := if mem.any (fun e => e.1 || e.2.1) then rsOf (depsAsrc ro) else []
  let dsrc := if mem.any (·.1) then rsOf (depsVsrc ro) else []
  let ctrl := pcs.foldl (fun acc rds =>
    addU acc (match depsCtrl ro with | [] => [] | dec => rsOf (erwSrcs dec rds))) []
  let ds := wr.foldl (fun (acc : List (Nat × Option (List R × Bool))) (n, rds) =>
    match erwKey ro rds n with
    | some s =>
      let v := some (rsOf s, memOf s)
      if acc.any (·.1 == n) then acc.map (fun p => if p.1 == n then (n, v) else p) else acc ++ [(n, v)]
    | none => if acc.any (·.1 == n) then acc else acc ++ [(n, none)]) []
  { asrc := asrc, dsrc := dsrc, ctrl := ctrl, dests := ds.map (fun p => (rOfKey p.1, p.2)) }

/-! ## 2. The comparison -/

inductive Pol where
  | stronger
  | weaker
  | inert
  deriving DecidableEq, Repr, Inhabited

/-- What differs. -/
inductive Fld where
  | asrcX (r : R) | asrcM (r : R) | dsrcX (r : R) | dsrcM (r : R) | ctrlX (r : R) | ctrlM (r : R)
  | carryX (d r : R) | carryM (d r : R) | memX (d : R) | memM (d : R)
  | stale (d : R) | untracked (d : R) | reset (d : R) | setK (d : R) | staleSide (d : R)
  deriving DecidableEq, Repr, Inhabited

/-- INERT RULE F5' (`WeakDeps.depsRd`'s `ORload` arm: a load's or LR's `rd` carries `DLdRes :: depsAddr`).  The
listing marks loads † (no carry from `rs1` to `rd`), so syntactically `rs1` is an extra carried source.  It orders
nothing the text does not: any later access `c` that depends on `rd` is ppo-after the load `b` (rules 9–11), and
`b` is ppo-after every producer `a` of `rs1` (rule 9, "b has a syntactic address dependency on a"), so `a <gmo c`
already.  (Machine v2: `wLdv` already holds `vpost ≥ ldPre ≥ va = view(rs1)`, `Machine.loadByte`/`ldPre`.) -/
def inertF5 (s : Spec) (d r : R) : Bool :=
  s.asrc.contains r && s.dests.any (fun e => e.1 == d && e.2.2)

/-- INERT RULE RO: the read-only CSRs `time` (`0xc01`) and `mhartid` (`0xf14`) have dependency keys (`TIME`,
`MHARTID`) whose only writes are not instruction destinations (a write to a read-only CSR traps; `mtime` is written
by the clock tick, a non-destination: v2 `LRegW 49 []`, today `LSilent`; `mhartid` is never written), so the key's
view is always `0`. -/
def inertRO (r : R) : Bool := r == .c 0xc01 || r == .c 0xf14

def diffL (mk : R → Fld) (pol : Pol) (a b : List R) : List (Fld × Pol) :=
  (a.filter (fun r => !b.contains r)).map (fun r => (mk r, pol))

/-- The mismatches of the emitted roles `e` against the expected `s`. -/
def cmp (s : Spec) (e : Emitted) : List (Fld × Pol) :=
  diffL .asrcX .stronger e.asrc s.asrc ++ diffL .asrcM .weaker s.asrc e.asrc ++
  diffL .dsrcX .stronger e.dsrc s.dsrc ++ diffL .dsrcM .weaker s.dsrc e.dsrc ++
  diffL .ctrlX .stronger e.ctrl s.ctrl ++ diffL .ctrlM .weaker s.ctrl e.ctrl ++
  -- expected destinations
  s.dests.flatMap (fun (d, srcs, mem) =>
    match e.dests.find? (·.1 == d) with
    | some (_, some (es, emem)) =>
      (es.filter (fun r => !srcs.contains r)).map (fun r =>
          (Fld.carryX d r, if inertF5 s d r || inertRO r then Pol.inert else Pol.stronger)) ++
      (srcs.filter (fun r => !es.contains r)).map (fun r => (Fld.carryM d r, Pol.weaker)) ++
      (if emem && !mem then [(Fld.memX d, Pol.stronger)] else []) ++
      (if mem && !emem then [(Fld.memM d, Pol.weaker)] else [])
    | some (_, none) => [(Fld.stale d, Pol.stronger)]
    | none => [(Fld.untracked d, Pol.weaker)]) ++
  -- written registers that are not destinations
  (e.dests.filter (fun p => !s.dests.any (·.1 == p.1))).filterMap (fun (d, o) =>
    match o with
    | some ([], false) => some (Fld.reset d, Pol.weaker)
    | some (es, _) =>
      if es.all inertRO then some (Fld.reset d, Pol.weaker) else some (Fld.setK d, Pol.stronger)
    | none => if s.kept.contains d then none else some (Fld.staleSide d, Pol.stronger))

/-! ## 3. The table -/

/-- Each class with its observation (the two lists are generated in the same order; `aligned` checks the names). -/
abbrev Row := Cls × Obs × List (Nat × List Nat) × List (List Nat) × List (Bool × Bool × Bool)

def rows : List Row :=
  classes.zipWith (fun c (o, wr, pcs, mem) => (c, o, wr, pcs, mem)) obsData

def aligned : Bool := classes.length == obsData.length && rows.all (fun r => r.1.name == r.2.1.name)

def mmV2 (r : Row) : List (Fld × Pol) :=
  let (c, o, _, pcs, mem) := r
  cmp c.exp (pureV2 c o.keys pcs mem)

def mmToday (r : Row) : List (Fld × Pol) :=
  let (c, _, wr, pcs, mem) := r
  cmp c.exp (pureToday c wr pcs mem)

/-- Indices of the classes whose comparison has a mismatch of polarity `p` (trapping classes excluded: their only
writes are trap entry's, the C-R rows, decided separately). -/
def idxWith (f : Row → List (Fld × Pol)) (p : Pol) : List Nat :=
  ((List.range rows.length).zip rows).filterMap (fun (i, r) =>
    if r.2.1.stop == "" && (f r).any (·.2 == p) then some i else none)

/-- Trap rows (C-R): indices whose run trapped and whose emission leaves a written tracked register stale or sets
it with sources. -/
def trapIdxWith (f : Row → List (Fld × Pol)) (p : Pol) : List Nat :=
  ((List.range rows.length).zip rows).filterMap (fun (i, r) =>
    if r.2.1.stop == "trap" && (f r).any (·.2 == p) then some i else none)

/-! ## 4. Verdicts (kernel `decide`) -/

theorem rows_aligned : aligned = true := by decide +kernel

/-- The pure projections equal what the Sail run's event classification emitted (emission v2). -/
theorem obs_v2_eq : rows.all (fun r => pureV2 r.1 r.2.1.keys r.2.2.2.1 r.2.2.2.2 == r.2.1.v2) = true := by
  decide +kernel

/-- … and today's emission. -/
theorem obs_today_eq : rows.all (fun r => pureToday r.1 r.2.2.1 r.2.2.2.1 r.2.2.2.2 == r.2.1.today) = true := by
  decide +kernel

