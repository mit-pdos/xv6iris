/-! ### Calibration (E0, decider `decide`): the seeded STRONGER rows on TODAY's emission -/

def rowNamed (n : String) : Option Row := rows.find? (·.1.name == n)

def hasT (n : String) (m : Fld × Pol) : Bool := ((rowNamed n).map (fun r => (mmToday r).contains m)).getD false
def hasV2 (n : String) (m : Fld × Pol) : Bool := ((rowNamed n).map (fun r => (mmV2 r).contains m)).getD false

/-- SR-11 DEC-6: `sret`/`mret` carry a control source through `sepc`/`mepc` (no RVWMO source). -/
theorem cal_SR11_dec6 : hasT "mret" (.ctrlX (.c 0x341), .stronger) = true ∧
    hasT "sret" (.ctrlX (.c 0x141), .stronger) = true ∧
    hasV2 "mret" (.ctrlX (.c 0x341), .stronger) = false := by decide +kernel

/-- SR-11 DEC-7: the dynamic read set puts `mstatus` and the PMP CSRs (read by Sail's address translation and PMP
check) into a load's `rd`, and `jalr`'s `rs1` into its link register (jalr is †). -/
theorem cal_SR11_dec7 : hasT "lw" (.carryX (.g 5) (.c 0x300), .stronger) = true ∧
    hasT "lw" (.carryX (.g 5) (.c 0x3a0), .stronger) = true ∧
    hasT "jalr" (.carryX (.g 5) (.g 6), .stronger) = true ∧
    hasV2 "lw" (.carryX (.g 5) (.c 0x300), .stronger) = false := by decide +kernel

/-- SR-19: an `ORnone` class's `rd` write is `LSilent` (stale view): a CSR outside the table, Zcb, Zimop. -/
theorem cal_SR19 : hasT "csrrw x5,mcause,x6" (.stale (.g 5), .stronger) = true ∧
    hasT "c.lbu" (.stale (.g 9), .stronger) = true ∧ hasT "mop.r.0" (.stale (.g 5), .stronger) = true ∧
    hasV2 "c.lbu" (.stale (.g 9), .stronger) = false := by decide +kernel

/-- SR-9 (failed-SC rd): a failed SC's `rd` gets the decoded `[DLdRes]` plus the read set (a destination "only if
successful"). -/
theorem cal_SR9_rd : hasT "sc.w-failP" (.setK (.g 5), .stronger) = true ∧
    hasV2 "sc.w-failP" (.setK (.g 5), .stronger) = false := by decide +kernel

/-- SR-20 (under D-S0-4's default reading): trap entry's `mepc`/`mstatus` writes are `LSilent`. -/
theorem cal_SR20 : hasT "ecall" (.staleSide (.c 0x341), .stronger) = true ∧
    hasT "ecall" (.staleSide (.c 0x300), .stronger) = true ∧
    hasV2 "ecall" (.staleSide (.c 0x341), .stronger) = false := by decide +kernel

/-! ## 5. Annotations and label constructor per access kind

Sail's flags per instruction family (the `vmem_read`/`vmem_write`/`mem_read`/`mem_write_value` call sites, quoted
from model/Lean_RV64D/LeanRV64D/InstsEnd.lean): LR `vmem_read … aq (aq && rl) true` (:18236); SC
`vmem_write … (aq && rl) rl true` (:17769–17770); AMO read `mem_read … aq (aq && rl) true` (:18698), AMO write
`mem_write_value … (aq && rl) rl true` (:18749–18750); plain load `… false false false` (:18247), plain store
(:17783).  The access kind is then computed BY THE KERNEL from Sail's own `read_kind_of_flags` /
`write_kind_of_flags` (Mem.lean:222–255) and `read_ram` / `write_ram` (PhysMemInterface.lean:296–365): `akRead` /
`akWrite` below evaluate the Sail monad to its `memRead`/`memWrite` request.

Expected (rvwmo.adoc:124–128): "An AMO or lr instruction with aq set has an acquire-RCsc annotation. An AMO or sc
instruction with rl set has a release-RCsc annotation. An AMO, lr, or sc instruction with both aq and rl set has
both acquire-RCsc and release-RCsc annotations."  So LR: (acq, rel) = (aq, aq ∧ rl); SC: (aq ∧ rl, rl); AMO: acquire
on its read half, release on its write half (M10 (2); the AMO is one memory operation, M0, whose two annotations
the two halves carry); plain accesses: none. -/

open LeanRV64D LeanRV64D.Functions Sail Sail.ConcurrencyInterfaceV1 MachCSL

/-- The access kind of Sail's RAM read for flags `(aq, rl, res)` (`none`: the flags are an `internal_error`). -/
def akRead (aq rl res : Bool) : Option AK :=
  match read_kind_of_flags aq rl res with
  | .pure rk =>
    match read_ram rk (.Physaddr 0x80001000#64) 4 false with
    | .impure (.ok (.memRead _ _ req)) _ => some req.access_kind
    | _ => none
  | _ => none

/-- The access kind of Sail's RAM write for flags `(aq, rl, con)`. -/
def akWrite (aq rl con : Bool) : Option AK :=
  match write_kind_of_flags aq rl con with
  | .pure wk =>
    match write_ram wk (.Physaddr 0x80001000#64) 4 0#32 () with
    | .impure (.ok (.memWrite _ _ req)) _ => some req.access_kind
    | _ => none
  | _ => none

/-- A label's constructor and annotation bits, as emission v2 picks them. -/
inductive Tag where
  | ifetch | stuck
  | exLoad (aq rl : Bool) | amoLd (aq : Bool) | load (aq rl : Bool)
  | exStore (aq rl : Bool) | amoSt (rl : Bool) | store (aq rl : Bool)
  deriving DecidableEq, Repr

/-- Emission v2's read label tag (`Emit.ramRead`'s case split, `rdTag_spec`). -/
def rdTag (b : Option (BitVec 32)) (ak : AK) : Tag :=
  if isTtw ak then .stuck else if akIfetch ak then .ifetch
  else if akExcl ak then (if isLR b then .exLoad (akAcq ak) (akStrong ak) else .amoLd (akAcq ak))
  else .load (akAcq ak) (akStrong ak)

/-- Emission v2's write label tag (`Emit.ramWrite`'s case split; an SC's `.Err ()` answer is `LExFail`). -/
def wrTag (b : Option (BitVec 32)) (ak : AK) : Tag :=
  if akExcl ak then (if isSC b then .exStore (akStrong ak) (akRel ak) else .amoSt (akAcq ak))
  else .store (akStrong ak) (akRel ak)

theorem rdTag_spec (h : HState) (n : Nat) (pa : PAddr) (ak : AK) (k) (l : PLabel) (h' : HState) :
    ramRead h n pa ak k l h' →
    (match rdTag h.ix.bits ak with
     | .ifetch => ∃ tvs, l = .LIFetch (paZ pa) tvs
     | .exLoad a r => ∃ tvs asrc, l = .LExLoad a r (paZ pa) tvs asrc
     | .amoLd a => ∃ tvs asrc, l = .LAmoLd a (paZ pa) tvs asrc
     | .load a r => ∃ base tvs asrc, l = .LLoad a r base tvs asrc
     | _ => False) := by
  intro hr
  unfold ramRead at hr
  obtain ⟨htw, hr⟩ := hr
  unfold rdTag
  simp only [htw, Bool.false_eq_true, ↓reduceIte]
  split at hr
  · rename_i hif; simp only [hif, ↓reduceIte]; obtain ⟨_, tvs, _, hl, _⟩ := hr; exact ⟨tvs, hl⟩
  · rename_i hif
    simp only [Bool.not_eq_true] at hif
    simp only [hif, Bool.false_eq_true, ↓reduceIte]
    split at hr
    · rename_i hex; simp only [hex, ↓reduceIte]
      obtain ⟨_, tvs, _, _, _, _, _, hb⟩ := hr
      split at hb
      · rename_i hlr; simp only [hlr, ↓reduceIte]; exact ⟨tvs, _, hb.1⟩
      · rename_i hlr; simp only [Bool.not_eq_true] at hlr; simp only [hlr, Bool.false_eq_true, ↓reduceIte]
        exact ⟨tvs, _, hb.1⟩
    · rename_i hex; simp only [Bool.not_eq_true] at hex; simp only [hex, Bool.false_eq_true, ↓reduceIte]
      obtain ⟨tvs, _, _, _, hl, _⟩ := hr; exact ⟨_, tvs, _, hl⟩

theorem wrTag_spec (h : HState) (n : Nat) (pa : PAddr) (ak : AK) (v : BitVec (8 * n)) (k) (l : PLabel)
    (h' : HState) :
    ramWrite h n pa ak v k l h' →
    (match wrTag h.ix.bits ak with
     | .exStore a r => (∃ d asrc vsrc, l = .LExStore a r (paZ pa) d asrc vsrc) ∨ l = .LExFail
     | .amoSt r => ∃ d asrc vsrc, l = .LAmoSt r (paZ pa) d asrc vsrc
     | .store a r => ∃ base d asrc vsrc, l = .LStore a r base d asrc vsrc
     | _ => False) := by
  intro hw
  unfold ramWrite at hw
  obtain ⟨_, hw⟩ := hw
  unfold wrTag
  split at hw
  · rename_i hex; simp only [hex, ↓reduceIte]
    split at hw
    · rename_i hsc; simp only [hsc, ↓reduceIte]
      rcases hw with ⟨hl, _⟩ | ⟨hl, _⟩
      · exact Or.inl ⟨_, _, _, hl⟩
      · exact Or.inr hl
    · rename_i hsc; simp only [Bool.not_eq_true] at hsc; simp only [hsc, Bool.false_eq_true, ↓reduceIte]
      exact ⟨_, _, _, hw.1⟩
  · rename_i hex; simp only [Bool.not_eq_true] at hex; simp only [hex, Bool.false_eq_true, ↓reduceIte]
    obtain ⟨c, _, _, _, hl, _⟩ := hw; exact ⟨_, _, _, _, hl⟩

def b2 (b : Bool) : Nat := if b then 1 else 0

/-- An LR / SC / AMO word with these flags (`rd = x5`, `rs1 = x6`, `rs2 = x7`, `.w`). -/
def wLR (aq rl : Bool) : Option (BitVec 32) := some (BitVec.ofNat 32 (amoW 2 (b2 aq) (b2 rl) 0 6 2 5))
def wSC (aq rl : Bool) : Option (BitVec 32) := some (BitVec.ofNat 32 (amoW 3 (b2 aq) (b2 rl) 7 6 2 5))
def wAMO (aq rl : Bool) : Option (BitVec 32) := some (BitVec.ofNat 32 (amoW 1 (b2 aq) (b2 rl) 7 6 2 5))
def wLD : Option (BitVec 32) := some (BitVec.ofNat 32 (iT 0 6 2 5 0x03))
def wST : Option (BitVec 32) := some (BitVec.ofNat 32 (sT 0 7 6 2 0x23))

/-- THE ANNOTATION CHECK, every family × every `(aq, rl)`: emission v2's label constructor and bits on Sail's
access kind equal the text's annotations. -/
def annotOk (aq rl : Bool) : Bool :=
  ((akRead aq (aq && rl) true).map (rdTag (wLR aq rl)) == some (.exLoad aq (aq && rl))) &&
  ((akWrite (aq && rl) rl true).map (wrTag (wSC aq rl)) == some (.exStore (aq && rl) rl)) &&
  ((akRead aq (aq && rl) true).map (rdTag (wAMO aq rl)) == some (.amoLd aq)) &&
  ((akWrite (aq && rl) rl true).map (wrTag (wAMO aq rl)) == some (.amoSt rl)) &&
  ((akRead false false false).map (rdTag wLD) == some (.load false false)) &&
  ((akWrite false false false).map (wrTag wST) == some (.store false false))

theorem annot_v2 : [(false, false), (true, false), (false, true), (true, true)].all
    (fun (aq, rl) => annotOk aq rl) = true := by decide +kernel

/-- TODAY's emission (`WeakEvInst.pnodeStep`): every exclusive read is `LExLoad akSync`, every exclusive write
`LExStore akSync` (LR/SC and AMO halves alike), plain `LLoad akSync false` / `LStore akSync`; one bit per label. -/
def todayTag (isRead : Bool) (ak : AK) : Tag :=
  if isRead then (if akExcl ak then .exLoad (akAcq ak) false else .load (akAcq ak) false)
  else (if akExcl ak then .exStore false (akAcq ak) else .store false (akAcq ak))

/-- Today's mismatches, decided: `lr.aqrl` loses its release, `sc.aqrl` its acquire (S0P2-D3's class, WEAKER), and
an AMO's halves get the LR/SC constructors (they use the reservation `wRes`: SR-9's AMO-clobbers-LR part, STRONGER
on row 36). -/
theorem annot_today :
    (akRead true true true).map (todayTag true) = some (.exLoad true false) ∧
    (akWrite true true true).map (todayTag false) = some (.exStore false true) ∧
    (akRead true false true).map (todayTag true) = some (.exLoad true false) ∧
    (akWrite false true true).map (todayTag false) = some (.exStore false true) := by decide +kernel

end Weak.Prom.Dec
