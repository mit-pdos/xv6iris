/-
Weak/Prom: **completeness S3b — the release view, the LR reservation, and ppo rules 3, 5–8** (plan rev 7 §6
"Strategy", §8 S3b-AMO / S3b-LRSC; PROGRESS-S3a.md "Open items for S3b").

S3a's `SimInv` (Weak/Prom/CmpInv.lean) bounds every view of machine v2's agent state except the two that only
annotated or LR/SC instructions move.  `ExtraInv X h n vrel res` bounds them, Pulte-style (`view_of_eid`):
* `vrel` — the RELEASE VIEW `wVRel` (rule 7, RCsc) is below the view of a past release-RCsc memory operation
  (PAST form, `domF`): a later acquire-RCsc operation reads it in its pre-view (`ldPre`, `stPreA`), and rule 7
  ("a and b both have RCsc annotations", rvwmo.adoc:289) orders that release before it;
* `res` — THE LR RESERVATION `wRes` (M16) is the most recent LR of the hart with no LR or SC instruction after it
  (rvwmo.adoc:114–116 "paired … if the lr precedes the sc in program order and if there are no other lr or sc
  instructions in between"): its base, its per-byte read timestamps (the load value axiom's store, one per load under
  NA-6) and a post-view below the LR's view; `none` when every LR is followed by an LR/SC instruction.
`wRmw` needs no invariant: the litmus front end emits the FUSED AMO `LRmw` (Machine.lean `memStep.rmw`), which does
not touch the slot, and `LInstr` clears it (the split pair is Sail's, M10).
`extra_mono` transports `ExtraInv` over events that are not LR/SC instructions (every S3a instruction, the AMO and
the Zalasr accesses), `StepOk`'s `keepRR` supplying the unchanged `wVRel`, `wRes`.
ppo constructors: rules 3, 5, 6, 7, 8 (rvwmo.adoc:282–290); the atomicity axiom and the §zalrsc success conditions
(Ref.lean `atomicityAx`, `scAx`).
No `sorry`, no axiom, no `native_decide`.
-/
import Weak.Prom.CmpSimS

namespace Weak.Prom.Cmp

open MachCSL MachCSL.Stdpp Iris.Std
open Weak (Image Dsrc)
open Weak.Prom Weak.Prom.Mach Weak.Prom.Mach.Cert
open Weak.Prom.Ref
open PLabel

/-! ## 1. ppo rules 3, 5, 6, 7, 8 -/

section rules

variable {X : Exec} (hX : rvwmoRef X) (hio : X.io = [])

include hio in
/-- Rule 5 (rvwmo.adoc:287): "a has an acquire annotation". -/
theorem ppo_r5 {a b : EvId} (ha : (X.sk a).kind.isMem = true) (hb : (X.sk b).kind.isMem = true)
    (hpo : poX X a b = true) (haq : (X.sk a).aqSc = true) : ppoB X a b = true := by
  refine staticRules_ppo ha hb hpo ?_
  have : rule5 X.sk (isIo X) a b = true := by simp [rule5, sameCls, isIo_f hio, haq]
  simp [staticRules, this]

include hio in
/-- Rule 6 (rvwmo.adoc:288): "b has a release annotation". -/
theorem ppo_r6 {a b : EvId} (ha : (X.sk a).kind.isMem = true) (hb : (X.sk b).kind.isMem = true)
    (hpo : poX X a b = true) (hrl : (X.sk b).rlSc = true) : ppoB X a b = true := by
  refine staticRules_ppo ha hb hpo ?_
  have : rule6 X.sk (isIo X) a b = true := by simp [rule6, sameCls, isIo_f hio, hrl]
  simp [staticRules, this]

include hio in
/-- Rule 7 (rvwmo.adoc:289): "a and b both have RCsc annotations" (`a` release-RCsc, `b` acquire-RCsc). -/
theorem ppo_r7 {a b : EvId} (ha : (X.sk a).kind.isMem = true) (hb : (X.sk b).kind.isMem = true)
    (hpo : poX X a b = true) (hra : (X.sk a).rlSc = true) (hab : (X.sk b).aqSc = true) : ppoB X a b = true := by
  refine staticRules_ppo ha hb hpo ?_
  have : rule7 X.sk (isIo X) a b = true := by simp [rule7, sameCls, isIo_f hio, hra, hab]
  simp [staticRules, this]

/-- Rule 8 (rvwmo.adoc:290): "a is paired with b". -/
theorem ppo_r8 {a b : EvId} (ha : (X.sk a).kind.isMem = true) (hb : (X.sk b).kind.isMem = true)
    (hp : pairedS X.ids X.sk a b = true) : ppoB X a b = true := by
  have hpo : poX X a b = true := by
    simp only [pairedS, Bool.and_eq_true] at hp; exact hp.1.2
  refine staticRules_ppo ha hb hpo ?_
  have : rule8 X.ids X.sk a b = true := hp
  simp [staticRules, this]

include hio in
/-- Rule 3 (rvwmo.adoc:282–283): "a is generated by an AMO or sc instruction, b is a load, and b returns a value
written by a". -/
theorem ppo_r3 {a b : EvId} (ha : (X.sk a).kind.isRmwW = true) (hb : (X.sk b).kind.isLoad = true)
    (hpo : poX X a b = true) {k : Nat} (hk : k < (X.sk b).sz) (hrf : rfSrc X b ((X.ev b).pa + k) = some a) :
    ppoB X a b = true := by
  have ham : (X.sk a).kind.isMem = true := by
    revert ha; cases (X.sk a).kind <;> simp [Kind.isRmwW, Kind.isMem]
  refine ppoB_mk ham (Kind.isMem_of_isLoad _ hb) hpo ?_
  have : rule3 X a b = true := by
    unfold rule3
    rw [ha, hb, isIo_f hio b]
    simp only [Bool.true_and, Bool.not_false]
    exact List.any_eq_true.2 ⟨k, List.mem_range.2 hk, by simp [hrf]⟩
  simp [this]

include hX in
/-- THE ATOMICITY AXIOM (rvwmo.adoc:331–337), for a paired aligned LR `r` and SC `w`, byte `k` of the LR. -/
theorem atomAx {r w : EvId} (hr : r ∈ X.ids) (hw : w ∈ X.ids) (hp : pairedS X.ids X.sk r w = true)
    (har : aligned (X.ev r) = true) (haw : aligned (X.ev w) = true) {k : Nat} (hk : k < (X.sk r).sz) {s : EvId}
    (hs : rfSrc X r ((X.ev r).pa + k) = some s) :
    gmoBefore X s w = true ∧ ∀ s' ∈ X.ids, writesB (X.ev s') ((X.ev r).pa + k) = true → s'.1 ≠ r.1 →
      ¬ (gmoBefore X s s' = true ∧ gmoBefore X s' w = true) :=
  hX.1.2.2.2.2.1 r hr w hw hp har haw k hk s (by simp [hs])

include hX in
/-- THE §zalrsc SUCCESS CONDITIONS (Ref.lean `scAx`): a successful SC pairs with an LR whose reservation admits
it. -/
theorem scAx_of {w : EvId} (hw : w ∈ X.ids) (hk : (X.sk w).kind = .sc) :
    ∃ r ∈ X.ids, pairedS X.ids X.sk r w = true ∧ resvOk X r w :=
  hX.1.2.2.2.2.2 w hw hk

end rules

/-! ## 2. The invariant -/

/-- THE LR RESERVATION after `n` events of hart `h` (M16; rvwmo.adoc:114–116 pairing).  `some R`: `R` is the
`jr`-th event, an LR with no LR/SC instruction after it, with its base, its per-byte read timestamps (the load value
axiom's store, the same for every byte under NA-6) and a post-view at most the LR's view (rule 8's view, M5).
`none`: every LR is followed by an LR/SC instruction. -/
def resOk (X : Exec) (h n : Nat) : Option PResv → Prop
  | none => ∀ jr, jr < n → (X.sk (h, jr)).kind = .lr → ∃ j, jr < j ∧ j < n ∧ (X.sk (h, j)).kind.isLrSc = true
  | some R => ∃ jr, jr < n ∧ (X.sk (h, jr)).kind = .lr ∧
      (∀ j, jr < j → j < n → (X.sk (h, j)).kind.isLrSc = false) ∧
      R.rvBase = ((X.ev (h, jr)).pa : Int) ∧
      R.rvTs = List.replicate (X.sk (h, jr)).sz (kts X (rfSrc X (h, jr) (X.ev (h, jr)).pa)) ∧
      R.rvView ≤ vo X (h, jr)

/-- THE S3b PART OF THE SIMULATION INVARIANT (file header). -/
structure ExtraInv (X : Exec) (h n : Nat) (vrel : Nat) (res : Option PResv) : Prop where
  vrel : domF (fun j => vo X (h, j)) (fun j => j < n ∧ (X.sk (h, j)).kind.isMem = true ∧ (X.sk (h, j)).rlSc = true)
    vrel
  res : resOk X h n res

theorem resOk_mono {X : Exec} {h n n' : Nat} {r : Option PResv} (hr : resOk X h n r) (hnn : n ≤ n')
    (hns : ∀ j, n ≤ j → j < n' → (X.sk (h, j)).kind.isLrSc = false) : resOk X h n' r := by
  match r, hr with
  | none, hr =>
    intro jr hjr hk
    rcases Nat.lt_or_ge jr n with h1 | h1
    · obtain ⟨j, h2, h3, h4⟩ := hr jr h1 hk
      exact ⟨j, h2, by omega, h4⟩
    · have := hns jr h1 hjr; rw [hk] at this; cases this
  | some R, ⟨jr, h1, h2, h3, h4⟩ =>
    refine ⟨jr, by omega, h2, fun j hj1 hj2 => ?_, h4⟩
    rcases Nat.lt_or_ge j n with h5 | h5
    · exact h3 j hj1 h5
    · exact hns j h5 hj2

/-- TRANSPORT over events that are not LR/SC instructions. -/
theorem extra_mono {X : Exec} {h n n' v : Nat} {r : Option PResv} (hx : ExtraInv X h n v r) (hnn : n ≤ n')
    (hns : ∀ j, n ≤ j → j < n' → (X.sk (h, j)).kind.isLrSc = false) : ExtraInv X h n' v r :=
  ⟨domF_mono hx.vrel (fun j hj => ⟨by omega, hj.2⟩), resOk_mono hx.res hnn hns⟩

/-- The initial state. -/
theorem extra_init (X : Exec) (h : Nat) : ExtraInv X h 0 0 none :=
  ⟨domF_zero _ _, fun jr hjr => absurd hjr (Nat.not_lt_zero _)⟩

/-- ONE INSTRUCTION SIMULATED, S3b: `StepOk` with `ExtraInv` in place of `keepRR`. -/
def StepOkB (T : Test) (X : Exec) (ν : Val) (h : Nat) (sf s : SSt) (lp : LP) (ws : PState) (prom : GSet Nat)
    (s' : SSt) : Prop :=
  ∃ tr lp' ws' prom', soloSteps litStep (testImg T) (memOf X) h (lp, ws, prom) tr (lp', ws', prom') ∧
    machRow tr = rowSeg X h s.evs.length s'.evs.length ∧ SimInv T X ν h sf s' lp' ws' prom' ∧
    ExtraInv X h s'.evs.length ws'.wVRel ws'.wRes

/-- An S3a step keeps `ExtraInv` when its events are not LR/SC instructions. -/
theorem stepOkB_of {T : Test} {X : Exec} {ν : Val} {h : Nat} {sf s s' : SSt} {lp : LP} {ws : PState}
    {prom : GSet Nat} (hx : ExtraInv X h s.evs.length ws.wVRel ws.wRes) (hst : StepOk T X ν h sf s lp ws prom s')
    (hle : s.evs.length ≤ s'.evs.length)
    (hns : ∀ j, s.evs.length ≤ j → j < s'.evs.length → (X.sk (h, j)).kind.isLrSc = false) :
    StepOkB T X ν h sf s lp ws prom s' := by
  obtain ⟨tr, lp', ws', prom', h1, h2, h3, ⟨k1, k2⟩⟩ := hst
  exact ⟨tr, lp', ws', prom', h1, h2, h3, by rw [k1, k2]; exact extra_mono hx hle hns⟩

end Weak.Prom.Cmp
