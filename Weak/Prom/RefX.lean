/-
Weak/Prom: **the reference, EXTENDED to the G5 rows the phase-1 front end could not run** (S0 exit, (E3) (b)):
misaligned loads and stores, `cbo.zero`, the Zicbom operations (`cbo.inval`/`cbo.clean`/`cbo.flush`), `amocas`, and
I/O accesses with no device.  A CONSERVATIVE EXTENSION in a new file: `Weak/Prom/Ref.lean` (the execution model),
`RefProg.lean` (the front end) and `RefCheck.lean` (the verified enumerator) are untouched and reused — every event
of an extended program is an ordinary `Ref.Ev` checked by Ref's own axioms (`gmoWf`, `evWf`, `ppoAx`,
`atomicityAx`, `scAx`); the extension adds only (i) a front end with the new instructions (`XI`, `xstep`), (ii) the
CMO events and their PPO rules (cmo.adoc:225–247), (iii) the load value axiom WITH the invalidate clause
(cmo.adoc:259–274) in place of `loadValueAx`, (iv) the PPO rules of a failed `amocas` that writes nothing (zacas.adoc
NOTE :159–163), (v) a candidate enumerator that branches where values are not determined by gmo (I/O loads, loads
after an invalidate).  Used by the probe runner only (`ProbeXRun.lean`); no theorem uses it.

## The texts, and how each is rendered

* MISALIGNED (rvwmo.adoc:92–98): "A misaligned load or store instruction may be decomposed into a set of component
  memory operations of any granularity … The memory operations generated by such instructions are not ordered with
  respect to each other in program order".  PLATFORM FACT (the RAM PMA has a misaligned atomicity granule of 16
  bytes, `misaligned_atomicity_granule_size_exp = 4`, model/sail-config-rv64d.json regions[2]):
  priv_machine.adoc:3094–3098 "if all accessed bytes lie within the same misaligned atomicity granule, the
  instruction will not raise an exception for reasons of address alignment, and the instruction will give rise to
  only one memory operation for the purposes of RVWMO--i.e., it will execute atomically"; :3103–3105 "For regular
  loads and stores that access such a region or for which not all accessed bytes lie within the same atomicity
  granule, then either an exception is raised, or the access proceeds but is not guaranteed to be atomic" (the
  platform raises none: `load_store = None`).  Rendering (`ldM`/`stM`): an aligned access is one event (RefProg's
  own `load`/`store`); a misaligned one inside a 16-byte granule is ONE event (exempt from the alignment check);
  one that crosses a granule is ANY composition of its bytes into contiguous component events (every composition,
  incl. the single op), all with the instruction's dynamic index (so unordered by po).
* `cbo.zero` (cmo.adoc:132–138): "A cache-block zero instruction performs a set of store operations that write zeros
  to the set of bytes corresponding to a cache block … An implementation may or may not update the entire set of
  bytes atomically with a single store operation"; :250–251 "the resulting store operations behave as stores in the
  PPO rules".  Rendering: plain store events of zeros over the 64-byte block (`rs1` rounded down,
  ZicbomInsts/Zicboz), in one of the compositions `cboZeroComps` (one op, or two ops split at byte 1, 32 or 63: an
  UNDER-APPROXIMATION of "a set of store operations", stated per probe: the runner compares the same family on the
  machine side).
* Zicbom (cmo.adoc:228–247): "the resulting invalidate, clean, and flush operations behave as stores in the PPO
  rules subject to one additional overlapping address rule … a is an invalidate, clean, or flush, b is a load, and a
  and b access overlapping memory addresses"; "classified as W or O … for the purposes of predecessor and successor
  sets in FENCE instructions"; "not ordered by other instructions that order stores, e.g. fence.i and sfence.vma".
  Load values, cmo.adoc:259–274 (quoted at `invalAlt`).  Rendering: a CMO event (`CmoEv`) in an EXTENDED gmo
  (`GE`), constrained by `cmoPpoOk`; the load value check `lvX` (Ref's axiom, or the invalidate clause).
* `amocas.w/d` (zacas.adoc:73–84, :148–163): "atomically loads … compares the loaded value to the lower 32 bits of
  the value held in rd, and if the comparison is bitwise equal, then stores the value from rs2 … The value loaded
  from memory is sign-extended and is placed into register rd"; success: "acquire semantics if aq … release
  semantics if rl"; failure: "acquire semantics if aq … does not have release semantics, regardless of rl"; NOTE
  "An unsuccessful amocas.w/d/q may either not perform a memory write or may write back the old value loaded from
  memory … Irrespective of whether a write is actually performed, the instruction is treated as an AMO for the
  purposes of the RVWMO PPO rules".  Rendering: success = an `amo` event writing `rs2`; failure with write-back = an
  `amo` event writing the old value, release dropped; failure without write = a load event (`ld`, acquire kept)
  that the PPO rules treat as an AMO (`casfOk`: also a store for rules 1, 4, 10, 11, 13).  `rs2` and `rd` are the
  data sources (rvwmo.adoc listing: amocas "rd^D, rs2^D").
* I/O (mm-explanatory.adoc:1139–1140 "For I/O, the load value axiom and atomicity axiom in general do not apply";
  priv_machine.adoc:2924–2928 "Regular main memory is required to have a number of properties … whereas I/O devices
  can have a much broader range of attributes"): an I/O load with no device model returns ANY value; the runner
  draws it from the finite domain `ioDom`, as the machine side does.
-/
import Weak.Prom.RefCheck
import Weak.Prom.Machine

namespace Weak.Prom.RefX

open Weak.Prom.Ref
open Weak.Prom (CmoKind isInvalK isCleanK)

/-! ## 1. Extended programs -/

/-- An extended instruction: a phase-1 instruction, or one of the forms of this file. -/
inductive XI where
  | i (ins : Instr)
  /-- a plain load that MAY be misaligned (`l{b,h,w,d}[u] rd, off(rs1)`) -/
  | ldM (sz : Nat) (sgn : Bool) (rd rs1 off : Nat)
  /-- a plain store that MAY be misaligned -/
  | stM (sz : Nat) (rs2 rs1 off : Nat)
  /-- `cbo.zero (rs1)` -/
  | cboZero (rs1 : Nat)
  /-- `cbo.inval/clean/flush (rs1)` -/
  | cbo (k : CmoKind) (rs1 : Nat)
  /-- `amocas.{w,d}[.aq][.rl] rd, rs2, (rs1)` -/
  | amocas (sz : Nat) (aq rl : Bool) (rd rs2 rs1 : Nat)
  deriving Inhabited

/-- An extended test. -/
structure XTest where
  harts : List (List XI)
  regs0 : List (List (Nat × Nat))
  img : List (Nat × Nat)
  io : List IoRegion := []

def XTest.base (T : XTest) : Test := ⟨[], T.regs0, T.img, T.io, .tt⟩

/-- The cache block size (`2 ^ plat_cache_block_size_exp`; config `cache_block_size_exp = 6`). -/
def blk : Nat := 64

/-- The misaligned atomicity granule of RAM (config regions[2] `misaligned_atomicity_granule_size_exp = 4`). -/
def mag : Nat := 16

/-- A CMO event: hart, dynamic index, kind, block address expression, its address and control dependencies. -/
structure CmoEv where
  h : Nat
  ii : Nat
  k : CmoKind
  addr : Ex
  adep : List Nat
  cdep : List Nat
  deriving Inhabited

/-- The extended symbolic hart state. -/
structure XSt where
  s : SSt
  /-- event indices exempt from the natural-alignment check (components of a misaligned or `cbo.zero` access) -/
  pieces : List Nat := []
  /-- load events of failed `amocas` without a write (an AMO for the PPO rules) -/
  casf : List Nat := []
  cmos : List CmoEv := []
  deriving Inhabited

/-- Compositions of `n` (ordered lists of positive parts summing to `n`). -/
def comps : Nat → List (List Nat)
  | 0 => [[]]
  | n + 1 => (List.range (n + 1)).flatMap (fun k =>
      have : n - k < n + 1 := by omega
      (comps (n - k)).map (fun c => (k + 1) :: c))

/-- The `cbo.zero` decompositions the runner explores (see the header). -/
def cboZeroComps : List (List Nat) := [[64], [1, 63], [32, 32], [63, 1]]

/-- The offsets of a composition. -/
def offsets (pcs : List Nat) : List Nat := (pcs.foldl (fun (acc : List Nat × Nat) p => (acc.1 ++ [acc.2], acc.2 + p)) ([], 0)).1

/-- `a & m`. -/
def andE (a : Ex) (m : Nat) : Ex := .bin .and a (.c m)

/-- Emit the component events of an access (all with the instruction's dynamic index). -/
def emitPieces (x : XSt) (mk : Nat → Nat → SEv) (pcs : List Nat) : XSt × List Nat :=
  let i0 := x.s.evs.length
  let evs := (pcs.zip (offsets pcs)).map (fun (p, o) => mk p o)
  let ids := (List.range evs.length).map (· + i0)
  ({ x with s := { x.s with evs := x.s.evs ++ evs }, pieces := x.pieces ++ ids }, ids)

/-- The 64-bit sign extension of an `sz`-byte value `v` as an expression. -/
def sextE (sz : Nat) (v : Ex) : Ex :=
  if sz < 8 then .bin .sub (.bin .xor v (.c (2 ^ (8 * sz - 1)))) (.c (2 ^ (8 * sz - 1))) else v

def addCond (x : XSt) (c : PCond) : XSt := { x with s := { x.s with conds := x.s.conds ++ [c] } }

/-- One extended instruction: all successors. -/
def xstep (h n : Nat) (x : XSt) : XI → List XSt
  | .i ins =>
    match stepI h n x.s ins with
    | .stuck => []
    | .next s' => [{ x with s := s' }]
    | .fork t f => [{ x with s := t }, { x with s := f }]
  | .ldM sz sgn rd rs1 off =>
    let s := x.s
    let (e1, t1) := s.rd rs1
    let a := Ex.bin .add e1 (.c off)
    let aligned := match stepI h n s (.load sz sgn rd rs1 off) with
      | .next s' => [{ x with s := s' }]
      | _ => []
    let misal : PCond := (.ne, andE a (sz - 1), .c 0, true)
    let within : PCond := (.ltu, .bin .add (andE a (mag - 1)) (.c (sz - 1)), .c mag, true)
    let cross : PCond := (.ltu, .bin .add (andE a (mag - 1)) (.c (sz - 1)), .c mag, false)
    let mkEv := fun (p o : Nat) => (⟨{ kind := .ld, ii := s.ii, sz := p, adep := t1, cdep := s.ctl },
      .bin .add a (.c o), .c 0⟩ : SEv)
    let piecesV := fun (pcs : List Nat) (cs : List PCond) =>
      let (x1, ids) := emitPieces x mkEv pcs
      let parts := (ids.zip (pcs.zip (offsets pcs))).map (fun (j, p, o) =>
        Ex.bin .sll (.ld (h, j) p false) (.c (8 * o)))
      let v := parts.foldl (fun acc e => Ex.bin .or acc e) (.c 0)
      let v := if sgn then sextE sz v else v
      let x2 := cs.foldl addCond x1
      { x2 with s := (x2.s.wr rd (v, ids)).adv }
    aligned ++ [piecesV [sz] [misal, within]] ++ (comps sz).map (fun pcs => piecesV pcs [misal, cross])
  | .stM sz rs2 rs1 off =>
    let s := x.s
    let (e1, t1) := s.rd rs1
    let (e2, t2) := s.rd rs2
    let a := Ex.bin .add e1 (.c off)
    let aligned := match stepI h n s (.store sz rs2 rs1 off) with
      | .next s' => [{ x with s := s' }]
      | _ => []
    let misal : PCond := (.ne, andE a (sz - 1), .c 0, true)
    let within : PCond := (.ltu, .bin .add (andE a (mag - 1)) (.c (sz - 1)), .c mag, true)
    let cross : PCond := (.ltu, .bin .add (andE a (mag - 1)) (.c (sz - 1)), .c mag, false)
    let mkEv := fun (p o : Nat) => (⟨{ kind := .st, ii := s.ii, sz := p, adep := t1, ddep := t2, cdep := s.ctl },
      .bin .add a (.c o), .bin .srl e2 (.c (8 * o))⟩ : SEv)
    let piecesV := fun (pcs : List Nat) (cs : List PCond) =>
      let (x1, _) := emitPieces x mkEv pcs
      let x2 := cs.foldl addCond x1
      { x2 with s := x2.s.adv }
    aligned ++ [piecesV [sz] [misal, within]] ++ (comps sz).map (fun pcs => piecesV pcs [misal, cross])
  | .cboZero rs1 =>
    let s := x.s
    let (e1, t1) := s.rd rs1
    let a := andE e1 (two64 - blk)
    let mkEv := fun (p o : Nat) => (⟨{ kind := .st, ii := s.ii, sz := p, adep := t1, cdep := s.ctl },
      .bin .add a (.c o), .c 0⟩ : SEv)
    cboZeroComps.map (fun pcs =>
      let (x1, _) := emitPieces x mkEv pcs
      { x1 with s := x1.s.adv })
  | .cbo k rs1 =>
    let s := x.s
    let (e1, t1) := s.rd rs1
    [{ x with cmos := x.cmos ++ [⟨h, s.ii, k, andE e1 (two64 - blk), t1, s.ctl⟩], s := s.adv }]
  | .amocas sz aq rl rd rs2 rs1 =>
    let s := x.s
    let (e1, t1) := s.rd rs1
    let (e2, t2) := s.rd rs2
    let (e3, t3) := s.rd rd
    let i := s.evs.length
    let old := Ex.ld (h, i) sz true
    let mask := 2 ^ (8 * sz) - 1
    let eqc : Bool → PCond := fun b => (.eq, andE old mask, andE e3 mask, b)
    let mk := fun (k : Kind) (aqb rlb : Bool) (w : Ex) =>
      (⟨{ kind := k, ii := s.ii, sz := sz, aqSc := aqb, rlSc := rlb, adep := t1, ddep := t2 ++ t3,
          cdep := s.ctl }, e1, w⟩ : SEv)
    let fin := fun (x1 : XSt) => { x1 with s := (x1.s.wr rd (old, [i])).adv }
    -- success: an AMO writing rs2
    let succ := fin (addCond { x with s := s.emit (mk .amo aq rl (.amo .swap sz old e2)) } (eqc true))
    -- failure, write-back of the old value: an AMO, release dropped
    let wb := fin (addCond { x with s := s.emit (mk .amo aq false (.amo .swap sz old old)) } (eqc false))
    -- failure, no write: a load (acquire kept) that the PPO rules treat as an AMO
    let nw := fin (addCond { x with s := s.emit (mk .ld aq false (.c 0)), casf := x.casf ++ [i] } (eqc false))
    [succ, wb, nw]

/-- All complete paths of hart `h` from `x`. -/
def xexplore (p : List XI) (h : Nat) : Nat → XSt → List XSt
  | 0, _ => []
  | fuel + 1, x =>
    if x.s.pc = p.length then [x] else
    match p[x.s.pc]? with
    | none => []
    | some i => (xstep h p.length x i).flatMap (xexplore p h fuel)

def XTest.init (T : XTest) (h : Nat) : XSt :=
  { s := { pc := 0
           regs := (List.range 32).map (fun r => (.c ((((T.regs0[h]?).getD []).lookup r).getD 0), []))
           evs := [], ii := 0, ctl := [], conds := [] } }

/-- Every combination of per-hart paths.  The step bound: an extended instruction emits at most `blk` events but
advances `pc` by one, so `|prog| + 1` suffices (forward-only programs). -/
def XTest.paths (T : XTest) : List (List XSt) :=
  let rec go : Nat → List (List XSt)
    | 0 => [[]]
    | k + 1 =>
      let h := T.harts.length - (k + 1)
      let p := (T.harts[h]?).getD []
      (xexplore p h (p.length + 1) (T.init h)).flatMap (fun x => (go k).map (x :: ·))
  go T.harts.length

/-! ## 2. The extended gmo and the checks -/

/-- An element of the extended gmo: a memory event, or the `k`-th CMO event of the path. -/
inductive GE where
  | m (e : EvId)
  | c (k : Nat)
  deriving DecidableEq, Inhabited, Repr

def posX (g : List GE) (x : GE) : Nat := pos' g x
where pos' : List GE → GE → Nat
  | [], _ => 0
  | y :: t, x => if y = x then 0 else pos' t x + 1

def before (g : List GE) (a b : GE) : Bool := g.contains a && g.contains b && decide (posX g a < posX g b)

/-- The block of a CMO event under `ν`. -/
def cmoLo (ν : Val) (c : CmoEv) : Nat := c.addr.eval ν

def coversC (ν : Val) (c : CmoEv) (x : Nat) : Bool := decide (cmoLo ν c ≤ x ∧ x < cmoLo ν c + blk)

def overlapsC (ν : Val) (c : CmoEv) (v : Ev) : Bool := decide (cmoLo ν c < v.pa + v.sk.sz ∧ v.pa < cmoLo ν c + blk)

/-- THE PPO RULES OF THE CMO EVENTS (cmo.adoc:228–247), against the memory events and the other CMO events of the
same hart: a CMO is a STORE for rules 1, 4 (W class), 5, 6, 9, 11, 13 (no annotations, no data source), and the
extra overlap rule orders it before a later overlapping load.  Fence.i is not a FENCE event (RefProg). -/
def cmoPpoOk (X : Exec) (ν : Val) (cmos : List CmoEv) (g : List GE) : Bool :=
  let ids := X.ids
  let fences := ids.filter (fun f => match (X.sk f).kind with | .fence _ => true | _ => false)
  let fset := fun (f : EvId) => match (X.sk f).kind with | .fence fs => some fs | _ => none
  (List.range cmos.length).all (fun k =>
    let c := (cmos[k]?).getD default
    let mem := ids.filter (fun e => e.1 == c.h && (X.sk e).kind.isMem)
    -- e po-before c
    (mem.all (fun e => !decide ((X.sk e).ii < c.ii) || (
      let need :=
        overlapsC ν c (X.ev e) ||                                                   -- rule 1 (c a store)
        fences.any (fun f => f.1 == c.h && decide ((X.sk e).ii < (X.sk f).ii) && decide ((X.sk f).ii < c.ii) &&
          match fset f with
          | some fs => inPred X.sk (isIo X) fs e && fs.sw
          | none => false) ||                                                       -- rule 4, c in the W class
        (X.sk e).aqSc || (X.sk e).aqPc ||                                           -- rule 5
        ((X.sk e).kind.isLoad && (c.adep.contains e.2 || c.cdep.contains e.2)) ||   -- rules 9, 11
        ((X.sk e).kind.isLoad && ids.any (fun m => m.1 == c.h && decide ((X.sk e).ii < (X.sk m).ii) &&
          decide ((X.sk m).ii < c.ii) && (X.sk m).adep.contains e.2))               -- rule 13
      !need || before g (.m e) (.c k)))) &&
    -- c po-before e
    (mem.all (fun e => !decide (c.ii < (X.sk e).ii) || (
      let need :=
        ((X.sk e).kind.isStore && overlapsC ν c (X.ev e)) ||                         -- rule 1 (e a store)
        ((X.sk e).kind.isLoad && overlapsC ν c (X.ev e)) ||                          -- the CMO overlap rule
        fences.any (fun f => f.1 == c.h && decide (c.ii < (X.sk f).ii) && decide ((X.sk f).ii < (X.sk e).ii) &&
          match fset f with
          | some fs => fs.pw && inSucc X.sk (isIo X) fs e
          | none => false) ||                                                       -- rule 4, c in the W class
        (X.sk e).rlSc || (X.sk e).rlPc                                              -- rule 6
      !need || before g (.c k) (.m e)))) &&
    -- c before a later overlapping CMO of the hart (rule 1, both stores) or across a W,W fence
    ((List.range cmos.length).all (fun k' =>
      let c' := (cmos[k']?).getD default
      !(c'.h == c.h && decide (c.ii < c'.ii)) ||
        !(decide (cmoLo ν c < cmoLo ν c' + blk ∧ cmoLo ν c' < cmoLo ν c + blk) ||
          fences.any (fun f => f.1 == c.h && decide (c.ii < (X.sk f).ii) && decide ((X.sk f).ii < c'.ii) &&
            match fset f with | some fs => fs.pw && fs.sw | none => false)) ||
        before g (.c k) (.c k'))))

/-- THE PPO RULES OF A FAILED `amocas` WITHOUT A WRITE ("treated as an AMO for the purposes of the RVWMO PPO
rules"): besides Ref's rules for the load it is, the store rules with it as `b` (1, 4 (W class), 10, 11, 13) and
with it as `a` (4, W class). -/
def casfOk (X : Exec) (casf : List EvId) : Bool :=
  let ids := X.ids
  let fences := ids.filter (fun f => match (X.sk f).kind with | .fence _ => true | _ => false)
  let fset := fun (f : EvId) => match (X.sk f).kind with | .fence fs => some fs | _ => none
  casf.all (fun c =>
    let mem := ids.filter (fun e => e.1 == c.1 && (X.sk e).kind.isMem)
    mem.all (fun e =>
      (!poX X e c || (
        let need := overlapB (X.ev e) (X.ev c) ||
          fences.any (fun f => poX X e f && poX X f c && match fset f with
            | some fs => inPred X.sk (isIo X) fs e && fs.sw | none => false) ||
          ((X.sk c).ddep.contains e.2 || (X.sk c).cdep.contains e.2) ||
          ids.any (fun m => poX X e m && poX X m c && (X.sk m).adep.contains e.2)
        !need || gmoBefore X e c)) &&
      (!poX X c e || (
        let need := fences.any (fun f => poX X c f && poX X f e && match fset f with
            | some fs => fs.pw && inSucc X.sk (isIo X) fs e | none => false)
        !need || gmoBefore X c e))))

/-- THE INVALIDATE CLAUSE (cmo.adoc:259–274): "If an invalidate operation i precedes a load r and operates on a byte x
returned by r, and no store to x appears between i and r in program order or in the global memory order, then r
returns any of the following values for x: 1. If no clean or flush operations on x precede i in the global memory
order, either the initial value of x or the value of any store to x that precedes i; 2. If no store to x precedes a
clean or flush operation on x in the global memory order and if the clean or flush operation on x precedes i in the
global memory order, either the initial value of x or the value of any store to x that precedes i; 3. If a store to
x precedes a clean or flush operation on x in the global memory order and if the clean or flush operation on x
precedes i in the global memory order, either the value of the latest store to x that precedes the latest clean or
flush operation on x or the value of any store to x that both precedes i and succeeds the latest clean or flush
operation on x that precedes i".  "Precedes" is gmo; the clause holds for ANY qualifying invalidate (a flush
includes an invalidate). -/
def invalAlt (X : Exec) (ν : Val) (cmos : List CmoEv) (g : List GE) (r : EvId) (x v : Nat) : Bool :=
  let stores := X.ids.filter (fun w => writesB (X.ev w) x)
  (List.range cmos.length).any (fun k =>
    let i := (cmos[k]?).getD default
    isInvalK i.k && coversC ν i x && before g (.c k) (.m r) &&
    -- no store to x between i and r, in gmo or in program order
    !stores.any (fun w => (before g (.c k) (.m w) && before g (.m w) (.m r)) ||
      (w.1 == i.h && r.1 == i.h && decide (i.ii < (X.sk w).ii) && decide ((X.sk w).ii < (X.sk r).ii))) &&
    let pre := stores.filter (fun w => before g (.m w) (.c k))
    -- a flush "atomically performs a clean operation followed by an invalidate operation" (cmo.adoc:116–126):
    -- its own clean precedes its own invalidate
    let cleans := (List.range cmos.length).filter (fun k' =>
      let c := (cmos[k']?).getD default
      isCleanK c.k && coversC ν c x && before g (.c k') (.c k)) ++ (if isCleanK i.k then [k] else [])
    match cleans.getLast? with   -- `cleans` is in CMO-index order; take the gmo-latest
    | none => v == X.img x || pre.any (fun w => wbyte (X.ev w) x == v)
    | some _ =>
      let cl := (cleans.foldl (fun (acc : Option Nat) k' =>
        match acc with
        | none => some k'
        | some a => if before g (.c a) (.c k') then some k' else some a) none).getD 0
      let preC := stores.filter (fun w => before g (.m w) (.c cl))
      match (g.filter (fun e => match e with | .m w => preC.contains w | _ => false)).getLast? with
      | none => v == X.img x || pre.any (fun w => wbyte (X.ev w) x == v)
      | some (.m wl) => v == wbyte (X.ev wl) x || pre.any (fun w => before g (.c cl) (.m w) && wbyte (X.ev w) x == v)
      | some _ => false)

/-- THE LOAD VALUE AXIOM WITH THE INVALIDATE CLAUSE: every byte of every RAM load is Ref's value, or one the
invalidate clause allows. -/
def lvX (X : Exec) (ν : Val) (cmos : List CmoEv) (g : List GE) : Bool :=
  X.ids.all (fun r => !(X.sk r).kind.isLoad || isIo X r ||
    (List.range (X.sk r).sz).all (fun k =>
      let x := (X.ev r).pa + k
      match (X.ev r).rdat[k]? with
      | some v => v == lvVal X r x || invalAlt X ν cmos g r x v
      | none => false))

/-- Ref's axioms other than the load value axiom. -/
def coreNoLV (X : Exec) : Bool := decide (gmoWf X ∧ evWf X ∧ ppoAx X ∧ atomicityAx X ∧ scAx X)

/-! ## 3. The enumerator -/

/-- The I/O value domain (each I/O load answers one of these values). -/
def ioDom : List Nat := [0, 1]

def inIo (io : List IoRegion) (a : Nat) : Bool := io.any (fun r => decide (r.lo ≤ a ∧ a < r.hi))

/-- Every ordering of `rest` (no pruning: CMO and I/O tests are small). -/
def perms : Nat → List GE → List (List GE)
  | 0, rest => if rest = [] then [[]] else []
  | n + 1, rest =>
    if rest = [] then [[]] else
    rest.flatMap (fun e => (perms n (rest.filter (· != e))).map (e :: ·))

/-- The extended gmo candidates: the memory events in an order respecting Ref's static ppo (`statRel`, when the
test has no I/O), with the CMO events interleaved anywhere. -/
def candsX (T : XTest) (xs : List XSt) : List (List GE) :=
  let trs := xs.map (·.s)
  let base : List (List GE) :=
    if T.io.isEmpty then (candsOf trs).map (·.map GE.m)
    else perms (memIds trs).length ((memIds trs).map GE.m)
  let ncmo := (xs.map (·.cmos.length)).foldl (· + ·) 0
  if ncmo = 0 then base else
  let cs := (List.range ncmo).map GE.c
  let rec ins : List GE → List GE → List (List GE)
    | [], l => [l]
    | c :: rest, l => (List.range (l.length + 1)).flatMap (fun p => ins rest (l.take p ++ [c] ++ l.drop p))
  base.flatMap (fun g => ins cs g)

/-- The value pass along the extended gmo, BRANCHING: a RAM load takes Ref's value or, where a CMO invalidate
precedes it, any candidate byte value (checked by `lvX`); an I/O load takes any value of `ioDom`. -/
def passX (T : XTest) (trs : List SSt) (cmos : List CmoEv) (g : List GE) : List (List (EvId × List Nat)) :=
  let gm := g.filterMap (fun e => match e with | .m x => some x | _ => none)
  let img := T.base.imgF
  g.foldl (fun accs e =>
    match e with
    | .c _ => accs
    | .m r =>
      if !(sskOf trs r).kind.isLoad then accs else
      accs.flatMap (fun acc =>
        let ν := lk acc
        let se := sevAt trs r
        let a := se.addr.eval ν
        let sz := se.sk.sz
        if inIo T.io a then ioDom.map (fun v => (r, byteList v sz) :: acc) else
        let lv := lvComp img trs gm ν r
        let preInv := (List.range cmos.length).any (fun k =>
          isInvalK ((cmos[k]?).getD default).k && before g (.c k) (.m r))
        if !preInv then [(r, lv) :: acc] else
        -- per byte: the initial value and every store's byte to it (a superset; `lvX` decides)
        let opts := (List.range sz).map (fun k =>
          let x := a + k
          (img x :: ((sids trs).filter (fun w => (sskOf trs w).kind.isStore &&
             touchesS ν (sevAt trs w) x)).map (fun w => wbyteS ν (sevAt trs w) x)).eraseDups)
        let rec prod : List (List Nat) → List (List Nat)
          | [] => [[]]
          | o :: rest => (prod rest).flatMap (fun tl => o.map (· :: tl))
        (prod opts).map (fun bs => (r, bs) :: acc))) [[]]

/-- The path conditions hold and every access event is naturally aligned, except the components of a decomposed
access (`pieces`). -/
def condsOkX (ν : Val) (xs : List XSt) : Bool :=
  xs.all (fun x =>
    x.s.conds.all (fun (c, a, b, t) => brEval c (a.eval ν) (b.eval ν) == t) &&
    (List.range x.s.evs.length).all (fun j =>
      let se := (x.s.evs[j]?).getD default
      !se.sk.kind.isAcc || x.pieces.contains j || (se.addr.eval ν % se.sk.sz == 0)))

/-- Observable keys (as `Mach.Key`): a final register, or `sz` final bytes at `a`. -/
inductive OKey where
  | reg (h r : Nat)
  | mem (a sz : Nat)
  deriving DecidableEq, Inhabited

/-- THE EXTENDED REFERENCE'S OUTCOME SET on the observables; also the number of consistent candidates. -/
def refOutcomesX (T : XTest) (obs : List OKey) : List (List Nat) × Nat := Id.run do
  let mut outs : List (List Nat) := []
  let mut n := 0
  for xs in T.paths do
    let trs := xs.map (·.s)
    -- CMO events of the path, numbered in hart order
    let cmos := xs.flatMap (·.cmos)
    let casf := (List.range xs.length).flatMap (fun h => ((xs[h]?).map (·.casf)).getD [] |>.map (fun j => (h, j)))
    for g in candsX T xs do
      let gm := g.filterMap (fun e => match e with | .m x => some x | _ => none)
      for acc in passX T trs cmos g do
        let ν := lk acc
        if !condsOkX ν xs then continue
        let X := conc T.base trs ν gm
        if coreNoLV X && lvX X ν cmos g && casfOk X casf && cmoPpoOk X ν cmos g then
          n := n + 1
          let o := obs.map (fun k => match k with
            | .reg h r => finalReg trs ν h r
            | .mem a sz => bytesVal ((List.range sz).map (fun j => finalByte X (a + j))))
          if !outs.contains o then outs := outs ++ [o]
  return (outs, n)

end Weak.Prom.RefX
