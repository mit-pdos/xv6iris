/-- The CSR variants: register forms with `(rs1, rd) ∈ {(6,5), (0,5), (6,0)}`, immediate forms with
`(uimm, rd) ∈ {(3,5), (0,5), (3,0)}`; a write to a read-only CSR is illegal (skipped). -/
def csrVariants (row : String) (csrs : List (Nat × String)) : List Cls :=
  csrs.flatMap (fun (csr, cn) =>
    [(1, "csrrw"), (2, "csrrs"), (3, "csrrc"), (5, "csrrwi"), (6, "csrrsi"), (7, "csrrci")].flatMap (fun (f3, n) =>
      let fs : List (Nat × Nat) := if f3 < 4 then [(6, 5), (0, 5), (6, 0)] else [(3, 5), (0, 5), (3, 0)]
      fs.filterMap (fun (f, rd) =>
        let writes := f3 == 1 || f3 == 5 || f ≠ 0
        if csrRO csr && writes then none
        else some ⟨row, s!"{n} x{rd},{cn},{if f3 < 4 then "x" else "#"}{f}", csrW csr f f3 rd, sCsr f3 csr f rd,
          .plain, false⟩)))

/-- C-D-25 … C-D-29 (bit-manipulation, Zicond, Zimop). -/
def clsExt : List Cls :=
  -- C-D-25/26: Zba/Zbb/Zbs (off in the shipped config: expected to decode as ILLEGAL and trap)
  ([("sh1add", rT 0x10 7 6 2 5 0x33), ("add.uw", rT 0x04 7 6 0 5 0x3b), ("andn", rT 0x20 7 6 7 5 0x33),
    ("min", rT 0x05 7 6 4 5 0x33), ("rol", rT 0x30 7 6 1 5 0x33), ("bset", rT 0x14 7 6 1 5 0x33),
    ("clz", iT 0x600 6 1 5 0x13), ("rev8", iT 0x6b8 6 5 5 0x13)].map (fun (n, w) =>
      (⟨"C-D-25/26", n, w, dAlu 5 (if n == "clz" || n == "rev8" then [6] else [6, 7]), .plain, false⟩ : Cls))) ++
  -- C-D-27 Zbc, C-D-28 Zicond
  ([("clmul", 5, 1), ("clmulr", 5, 2), ("clmulh", 5, 3), ("czero.eqz", 7, 5), ("czero.nez", 7, 7)].map
    (fun (n, f7, f3) => (⟨if f7 == 5 then "C-D-27" else "C-D-28", n, rT f7 7 6 f3 5 0x33, dAlu 5 [6, 7],
      .plain, false⟩ : Cls))) ++
  -- C-D-29 Zimop: `mop.r.n rd, rs1` (rd ← 0) and `mop.rr.n rd, rs1, rs2`; general rule (rs1/rs2 → rd)
  ([0, 1, 27, 31].map (fun n =>
    let w := 0x81c00000 ||| ((n >>> 4) % 2 <<< 30) ||| (((n >>> 2) % 4) <<< 26) ||| ((n % 4) <<< 20) |||
      (6 <<< 15) ||| (4 <<< 12) ||| (5 <<< 7) ||| 0x73
    (⟨"C-D-29", s!"mop.r.{n}", w, dAlu 5 [6], .plain, false⟩ : Cls))) ++
  ([0, 3, 7].map (fun n =>
    let w := 0x82000000 ||| ((n >>> 2) % 2 <<< 30) ||| ((n % 4) <<< 26) ||| (7 <<< 20) ||| (6 <<< 15) |||
      (4 <<< 12) ||| (5 <<< 7) ||| 0x73
    (⟨"C-D-29", s!"mop.rr.{n}", w, dAlu 5 [6, 7], .plain, false⟩ : Cls)))

