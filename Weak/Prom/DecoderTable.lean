/-
Weak/Prom: **the decoder-check class table** (S0-P part (3); plan rev 7 §1A "Emission (C-D rows)", Table C §5
family C-D and §6 family C-R): one entry per Sail `instruction` encoding class, with a concrete encoding and the
EXPECTED syntactic dependency roles transcribed from the manual (`~/dev/weak-orch/promising/spec/rvwmo.adoc`,
`riscv/riscv-isa-manual` @ e17d92a1):

* the general definition, rvwmo.adoc:175–208: "a register r other than x0 is a source register for an
  instruction i if … In the opcode of i, rs1, rs2, or rs3 is set to r … i is a CSR instruction, and in the opcode
  of i, csr is set to r, unless i is csrrw or csrrwi and rd is set to x0 … r is a CSR that aliases with another
  source register for i"; destinations :192–204 (rd; csr unless csrrs/csrrc with rs1 = x0 or csrrsi/csrrci with
  uimm = 0); "Most non-memory instructions carry a dependency from each of their source registers to each of
  their destination registers" (:206–207);
* the listing, rvwmo.adoc:369–884 (^A^ address source, ^D^ data source, † "does not carry a dependency from any
  source register to any destination register", ‡ "carries dependencies … as specified"), and the note :248–256
  ("a successful sc instruction is considered to have the register specified in rd as a destination register");
* the CSR granularity table, rvwmo.adoc:353–367 (fflags bits 4…0, frm, fcsr = both, ssp; "read-only CSRs are not
  listed, as they do not participate in the definition of syntactic dependencies");
* the control-dependency definition, rvwmo.adoc:242–246 ("m is a branch or indirect jump").

Registers are fixed per class: `rd = x5`, `rs1 = x6`, `rs2 = x7` (base forms); compressed primed fields
`rd' = x9`, `rs1' = x10`, `rs2' = x11` (`x8 + field`), full-field compressed `rd = x5`, `rs2 = x7`; AMOCAS.Q
`rd = x10`, `rs2 = x12` (register pairs).  Registers are abstract (`R`): a GPR, a CSR by its architectural
number with the aliases `sstatus/sie/sip` canonicalised to `mstatus/mie/mip` (one physical register, "a CSR that
aliases with another source register"), or one tracked unit of `fflags`/`frm` (`fcsr` is both).  `mem = true` on
a destination: it receives the memory operation's result (the § "syntactic dependency on i", rvwmo.adoc:210–225,
with i the memory instruction).

`kept`: registers the instruction WRITES (Sail) that are NOT destinations by the text (a failed SC's `rd`,
rvwmo.adoc:589 "_rd_ ^*^ if successful"), so a later instruction keeps its dependency through them
(rvwmo.adoc:215–216 "no instruction program-ordered between i and j has r as a destination register").

Trap-entry and other non-instruction writes (C-R, D-S0-4) are not in the listing; the entries marked `trap` record
them with the D-S0-4 default reading (`LRegW r []`: a destination with no source, "safe under both readings").

Definitions only; the check is `Weak/Prom/DecoderCheck.lean`, the Sail observations `Weak/Prom/DecoderObs.lean`
(generated by `Weak/Prom/DecoderSail.lean`).
-/
import Weak.Prom.Emit

namespace Weak.Prom.Dec

/-! ## 1. Abstract registers and the expected roles -/

/-- An abstract §rvwmo register: a GPR (`x1`–`x31`), a CSR by architectural number (aliases canonicalised), or one
tracked unit of the floating-point CSRs (`ff b` = `fflags` bit `b`, `frm`). -/
inductive R where
  | g (n : Nat)
  | c (n : Nat)
  | ff (b : Nat)
  | frm
  deriving DecidableEq, Repr, Inhabited

/-- The expected syntactic roles of one encoding class. -/
structure Spec where
  asrc : List R := []
  dsrc : List R := []
  ctrl : List R := []
  /-- destination, the sources it carries from, whether it receives the memory result -/
  dests : List (R × List R × Bool) := []
  /-- written by the instruction, not a destination (keeps its dependency) -/
  kept : List R := []
  deriving DecidableEq, Repr, Inhabited

/-- The Sail behaviour a class is run under (for the observation driver): which registers hold what, whether the
SC's reservation predicate holds, which answer the SC's conditional write gets. -/
inductive Mode where
  | plain
  /-- an SC whose conditional write succeeds -/
  | scOk
  /-- an SC that fails at Sail's reservation check (`match_reservation` false: no memory event) -/
  | scFailP
  /-- an SC whose conditional write is answered `.Err ()` (emission v2's memory-level failure, FC-1) -/
  | scFailM
  /-- a conditional branch, taken -/
  | brT
  /-- a conditional branch, not taken -/
  | brN
  deriving DecidableEq, Repr, Inhabited

/-- One encoding class: Table C row, mnemonic, the encoding (a 32-bit word, or a 16-bit compressed parcel
zero-extended), the expected roles, the run mode, and whether it is a trap row (C-R). -/
structure Cls where
  row : String
  name : String
  w : Nat
  exp : Spec
  mode : Mode := .plain
  trap : Bool := false
  deriving Repr, Inhabited

/-- What an emission emits for one class, in the same vocabulary: the union of the memory labels' address and data
sources, the union of the `LCtrl` sources, and per tracked register written its label: `some (srcs, mem)` =
`LRegW r srcs` (`mem`: `DLdRes ∈ srcs`), `none` = `LSilent` (the register's view is left STALE). -/
structure Emitted where
  asrc : List R := []
  dsrc : List R := []
  ctrl : List R := []
  dests : List (R × Option (List R × Bool)) := []
  deriving DecidableEq, Repr, Inhabited

/-- The architectural register of a dependency key (`WeakDeps`: `x1`–`x31`, the CSR pseudo-registers 32–52,
which `WeakDeps.csrReg` assigns to one CSR each, the S/M aliases sharing a key). -/
def rOfKey (n : Nat) : R :=
  match n with
  | 32 => .c 0x180 | 33 => .c 0x141 | 34 => .c 0x341 | 35 => .c 0x140 | 36 => .c 0x340 | 37 => .c 0x105
  | 38 => .c 0x305 | 39 => .c 0x300 | 40 => .c 0x304 | 41 => .c 0x344 | 42 => .c 0x302 | 43 => .c 0x303
  | 44 => .c 0x3b0 | 45 => .c 0x3a0 | 46 => .c 0x306 | 47 => .c 0x30a | 48 => .c 0xf14 | 49 => .c 0xc01
  | 50 => .c 0x142 | 51 => .c 0x143 | 52 => .c 0x14d
  | n => .g n

/-- The registers of a source list (without `DLdRes`). -/
def rsOf (l : List Dsrc) : List R :=
  l.filterMap (fun s => match s with | .DReg n => some (rOfKey n) | .DLdRes => none)

/-- FIX S0rest-F1 (Emit.lean `csrOldKey`): in emission v2 a Zicsr read-modify-write's `rd` takes its source from
the key `53`, which holds the view of the instruction's CSR `p` as it was at the CSR READ (the old CSR).  For the
comparison with the listing the key stands for that CSR: `v2Old b` maps `.g 53` to `p`'s register, and the key's
own write (at the read) is not a register write of the instruction. -/
def v2OldR (b : Option (BitVec 32)) (r : R) : R :=
  match r, v2Roles b with
  | .g 53, .ORcsr p _ _ => rOfKey p.toNat
  | r, _ => r

def v2Old (b : Option (BitVec 32)) (e : Emitted) : Emitted :=
  { e with dests := (e.dests.filter (fun d => d.1 != .g 53)).map (fun (d, o) =>
      (d, o.map (fun (srcs, m) => (srcs.map (v2OldR b), m)))) }

/-- Does a source list carry the load result? -/
def memOf (l : List Dsrc) : Bool := l.any (fun s => match s with | .DLdRes => true | _ => false)

/-- One class as observed by running it through the Sail model (`DecoderSail.lean`): the decoded constructor
(Sail's `ext_decode`, `repr`, truncated), the Sail registers written (names), the tracked keys written (in order),
the today's-emission read set at each tracked write (DEC-7's `ibRds`) and at each `nextPC` write, the stop reason
(`""` when the instruction completed), and both emissions' observed labels. -/
structure Obs where
  name : String
  decoded : String
  writes : List String
  keys : List Nat
  stop : String
  v2 : Emitted
  today : Emitted
  deriving Repr, Inhabited

/-! ## 2. Encoders -/

def rT (f7 rs2 rs1 f3 rd op : Nat) : Nat := (f7 <<< 25) ||| (rs2 <<< 20) ||| (rs1 <<< 15) ||| (f3 <<< 12) ||| (rd <<< 7) ||| op
def iT (imm rs1 f3 rd op : Nat) : Nat := ((imm % 4096) <<< 20) ||| (rs1 <<< 15) ||| (f3 <<< 12) ||| (rd <<< 7) ||| op
def sT (imm rs2 rs1 f3 op : Nat) : Nat :=
  (((imm >>> 5) % 128) <<< 25) ||| (rs2 <<< 20) ||| (rs1 <<< 15) ||| (f3 <<< 12) ||| ((imm % 32) <<< 7) ||| op
/-- B-type with offset 8. -/
def bT8 (rs2 rs1 f3 : Nat) : Nat := (rs2 <<< 20) ||| (rs1 <<< 15) ||| (f3 <<< 12) ||| (4 <<< 8) ||| 0x63
def uT (imm20 rd op : Nat) : Nat := (imm20 <<< 12) ||| (rd <<< 7) ||| op
/-- `jal rd, 8`. -/
def jal8 (rd : Nat) : Nat := (4 <<< 21) ||| (rd <<< 7) ||| 0x6f
def csrW (csr rs1 f3 rd : Nat) : Nat := (csr <<< 20) ||| (rs1 <<< 15) ||| (f3 <<< 12) ||| (rd <<< 7) ||| 0x73
def amoW (f5 aq rl rs2 rs1 f3 rd : Nat) : Nat := rT ((f5 <<< 2) ||| (aq <<< 1) ||| rl) rs2 rs1 f3 rd 0x2f

/-! ## 3. Spec builders -/

def gs (l : List Nat) : List R := (l.filter (· ≠ 0)).map R.g
def dAlu (rd : Nat) (srcs : List Nat) : Spec := if rd = 0 then {} else { dests := [(.g rd, gs srcs, false)] }
def sLoad (rd rs1 : Nat) : Spec := { asrc := gs [rs1], dests := if rd = 0 then [] else [(.g rd, [], true)] }
def sStore (rs1 rs2 : Nat) : Spec := { asrc := gs [rs1], dsrc := gs [rs2] }
def sAmo (rd rs1 rs2 : Nat) : Spec :=
  { asrc := gs [rs1], dsrc := gs [rs2], dests := if rd = 0 then [] else [(.g rd, [], true)] }

/-- CSR canonical register (aliases `sstatus`↦`mstatus`, `sie`↦`mie`, `sip`↦`mip`; `fcsr` is its units). -/
def csrRegs (csr : Nat) : List R :=
  match csr with
  | 0x100 => [.c 0x300]
  | 0x104 => [.c 0x304]
  | 0x144 => [.c 0x344]
  | 0x001 => [.ff 0, .ff 1, .ff 2, .ff 3, .ff 4]
  | 0x002 => [.frm]
  | 0x003 => [.ff 0, .ff 1, .ff 2, .ff 3, .ff 4, .frm]
  | n => [.c n]

/-- Read-only CSRs (number bits 11:10 = 11): "do not participate in the definition of syntactic dependencies". -/
def csrRO (csr : Nat) : Bool := (csr >>> 10) % 4 == 3

/-- The listing's CSR rows (rvwmo.adoc:487–505), GPR `rs1`/`uimm` field `f`, `rd`.
* csrrw‡ rs1, csr* (unless rd = x0) → rd, csr; carries rs1 → csr, csr → rd;
* csrrs/csrrc‡ rs1, csr → rd, csr* (unless rs1 = x0); carries csr and rs1 → csr, csr → rd;
* csrrwi‡ csr* (unless rd = x0) → rd, csr; carries csr → rd;
* csrrsi/csrrci‡ csr → rd, csr* (unless uimm = 0); carries csr → rd and csr.
A read-only CSR contributes nothing (rvwmo.adoc:366–367). -/
def sCsr (f3 csr f rd : Nat) : Spec :=
  let cs := if csrRO csr then [] else csrRegs csr
  let rdD (srcs : List R) : List (R × List R × Bool) := if rd = 0 then [] else [(.g rd, srcs, false)]
  match f3 with
  | 1 => -- csrrw
    { dests := rdD cs ++ cs.map (fun c => (c, gs [f], false)) }
  | 2 | 3 => -- csrrs / csrrc
    if f = 0 then { dests := rdD cs }
    else { dests := rdD cs ++ cs.map (fun c => (c, gs [f] ++ cs, false)) }
  | 5 => -- csrrwi
    { dests := rdD cs ++ cs.map (fun c => (c, [], false)) }
  | _ => -- csrrsi / csrrci
    if f = 0 then { dests := rdD cs }
    else { dests := rdD cs ++ cs.map (fun c => (c, cs, false)) }

