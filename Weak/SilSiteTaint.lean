/-- GENERATED: the return points of the indirect calls (`jalr ra`), with their function entry. -/
def irp : List (Int × Int) :=
  [ (0x80000a72, 0x80000a16), (0x80001a2e, 0x800019ae), (0x800029dc, 0x80002996), (0x8000449a, 0x800043fe), (0x80004554, 0x800044cc), (0x8000609c, 0x80006000) ]

/-- The function of `pc`: the last entry at or below it. -/
def fnOf (pc : Int) : Int := ((fnEntries.filter (fun e => decide (e ≤ pc))).getLast?).getD 0

/-- The direct calls, computed from the image. -/
def callsC : List (Int × Int × Int) :=
  textPcs.filterMap (fun pc =>
    match kflowOf pc with
    | .FLcall tgt => some (tgt, pc + wSize (kw pc), fnOf pc)
    | _ => none)

def isIndCall (pc : Int) : Bool :=
  match kflowOf pc, krole pc with
  | .FLind, .ORjalr rd _ => rd == 1
  | _, _ => false

/-- The indirect-call return points, computed from the image. -/
def irpC : List (Int × Int) :=
  textPcs.filterMap (fun pc => if isIndCall pc then some (pc + wSize (kw pc), fnOf pc) else none)

/-- The generated call table IS the image's. -/
theorem callsEq : calls = callsC := by decide +kernel

theorem irpEq : irp = irpC := by decide +kernel

/-- **NO DIRECT TRANSFER LEAVES ITS FUNCTION** (no tail call, no shared code), and every direct call
targets a function entry — so the activation's function of a pc reached without a call is `fnOf`. -/
theorem noCrossJump :
    textPcs.all (fun pc =>
      match kflowOf pc with
      | .FLjump tgt | .FLbranch tgt => fnOf tgt == fnOf pc
      | .FLcall tgt => fnEntries.contains tgt
      | _ => true) = true := by
  decide +kernel

/-- Where an EMPTY-stack `ret` of an activation of `fe` may land: the return points of the direct
calls of `fe`, and every indirect-call return point (any function may be address-taken). -/
def retConts (fe : Int) : List (Int × Int) :=
  (calls.filter (fun c => c.1 == fe)).map (fun c => (c.2.1, c.2.2)) ++ irp

/-! ## 4. The walk -/

/-- A walk state: pc, the differing-bit masks, the return stack, the activation's function. -/
structure TSt where
  pc : Int
  t : List (Nat × Nat)
  rs : List Int
  fe : Int

def pairsEqb : List (Nat × Nat) → List (Nat × Nat) → Bool
  | [], [] => true
  | (a, b) :: x, (c, d) :: y => Nat.beq a c && Nat.beq b d && pairsEqb x y
  | _, _ => false

def tstEqb (a b : TSt) : Bool :=
  (a.pc == b.pc) && (a.fe == b.fe) && listzEqb a.rs b.rs && pairsEqb a.t b.t

/-- The value rules of a site: branches whose outcome a value premise fixes, and per-arm kills
`(pc, taken arm?, register)`; `stop`: a call of `panic`/`unreachable` ends the path (`noPanic`). -/
structure Rules where
  br : List Int
  clr : List (Int × Bool × Nat)
  stop : Bool

def killAt (ru : Rules) (pc : Int) (arm : Bool) (t : List (Nat × Nat)) : List (Nat × Nat) :=
  ru.clr.foldl (fun t c => if c.1 == pc && c.2.1 == arm then tset t c.2.2 0 else t) t

def stopPcs : List Int := [(KernelSyms.«panic» : Int), (KernelSyms.«unreachable» : Int)]

/-- Inlined call depth. -/
def tDepth : Nat := 6

/-- **ONE STEP.**  `none`: a sink reads a differing register (the path FAILS); `some l`: the
successors (`[]`: the path ends). -/
def tstep (ru : Rules) (s : TSt) : Option (List TSt) :=
  let pc := s.pc
  let t := s.t
  if decide (pc < textLo) || decide (textHi ≤ pc) then none
  else
    let w := kw pc
    let r := krole pc
    if (roleIsStore r && (anyT t (depsAddr r) || anyT t (depsVsrc r)))
        || (roleIsLoad r && anyT t (depsAddr r)) || anyT t (csrSrcs r) then none
    else
      match kflowOf pc with
      | .FLbranch tgt =>
          if anyT t (depsCtrl r) && !(ru.br.contains pc) then none
          else
            let t' := tUpd t pc
            some [⟨pc + wSize w, killAt ru pc false t', s.rs, s.fe⟩,
                  ⟨tgt, killAt ru pc true t', s.rs, s.fe⟩]
      | .FLjump tgt => some [⟨tgt, killAt ru pc false (tUpd t pc), s.rs, s.fe⟩]
      | .FLcall tgt =>
          if ru.stop && stopPcs.contains tgt then some []
          else if Nat.blt s.rs.length tDepth then
            some [⟨tgt, killAt ru pc false (tUpd t pc), (pc + wSize w) :: s.rs, s.fe⟩]
          else none
      | .FLret =>
          if anyT t [.DReg 1] then none
          else
            match s.rs with
            | a :: rs' => some [⟨a, t, rs', s.fe⟩]
            | [] => some ((retConts s.fe).map (fun c => ⟨c.1, t, [], c.2⟩))
      | .FLind => none
      | .FLnone => some [⟨pc + wSize w, killAt ru pc false (tUpd t pc), s.rs, s.fe⟩]

/-- **ALL PATHS** (visited set; a state with no differing register ends its path). -/
def tdfs : Nat → Rules → List TSt → List TSt → Bool
  | 0, _, _, _ => false
  | _ + 1, _, _, [] => true
  | f + 1, ru, seen, s :: w =>
      if s.t.isEmpty then tdfs f ru seen w
      else if seen.any (tstEqb s) then tdfs f ru seen w
      else
        match tstep ru s with
        | none => false
        | some ns => tdfs f ru (s :: seen) (ns ++ w)

def tdFuel : Nat := 20000

/-- The walk's start: the instruction after the load at `pc`, its destination differing in `m`. -/
def tstart (pc : Int) (m : Nat) : TSt :=
  ⟨pc + wSize (kw pc), tset [] ((loadRd pc).getD 0) m, [], fnOf pc⟩

/-- **THE SITE CHECK**: every path from the load at `pc` (destination differing in `m`) kills the
difference before any sink, under the value rules `ru`. -/
def siteOk (pc : Int) (m : Nat) (ru : Rules) : Bool := tdfs tdFuel ru [] [tstart pc m]

/-! ## 5. The census sites -/

/-- The A/D bits of a PTE (bits 6, 7). -/
def adMask : Nat := 0xC0

def noRules : Rules := ⟨[], [], false⟩

/-- `holding+0x12`'s rule: after `seqz a0` (`holding+0x1e`) `a0` agrees (both `0`, [OWN.64]). -/
def ruHolding : Rules := ⟨[], [(sym KernelSyms.«holding» 0x1e, false, 10)], false⟩

/-- `ilock+0xe`'s rule: the `blez` at `ilock+0x10` takes the same arm (both ≥ 1, [OWN.63]). -/
def ruIlock : Rules := ⟨[sym KernelSyms.«ilock» 0x10], [], false⟩

/-- `iunlock+0x1c`'s rule: the `blez` at `iunlock+0x1e` (both ≥ 1, [OWN.63]). -/
def ruIunlock : Rules := ⟨[sym KernelSyms.«iunlock» 0x1e], [], false⟩

/-- `walk+0x32`'s rule: on the TAKEN arm of `beqz a5` (`walk+0x3a`, `a5 = pte & V`), V = 0 so the
PTE's A/D bits are 0 on both sides — `s1` (x9) agrees. -/
def ruWalk : Rules := ⟨[], [(sym KernelSyms.«walk» 0x3a, true, 9)], false⟩

/-- `walkaddr+0x1c`'s rule: no row calls `panic`/`unreachable` (`noPanic`). -/
def ruStop : Rules := ⟨[], [], true⟩

theorem holding12Ok : siteOk (sym KernelSyms.«holding» 0x12) FULL ruHolding = true := by
  decide +kernel

theorem holding12NeedsKill : siteOk (sym KernelSyms.«holding» 0x12) FULL noRules = false := by
  decide +kernel

theorem ilockOk : siteOk (sym KernelSyms.«ilock» 0xe) FULL ruIlock = true := by decide +kernel

theorem iunlockOk : siteOk (sym KernelSyms.«iunlock» 0x1c) FULL ruIunlock = true := by
  decide +kernel

theorem walk32Ok : siteOk (sym KernelSyms.«walk» 0x32) adMask ruWalk = true := by decide +kernel

theorem walk32NeedsKill : siteOk (sym KernelSyms.«walk» 0x32) adMask noRules = false := by
  decide +kernel

theorem walkaddrOk : siteOk (sym KernelSyms.«walkaddr» 0x1c) adMask ruStop = true := by
  decide +kernel

theorem walkaddrNeedsStop : siteOk (sym KernelSyms.«walkaddr» 0x1c) adMask noRules = false := by
  decide +kernel

theorem mappagesOk : siteOk (sym KernelSyms.«mappages» 0x4a) adMask noRules = true := by
  decide +kernel

theorem uvmunmapOk : siteOk (sym KernelSyms.«uvmunmap» 0x5e) adMask noRules = true := by
  decide +kernel

theorem freewalkOk : siteOk (sym KernelSyms.«freewalk» 0x2a) adMask noRules = true := by
  decide +kernel

theorem ismappedOk : siteOk (sym KernelSyms.«ismapped» 0x10) adMask noRules = true := by
  decide +kernel

theorem copyoutOk : siteOk (sym KernelSyms.«copyout» 0x82) adMask noRules = true := by
  decide +kernel

theorem uvmcopyFails : siteOk (sym KernelSyms.«uvmcopy» 0x36) adMask ruStop = false := by
  decide +kernel

theorem uvmclearFails : siteOk (sym KernelSyms.«uvmclear» 0x10) adMask ruStop = false := by
  decide +kernel

/-- `holding+0x0`'s rule (every call context): the `bnez a5` at `holding+0x2` takes the same arm
(both values zero or both non-zero); `a5` is then overwritten by the `lk->cpu` load or dies at the
callers. -/
def ruHold0 : Rules := ⟨[sym KernelSyms.«holding» 0x2], [], false⟩

theorem hold0Ok : siteOk (sym KernelSyms.«holding» 0x0) FULL ruHold0 = true := by decide +kernel

theorem hold0NeedsRule : siteOk (sym KernelSyms.«holding» 0x0) FULL noRules = false := by
  decide +kernel

/-- The ORDER-FREE census rows with their mask and rule (`tSites` order). -/
def tTab : List (Int × Nat × Rules) :=
  [ (sym KernelSyms.«holding» 0x12, FULL, ruHolding)
  , (sym KernelSyms.«ilock» 0xe, FULL, ruIlock)
  , (sym KernelSyms.«iunlock» 0x1c, FULL, ruIunlock)
  , (sym KernelSyms.«walk» 0x32, adMask, ruWalk)
  , (sym KernelSyms.«walkaddr» 0x1c, adMask, ruStop)
  , (sym KernelSyms.«mappages» 0x4a, adMask, noRules)
  , (sym KernelSyms.«uvmunmap» 0x5e, adMask, noRules)
  , (sym KernelSyms.«freewalk» 0x2a, adMask, noRules)
  , (sym KernelSyms.«ismapped» 0x10, adMask, noRules)
  , (sym KernelSyms.«copyout» 0x82, adMask, noRules) ]

theorem tTabSites : tTab.map Prod.fst = tSites := by decide +kernel

/-- **EVERY ORDER-FREE ROW PASSES** its site check. -/
theorem tTabOk : ∀ e, e ∈ tTab → siteOk e.1 e.2.1 e.2.2 = true := by
  intro e he
  simp only [tTab, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact holding12Ok
  · exact ilockOk
  · exact iunlockOk
  · exact walk32Ok
  · exact walkaddrOk
  · exact mappagesOk
  · exact uvmunmapOk
  · exact freewalkOk
  · exact ismappedOk
  · exact copyoutOk

/-- The rows the static walk covers: the order-free rows and `holding+0x0` (whose rule premise is
discharged per call context: by the holder's value from `release`/`sched`, by the order from
`acquire`). -/
def tTabAll : List (Int × Nat × Rules) := (sym KernelSyms.«holding» 0x0, FULL, ruHold0) :: tTab

theorem tTabAllOk : ∀ e, e ∈ tTabAll → siteOk e.1 e.2.1 e.2.2 = true := by
  intro e he
  rcases List.mem_cons.1 he with rfl | h
  · exact hold0Ok
  · exact tTabOk e h

end SilSite

end Weak
