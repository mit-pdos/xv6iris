/-! ## 1. Masks and the abstract state -/

def FULL : Nat := 2 ^ 64 - 1
def M32 : Nat := 2 ^ 32 - 1
def HI32 : Nat := FULL - M32

/-- Sign-extend an `n`-bit field into the 64-bit mask pattern. -/
def sx (v n : Nat) : Nat := if v.testBit (n - 1) then v + (2 ^ 64 - 2 ^ n) else v

/-- The differing bits after `sext.w`: the low word's, and all high bits iff bit 31 differs. -/
def sxw (m : Nat) : Nat := (m &&& M32) ||| (if m.testBit 31 then HI32 else 0)

/-- The differing bits after an arithmetic right shift by `sh`. -/
def sra (m sh : Nat) : Nat := (m >>> sh) ||| (if m.testBit 63 then FULL - (2 ^ (64 - sh) - 1) else 0)

/-- The differing-bit mask of register `x` (`0`: the two files agree on it). -/
def tget : List (Nat × Nat) → Nat → Nat
  | [], _ => 0
  | (r, m) :: t, x => if Nat.beq r x then m else tget t x

/-- Set `x`'s mask (`0` removes it); the list stays sorted by register, so states compare
syntactically. -/
def tset : List (Nat × Nat) → Nat → Nat → List (Nat × Nat)
  | [], x, m => if Nat.beq m 0 then [] else [(x, m)]
  | (r, n) :: t, x, m =>
      if Nat.blt x r then (if Nat.beq m 0 then (r, n) :: t else (x, m) :: (r, n) :: t)
      else if Nat.beq x r then (if Nat.beq m 0 then t else (x, m) :: t)
      else (r, n) :: tset t x m

def dsrcT (t : List (Nat × Nat)) (s : Dsrc) : Bool :=
  match s with
  | .DReg r => !(Nat.beq (tget t r) 0)
  | .DLdRes => false

def anyT (t : List (Nat × Nat)) (l : List Dsrc) : Bool := l.any (dsrcT t)

/-- A CSR access's sources (a write from a differing register is a sink). -/
def csrSrcs (r : OpRoles) : List Dsrc :=
  match r with
  | .ORcsr _ srcs _ => dsrcsOfNums srcs
  | _ => []

/-! ## 2. The transfer -/

/-- The BIT-PRECISE transfers: `(rd, new mask)` for the bitwise / shift / move forms, `none` for the
rest. -/
def maskOp (w : Nat) (t : List (Nat × Nat)) : Option (Nat × Nat) :=
  let g := tget t
  if wIsRvc w then
    let q := w &&& 3
    let f3 := wfield w 15 13
    if Nat.beq q 1 then
      let rd := wfield w 11 7
      let i6 := wfield w 12 12 * 32 + wfield w 6 2
      if Nat.beq f3 1 && Nat.beq i6 0 && !(Nat.beq rd 0) then some (rd, sxw (g rd))
      else if Nat.beq f3 4 then
        let k := wfield w 11 10
        let r := 8 + wfield w 9 7
        if Nat.beq k 2 then some (r, g r &&& sx i6 6)
        else if Nat.beq k 0 then some (r, g r >>> i6)
        else if Nat.beq k 1 then some (r, sra (g r) i6)
        else if Nat.beq (wfield w 12 12) 0 &&
            (Nat.beq (wfield w 6 5) 1 || Nat.beq (wfield w 6 5) 2 || Nat.beq (wfield w 6 5) 3)
        then some (r, g r ||| g (8 + wfield w 4 2))
        else none
      else none
    else if Nat.beq q 2 then
      let rd := wfield w 11 7
      let rs2 := wfield w 6 2
      if Nat.beq f3 0 && !(Nat.beq rd 0) then
        some (rd, (g rd <<< (wfield w 12 12 * 32 + rs2)) % 2 ^ 64)
      else if Nat.beq f3 4 && Nat.beq (wfield w 12 12) 0 && !(Nat.beq rs2 0) && !(Nat.beq rd 0)
      then some (rd, g rs2)
      else none
    else none
  else
    let op := wOp w
    let f3 := wF3 w
    let rd := wfield w 11 7
    let rs1 := wfield w 19 15
    let rs2 := wfield w 24 20
    if Nat.beq op 19 then
      if Nat.beq f3 7 then some (rd, g rs1 &&& sx (wfield w 31 20) 12)
      else if Nat.beq f3 6 || Nat.beq f3 4 then some (rd, g rs1)
      else if Nat.beq f3 1 then some (rd, (g rs1 <<< wfield w 25 20) % 2 ^ 64)
      else if Nat.beq f3 5 then
        some (rd, if w.testBit 30 then sra (g rs1) (wfield w 25 20) else g rs1 >>> wfield w 25 20)
      else if Nat.beq f3 0 && Nat.beq (wfield w 31 20) 0 then some (rd, g rs1)
      else none
    else if Nat.beq op 27 && Nat.beq f3 0 && Nat.beq (wfield w 31 20) 0 then some (rd, sxw (g rs1))
    else if Nat.beq op 51 && Nat.beq (wfield w 31 25) 0 &&
        (Nat.beq f3 4 || Nat.beq f3 6 || Nat.beq f3 7)
    then some (rd, g rs1 ||| g rs2)
    else none

def tUpd1 (t : List (Nat × Nat)) (d : Option (Nat × List Dsrc)) : List (Nat × Nat) :=
  match d with
  | none => t
  | some (rd, srcs) => tset t rd (if anyT t srcs then FULL else 0)

/-- The abstract effect of the instruction at `pc` (x0 is never written). -/
def tUpd (t : List (Nat × Nat)) (pc : Int) : List (Nat × Nat) :=
  match maskOp (kw pc) t with
  | some (rd, m) => if Nat.beq rd 0 then t else tset t rd m
  | none => tUpd1 (tUpd1 t (depsRd (krole pc))) (depsRd2 (krole pc))

