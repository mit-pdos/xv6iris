import Weak.AxSpinE9
import Weak.AxScRun3
import Weak.AxSpinE8

namespace Weak

open Iris Iris.BI Iris.ProofMode Iris.Std MachCSL MachCSL.Stdpp
open Sail Sail.ConcurrencyInterfaceV1
open Sail.ArchSem (FreeM)
open LeanRV64D
open Wlabel

/-! # 1. The instance -/

/-- Rocq `jsteps`: `n` instructions of the joint tracer, the labels appended. -/
noncomputable def AxSpinE8d.jsteps : Nat → RegFile → AxScRun3.Jmem → List Lbl →
    Option (RegFile × AxScRun3.Jmem × List Lbl)
  | 0, rs, mem, acc => some (rs, mem, acc)
  | n + 1, rs, mem, acc =>
    match AxScRun3.jtr (riscvStep false) rs mem none [] with
    | some (rs', mem', ls) => AxSpinE8d.jsteps n rs' mem' (acc ++ ls)
    | none => none

/-- Rocq `ret_on`. -/
def AxSpinE8d.retOn : Nat := 0x80000000
/-- Rocq `ret_off`. -/
def AxSpinE8d.retOff : Nat := 0x80000010

/-- Rocq `mem1` (deviation 1): the spike's image + `ld a1,-8(sp)` (`0xff813583`) at the return
site (Rocq: two `c.nop`). -/
def AxSpinE8d.mem1 : AxScRun3.Jmem :=
  (((rMem.set (AxSpinSpikeRun.w64 AxSpinE8d.retOn) 0x83#8).set
    (AxSpinSpikeRun.w64 (AxSpinE8d.retOn + 1)) 0x35#8).set
    (AxSpinSpikeRun.w64 (AxSpinE8d.retOn + 2)) 0x81#8).set
    (AxSpinSpikeRun.w64 (AxSpinE8d.retOn + 3)) 0xff#8

/-- (Lean-only, deviation 2) The boot image the fetches are pinned to: `mem1`, `Int`-indexed. -/
def AxSpinE8d.img1 : Image := fun a =>
  if 0 ≤ a ∧ a < 2 ^ 64 then AxSpinE8d.mem1 (BitVec.ofInt 64 a) else none

/-- Rocq `cold`: the COLD warm-up run of mycpu. -/
noncomputable def AxSpinE8d.cold : Option (RegFile × AxScRun3.Jmem × List Lbl) :=
  AxSpinE8d.jsteps 14 (rRegs KernelSyms.«mycpu») AxSpinE8d.mem1 []

/-- Rocq `entry`: the WARM entry, PC := mycpu again (ra = `retOn`). -/
noncomputable def AxSpinE8d.entry : RegFile × AxScRun3.Jmem :=
  match AxSpinE8d.cold with
  | some (rs, mem, _) =>
    (((rs.set .PC (AxSpinSpikeRun.w64 KernelSyms.«mycpu»)).set .nextPC
      (AxSpinSpikeRun.w64 KernelSyms.«mycpu»)).set .x1 (AxSpinSpikeRun.w64 AxSpinE8d.retOn), mem)
  | none => (AxSpinSpikeRun.spikeRegs0, fun _ => none)

/-- Rocq `rsE`. -/
noncomputable def AxSpinE8d.rsE : RegFile := AxSpinE8d.entry.1

/-- The 8 little-endian bytes of `v`. -/
def AxSpinE8d.b8 (v : Nat) : List (BitVec 8) :=
  (List.range 8).map fun j => BitVec.ofNat 8 ((v >>> (8 * j)) &&& 0xFF)

/-- Rocq `row_m` (frozen, as Rocq's `Eval vm_compute`): mycpu's 4 items + the return site's
load (deviation 1). -/
def AxSpinE8d.rowM : List Lbl :=
  [.LStore false 0x80000ff8 (AxSpinE8d.b8 AxSpinE8d.retOn) .WCplain,
   .LStore false 0x80000ff0 (AxSpinE8d.b8 0) .WCplain,
   .LLoad false 0x80000ff8 [] (AxSpinE8d.b8 AxSpinE8d.retOn),
   .LLoad false 0x80000ff0 [] (AxSpinE8d.b8 0),
   .LLoad false 0x80000ff8 [] (AxSpinE8d.b8 AxSpinE8d.retOn)]

set_option maxHeartbeats 0 in
/-- (Lean-only) The untrusted generator does produce `rowM` (Rocq froze it unchecked). -/
theorem AxSpinE8d.rowMGen :
    (match AxSpinE8d.jsteps 15 AxSpinE8d.entry.1 AxSpinE8d.entry.2 [] with
     | some (_, _, ls) => ls
     | none => []) = AxSpinE8d.rowM := by
  decide +kernel

theorem AxSpinE8d.rowMLen : AxSpinE8d.rowM.length = 5 := rfl

/-- Rocq `row_m_18` ↦ the return site's load at item 4 (deviation 1). -/
theorem AxSpinE8d.rowM4 :
    AxSpinE8d.rowM[4]? = some (.LLoad false 0x80000ff8 [] (AxSpinE8d.b8 AxSpinE8d.retOn)) := rfl

/-- Rocq `row_mycpu`: `rowM` IS a mycpu row, at `k = 0`. -/
theorem AxSpinE8d.rowMycpu : RowMycpu 0 AxSpinE8d.rowM 0x80000ff8 0x80000ff0 := by
  refine ⟨by decide, ?_⟩
  intro j hj
  match j, hj with
  | 0, _ => exact ⟨_, rfl, _, _, rfl, rfl⟩
  | 1, _ => exact ⟨_, rfl, _, _, rfl, rfl⟩
  | 2, _ => exact ⟨_, rfl, false, rfl⟩
  | 3, _ => exact ⟨_, rfl, false, rfl⟩

/-! # 2. A row-generic driver, sound for the image-pinned `astepAny` -/

/-- Rocq `is_ret`. -/
def AxSpinE8d.isRet (m : SailM Unit) : Bool :=
  match m with
  | .pure _ => true
  | _ => false

/-- Rocq `rd_node`: a plain RAM read node (not a fetch) whose identity is the row item at `k`. -/
def AxSpinE8d.rdNode (row : List Lbl) (k : Nat) (m : SailM Unit) :
    Option (AidentT × (List (BitVec 8) → SailM Unit)) :=
  match m with
  | .impure (.ok o) kk =>
    match o, kk with
    | .memRead n _ req, kk =>
      if devAddr req.pa then none else
      if (classify req.access_kind).akIfetch then none else
      if (classify req.access_kind).akLatest then none else
      match row[k]? with
      | some (.LLoad aq b _ vs) =>
        if aq = (classify req.access_kind).akSync ∧ b = paZ req.pa ∧ vs.length = n
        then some (.IRead aq b vs.length, fun vs' => kk (.Ok (wordOfBytes n vs', none)))
        else none
      | _ => none
    | _, _ => none
  | _ => none

theorem AxSpinE8d.rdNodeAread (row : List Lbl) (k : Nat) (m : SailM Unit) (id : AidentT)
    (KM : List (BitVec 8) → SailM Unit) (cpu : CPU) (rs : RegFile) (ib : Ibch) :
    AxSpinE8d.rdNode row k m = some (id, KM) →
    areadStep row (AxEpiRun.st cpu m rs ib k) id
      (fun vs => AxEpiRun.st cpu (KM vs) rs ib (k + 1)) := by
  intro H
  cases m with
  | pure y => simp only [AxSpinE8d.rdNode, reduceCtorEq] at H
  | impure c kk =>
    cases c with
    | error e => simp only [AxSpinE8d.rdNode, reduceCtorEq] at H
    | ok o =>
      cases o
      case memRead n va req =>
        simp only [AxSpinE8d.rdNode] at H
        cases Hdev : devAddr req.pa
        · cases Hfe : (classify req.access_kind).akIfetch
          · cases Hlat : (classify req.access_kind).akLatest
            · simp only [Hdev, Hfe, Hlat, Bool.false_eq_true, ↓reduceIte] at H
              cases Hlb : row[k]? with
              | none => simp only [Hlb, reduceCtorEq] at H
              | some lb =>
                cases lb with
                | LLoad aq b sv vs =>
                  simp only [Hlb] at H
                  split at H
                  · rename_i Hc
                    obtain ⟨Hsync, Hpa, Hlen⟩ := Hc
                    simp only [Option.some.injEq, Prod.mk.injEq] at H
                    obtain ⟨rfl, rfl⟩ := H
                    refine ⟨_, Hlb, rfl, rfl, ?_⟩
                    intro vs' Hvs'
                    have h := pnodeStepReadAny n va req kk rs ib OpaxWit.wtD0.efDev vs' Hdev
                      (by rw [Hvs', ← Hlen]; rfl)
                    rw [Hfe, Hlat, ← Hsync, ← Hpa] at h
                    refine ⟨rdLabel false false aq b (tagVals vs') (rdAsrc false ib),
                      OpaxWit.wtD0, OpaxWit.wtD0, ?_, ?_,
                      ⟨rfl, none, none, none, rfl, rfl, h, rfl⟩, rfl⟩
                    · simp only [rdLabel, wlRd, aidentRd, tagValsLength, Bool.false_eq_true,
                        ↓reduceIte]
                      rw [Hvs']; rfl
                    · rw [rdLabelRvals _ _ _ _ _ _ rfl, tagValsSnd]
                  · exact absurd H (by simp)
                | _ => simp only [Hlb, reduceCtorEq] at H
            · simp only [Hdev, Hfe, Hlat, Bool.false_eq_true, ↓reduceIte, reduceCtorEq] at H
          · simp only [Hdev, Hfe, Bool.false_eq_true, ↓reduceIte, reduceCtorEq] at H
        · simp only [Hdev, ↓reduceIte, reduceCtorEq] at H
      all_goals simp only [AxSpinE8d.rdNode, reduceCtorEq] at H

/-- Rocq `lb_admin_b` (+ `LIFetch`: a fetch is administrative under Stage C). -/
def AxSpinE8d.lbAdminB (l : Wlabel) : Bool :=
  match l with
  | .LSilent | .LDev .. | .LRegW .. | .LCtrl _ | .LInstr | .LIFetch .. => true
  | _ => false

theorem AxSpinE8d.lbAdminBSound (l : Wlabel) : AxSpinE8d.lbAdminB l = true → lbAdmin true l := by
  cases l <;> simp [AxSpinE8d.lbAdminB, lbAdmin]

/-- Rocq `wr_fit`. -/
def AxSpinE8d.wrFit (row : List Lbl) (k : Nat) (l : Wlabel) : Bool :=
  match row[k]? with
  | some lb => decide ((wlWr l).isSome = true ∧ wlWr l = aidentWr (aident lb) ∧
      wlWdata l = lblData lb)
  | none => false

/-- Rocq `row_vals`. -/
def AxSpinE8d.rowVals (row : List Lbl) (k : Nat) : List (BitVec 8) :=
  match row[k]? with
  | some (.LLoad _ _ _ vs) => vs
  | _ => []

/-- Rocq `rdrive`: drive to the BOUNDARY at `kend`; reads take the row's value unless the
override `ov` gives one (the row-free opsem accepts any value). -/
noncomputable def AxSpinE8d.rdrive (img : Image) (row : List Lbl)
    (ov : Nat → Option (List (BitVec 8))) (kend : Nat) (stop : RegFile → Bool) :
    Nat → SailM Unit → RegFile → Ibch → Nat → Option (RegFile × Ibch)
  | 0, _, _, _, _ => none
  | f + 1, m, rs, ib, k =>
    if k = kend ∧ AxSpinE8d.isRet m = true ∧ stop rs = true then some (rs, ib) else
    match AxSpinE8d.rdNode row k m with
    | some (id, KM) =>
      if ((ov k).getD (AxSpinE8d.rowVals row k)).length = aidentN id
      then AxSpinE8d.rdrive img row ov kend stop f (KM ((ov k).getD (AxSpinE8d.rowVals row k)))
        rs ib (k + 1)
      else none
    | none =>
      match nodeStep2 img row m rs ib k with
      | some (m1, rs1, ib1, k1, it) =>
        if AxSpinE8d.lbAdminB it.1 = true ∧ k1 = k then
          AxSpinE8d.rdrive img row ov kend stop f m1 rs1 ib1 k
        else if AxSpinE8d.wrFit row k it.1 = true ∧ k1 = k + 1 then
          AxSpinE8d.rdrive img row ov kend stop f m1 rs1 ib1 (k + 1)
        else none
      | none => none

/-- (Lean-only, deviation 2) Every item `nodeStep2` records is pinned to its image. -/
theorem AxSpinE8d.nodeStep2Pin (img : Image) (row : List Lbl) (m : SailM Unit) (rs : RegFile)
    (ib : Ibch) (k : Nat) (m' : SailM Unit) (rs' : RegFile) (ib' : Ibch) (k' : Nat)
    (it : Eitem) :
    nodeStep2 img row m rs ib k = some (m', rs', ib', k', it) →
    WeakAxRealize.fetchPin img it.1 := by
  intro Hs
  cases m with
  | pure y =>
    simp only [nodeStep2, Option.some.injEq, Prod.mk.injEq] at Hs
    obtain ⟨-, -, -, -, rfl⟩ := Hs
    trivial
  | impure c kk =>
    cases c with
    | error e => simp only [nodeStep2, reduceCtorEq] at Hs
    | ok o =>
      cases o
      case regWrite r v =>
        simp only [nodeStep2, Option.some.injEq, Prod.mk.injEq] at Hs
        obtain ⟨-, -, -, -, rfl⟩ := Hs
        cases erwOf (depsOfIb ib.ibBits) ib.ibRds r <;> trivial
      case memRead n va req =>
        simp only [nodeStep2] at Hs
        cases Hdev : devAddr req.pa
        · simp only [Hdev, Bool.false_eq_true, ↓reduceIte] at Hs
          cases Hfe : (classify req.access_kind).akIfetch
          · simp only [Hfe, Bool.false_eq_true, ↓reduceIte] at Hs
            repeat' split at Hs
            all_goals first
              | (simp only [reduceCtorEq] at Hs; done)
              | (simp only [Option.some.injEq, Prod.mk.injEq] at Hs
                 obtain ⟨-, -, -, -, rfl⟩ := Hs
                 simp only [rdLabel, Bool.false_eq_true, ↓reduceIte]
                 first | trivial | (split <;> trivial))
          · simp only [Hfe, ↓reduceIte] at Hs
            cases Hr : AxEpiRun.imgRead img (paZ req.pa) n with
            | none => simp only [Hr, reduceCtorEq] at Hs
            | some vs =>
              simp only [Hr, Option.some.injEq, Prod.mk.injEq] at Hs
              obtain ⟨-, -, -, -, rfl⟩ := Hs
              obtain ⟨-, Himg⟩ := AxEpiRun.imgReadSpec _ n _ vs Hr
              refine ⟨?_, ?_⟩
              · intro t ht
                simp only [tagVals, List.map_map, List.mem_map] at ht
                obtain ⟨_, _, rfl⟩ := ht
                rfl
              · intro j hj
                rw [tagValsSnd]
                rw [tagValsLength] at hj
                exact Himg j hj
        · simp only [Hdev, ↓reduceIte, reduceCtorEq] at Hs
      case memWrite n va req =>
        simp only [nodeStep2] at Hs
        repeat' split at Hs
        all_goals first
          | (simp only [reduceCtorEq] at Hs; done)
          | (simp only [Option.some.injEq, Prod.mk.injEq] at Hs
             obtain ⟨-, -, -, -, rfl⟩ := Hs
             trivial)
      case barrier b =>
        simp only [nodeStep2] at Hs
        repeat' split at Hs
        all_goals first
          | (simp only [reduceCtorEq] at Hs; done)
          | (simp only [Option.some.injEq, Prod.mk.injEq] at Hs
             obtain ⟨-, -, -, -, rfl⟩ := Hs
             exact AxScRun2.fetchPinEbar img b)
      case instrAnnounce n w =>
        simp only [nodeStep2] at Hs
        split at Hs
        · simp only [reduceCtorEq] at Hs
        · simp only [Option.some.injEq, Prod.mk.injEq] at Hs
          obtain ⟨-, -, -, -, rfl⟩ := Hs
          trivial
      all_goals first
        | (simp only [nodeStep2, reduceCtorEq] at Hs; done)
        | (simp only [nodeStep2, Option.some.injEq, Prod.mk.injEq] at Hs
           obtain ⟨-, -, -, -, rfl⟩ := Hs
           trivial)

/-- Rocq `admin_astep`. -/
theorem AxSpinE8d.adminAstep (img : Image) (row : List Lbl) (cpu : CPU) (m : SailM Unit)
    (rs : RegFile) (ib : Ibch) (k : Nat) (m1 : SailM Unit) (rs1 : RegFile) (ib1 : Ibch)
    (k1 : Nat) (it : Eitem) :
    nodeStep2 img row m rs ib k = some (m1, rs1, ib1, k1, it) → AxSpinE8d.lbAdminB it.1 = true →
    AxSpinRow.astepPin (WeakAxRealize.fetchPin img) row (AxEpiRun.st cpu m rs ib k)
      (AxEpiRun.st cpu m1 rs1 ib1 k) := by
  intro Hn Ha
  exact .inl ⟨it.1, .AStepAdmin _ _ OpaxWit.wtD0 _ _ OpaxWit.wtD0
    (AxSpinE8d.lbAdminBSound _ Ha) (nodeStep2Label cpu img row m rs ib k m1 rs1 ib1 k1 it Hn),
    AxSpinE8d.nodeStep2Pin img row m rs ib k m1 rs1 ib1 k1 it Hn⟩

/-- Rocq `rdrive_sound`: a successful drive is an image-pinned run to the boundary at `kend`. -/
theorem AxSpinE8d.rdriveSound (img : Image) (row : List Lbl)
    (ov : Nat → Option (List (BitVec 8))) (kend : Nat) (stop : RegFile → Bool) (cpu : CPU) :
    ∀ fuel m rs ib k rs' ib',
      AxSpinE8d.rdrive img row ov kend stop fuel m rs ib k = some (rs', ib') →
      rtc (AxSpinRow.astepPin (WeakAxRealize.fetchPin img) row) (AxEpiRun.st cpu m rs ib k)
        (AxEpiRun.st cpu (.pure ()) rs' ib' kend) := by
  intro fuel
  induction fuel with
  | zero =>
    intro m rs ib k rs' ib' H
    simp only [AxSpinE8d.rdrive, reduceCtorEq] at H
  | succ f IH =>
    intro m rs ib k rs' ib' H
    simp only [AxSpinE8d.rdrive] at H
    by_cases E : k = kend ∧ AxSpinE8d.isRet m = true ∧ stop rs = true
    · rw [if_pos E] at H
      obtain ⟨rfl, Hr, -⟩ := E
      cases m with
      | pure y =>
        simp only [Option.some.injEq, Prod.mk.injEq] at H
        obtain ⟨rfl, rfl⟩ := H
        exact rtc_refl _
      | impure c kk => simp [AxSpinE8d.isRet] at Hr
    · rw [if_neg E] at H
      cases Hrd : AxSpinE8d.rdNode row k m with
      | some p =>
        obtain ⟨id, KM⟩ := p
        rw [Hrd] at H
        dsimp only at H
        split at H
        · rename_i Hl
          refine rtc_l (.inr (.inr ⟨id, _, _, AxSpinE8d.rdNodeAread row k m id KM cpu rs ib Hrd,
            Hl, rfl⟩)) ?_
          exact IH _ _ _ _ _ _ H
        · exact absurd H (by simp)
      | none =>
        rw [Hrd] at H
        dsimp only at H
        cases Hn : nodeStep2 img row m rs ib k with
        | none => rw [Hn] at H; exact absurd H (by simp)
        | some q =>
          obtain ⟨m1, rs1, ib1, k1, it⟩ := q
          rw [Hn] at H
          dsimp only at H
          by_cases Ea : AxSpinE8d.lbAdminB it.1 = true ∧ k1 = k
          · rw [if_pos Ea] at H
            exact rtc_l (AxSpinE8d.adminAstep img row cpu m rs ib k m1 rs1 ib1 k1 it Hn Ea.1)
              (IH _ _ _ _ _ _ H)
          · rw [if_neg Ea] at H
            by_cases Ew : AxSpinE8d.wrFit row k it.1 = true ∧ k1 = k + 1
            · rw [if_pos Ew] at H
              obtain ⟨Hw, rfl⟩ := Ew
              have Hps := nodeStep2Label cpu img row m rs ib k m1 rs1 ib1 (k + 1) it Hn
              unfold AxSpinE8d.wrFit at Hw
              cases Hlb : row[k]? with
              | none => rw [Hlb] at Hw; exact absurd Hw (by simp)
              | some lb =>
                rw [Hlb] at Hw
                obtain ⟨Hs, Hwr, Hd⟩ := of_decide_eq_true Hw
                refine rtc_l (.inl ⟨it.1, .AStepWrite _ _ OpaxWit.wtD0 _ lb _ OpaxWit.wtD0 Hlb Hs
                  Hwr Hd Hps, AxSpinE8d.nodeStep2Pin img row m rs ib k m1 rs1 ib1 (k + 1) it Hn⟩)
                  (IH _ _ _ _ _ _ H)
            · rw [if_neg Ew] at H
              exact absurd H (by simp)

/-- Rocq `nsd`: NOT-STUCK checker — an admin run to a read node that fits the row. -/
noncomputable def AxSpinE8d.nsd (img : Image) (row : List Lbl) :
    Nat → SailM Unit → RegFile → Ibch → Nat → Bool
  | 0, _, _, _, _ => false
  | f + 1, m, rs, ib, k =>
    match AxSpinE8d.rdNode row k m with
    | some _ => true
    | none =>
      match nodeStep2 img row m rs ib k with
      | some (m1, rs1, ib1, k1, it) =>
        AxSpinE8d.lbAdminB it.1 && (k1 == k) && AxSpinE8d.nsd img row f m1 rs1 ib1 k
      | none => false

theorem AxSpinE8d.nsdReach (img : Image) (row : List Lbl) (cpu : CPU) :
    ∀ fuel m rs ib k, AxSpinE8d.nsd img row fuel m rs ib k = true →
      ∃ s2 id K, rtc (AxSpinRow.astepPin (WeakAxRealize.fetchPin img) row)
        (AxEpiRun.st cpu m rs ib k) s2 ∧ areadStep row s2 id K := by
  intro fuel
  induction fuel with
  | zero => intro m rs ib k H; simp only [AxSpinE8d.nsd, Bool.false_eq_true] at H
  | succ f IH =>
    intro m rs ib k H
    simp only [AxSpinE8d.nsd] at H
    cases Hrd : AxSpinE8d.rdNode row k m with
    | some p =>
      obtain ⟨id, KM⟩ := p
      exact ⟨_, id, _, rtc_refl _, AxSpinE8d.rdNodeAread row k m id KM cpu rs ib Hrd⟩
    | none =>
      rw [Hrd] at H
      dsimp only at H
      cases Hn : nodeStep2 img row m rs ib k with
      | none => rw [Hn] at H; exact absurd H (by simp)
      | some q =>
        obtain ⟨m1, rs1, ib1, k1, it⟩ := q
        rw [Hn] at H
        dsimp only at H
        simp only [Bool.and_eq_true, beq_iff_eq] at H
        obtain ⟨⟨Ha, rfl⟩, Hr⟩ := H
        obtain ⟨s2, id, K, Hrt, Hrd2⟩ := IH _ _ _ _ Hr
        exact ⟨s2, id, K,
          rtc_l (AxSpinE8d.adminAstep img row cpu m rs ib k1 m1 rs1 ib1 k1 it Hn Ha) Hrt, Hrd2⟩

theorem AxSpinE8d.nsdNotStuck (img : Image) (row : List Lbl) (cpu : CPU) (fuel : Nat)
    (m : SailM Unit) (rs : RegFile) (ib : Ibch) (k : Nat) :
    AxSpinE8d.nsd img row fuel m rs ib k = true →
    ¬ rowStuckR (WeakAxRealize.fetchPin img) row (AxEpiRun.st cpu m rs ib k) := by
  intro H Hst
  obtain ⟨s2, id, K, Hrt, Hrd⟩ := AxSpinE8d.nsdReach img row cpu fuel m rs ib k H
  exact (Hst s2 Hrt).2.2.1 id K Hrd

/-! # 3. The two runs to the post-c.ret boundary -/

/-- Rocq `fuel0`. -/
def AxSpinE8d.fuel0 : Nat := 3000

/-- Rocq `off_bytes`: what ra's reload (item 2) delivers on the diverted run. -/
def AxSpinE8d.offBytes : List (BitVec 8) := AxSpinE8d.b8 AxSpinE8d.retOff

/-- Rocq `ov_off` (item 13 ↦ item 2, Stage C). -/
def AxSpinE8d.ovOff (j : Nat) : Option (List (BitVec 8)) :=
  if j = 2 then some AxSpinE8d.offBytes else none

/-- (Lean-only, deviation 3) The post-c.ret boundary: the PC has left mycpu. -/
def AxSpinE8d.stopRet (rs : RegFile) : Bool :=
  !(decide (KernelSyms.«mycpu» ≤ (rs .PC).toNat ∧
    (rs .PC).toNat < KernelSyms.«mycpu» + 0x20))

/-- Rocq `run_on`. -/
noncomputable def AxSpinE8d.runOn : Option (RegFile × Ibch) :=
  AxSpinE8d.rdrive AxSpinE8d.img1 AxSpinE8d.rowM (fun _ => none) 4 AxSpinE8d.stopRet
    AxSpinE8d.fuel0 (.pure ()) AxSpinE8d.rsE ibNone 0
/-- Rocq `run_off`. -/
noncomputable def AxSpinE8d.runOff : Option (RegFile × Ibch) :=
  AxSpinE8d.rdrive AxSpinE8d.img1 AxSpinE8d.rowM AxSpinE8d.ovOff 4 AxSpinE8d.stopRet
    AxSpinE8d.fuel0 (.pure ()) AxSpinE8d.rsE ibNone 0

noncomputable def AxSpinE8d.rsOn : RegFile :=
  match AxSpinE8d.runOn with | some (r, _) => r | none => AxSpinSpikeRun.spikeRegs0
noncomputable def AxSpinE8d.ibOn : Ibch :=
  match AxSpinE8d.runOn with | some (_, b) => b | none => ibNone
noncomputable def AxSpinE8d.rsOff : RegFile :=
  match AxSpinE8d.runOff with | some (r, _) => r | none => AxSpinSpikeRun.spikeRegs0
noncomputable def AxSpinE8d.ibOff : Ibch :=
  match AxSpinE8d.runOff with | some (_, b) => b | none => ibNone

set_option maxHeartbeats 0 in
theorem AxSpinE8d.runOnSome : AxSpinE8d.runOn.isSome = true := by decide +kernel

set_option maxHeartbeats 0 in
theorem AxSpinE8d.runOffSome : AxSpinE8d.runOff.isSome = true := by decide +kernel

/-- Rocq `run_on_eq`. -/
theorem AxSpinE8d.runOnEq :
    AxSpinE8d.rdrive AxSpinE8d.img1 AxSpinE8d.rowM (fun _ => none) 4 AxSpinE8d.stopRet
      AxSpinE8d.fuel0 (.pure ()) AxSpinE8d.rsE ibNone 0 =
      some (AxSpinE8d.rsOn, AxSpinE8d.ibOn) := by
  have h := AxSpinE8d.runOnSome
  unfold AxSpinE8d.rsOn AxSpinE8d.ibOn
  unfold AxSpinE8d.runOn at h ⊢
  cases hr : AxSpinE8d.rdrive AxSpinE8d.img1 AxSpinE8d.rowM (fun _ => none) 4 AxSpinE8d.stopRet
      AxSpinE8d.fuel0 (.pure ()) AxSpinE8d.rsE ibNone 0 with
  | none => rw [hr] at h; exact absurd h (by simp)
  | some p => obtain ⟨r, b⟩ := p; rfl

/-- Rocq `run_off_eq`. -/
theorem AxSpinE8d.runOffEq :
    AxSpinE8d.rdrive AxSpinE8d.img1 AxSpinE8d.rowM AxSpinE8d.ovOff 4 AxSpinE8d.stopRet
      AxSpinE8d.fuel0 (.pure ()) AxSpinE8d.rsE ibNone 0 =
      some (AxSpinE8d.rsOff, AxSpinE8d.ibOff) := by
  have h := AxSpinE8d.runOffSome
  unfold AxSpinE8d.rsOff AxSpinE8d.ibOff
  unfold AxSpinE8d.runOff at h ⊢
  cases hr : AxSpinE8d.rdrive AxSpinE8d.img1 AxSpinE8d.rowM AxSpinE8d.ovOff 4 AxSpinE8d.stopRet
      AxSpinE8d.fuel0 (.pure ()) AxSpinE8d.rsE ibNone 0 with
  | none => rw [hr] at h; exact absurd h (by simp)
  | some p => obtain ⟨r, b⟩ := p; rfl

/-- Rocq `reach_on`: the post-c.ret boundary is REACHED on `rowM` from the entry. -/
theorem AxSpinE8d.reachOn (cpu : CPU) :
    rtc (AxSpinRow.astepPin (WeakAxRealize.fetchPin AxSpinE8d.img1) AxSpinE8d.rowM)
      (AxEpiRun.st cpu (.pure ()) AxSpinE8d.rsE ibNone 0)
      (AxEpiRun.st cpu (.pure ()) AxSpinE8d.rsOn AxSpinE8d.ibOn 4) :=
  AxSpinE8d.rdriveSound _ _ _ 4 _ cpu _ _ _ _ _ _ _ AxSpinE8d.runOnEq

/-- Rocq `reach_off`. -/
theorem AxSpinE8d.reachOff (cpu : CPU) :
    rtc (AxSpinRow.astepPin (WeakAxRealize.fetchPin AxSpinE8d.img1) AxSpinE8d.rowM)
      (AxEpiRun.st cpu (.pure ()) AxSpinE8d.rsE ibNone 0)
      (AxEpiRun.st cpu (.pure ()) AxSpinE8d.rsOff AxSpinE8d.ibOff 4) :=
  AxSpinE8d.rdriveSound _ _ _ 4 _ cpu _ _ _ _ _ _ _ AxSpinE8d.runOffEq

set_option maxHeartbeats 0 in
/-- Rocq `pc_on`. -/
theorem AxSpinE8d.pcOn : (AxSpinE8d.rsOn .PC).toNat = AxSpinE8d.retOn := by decide +kernel

set_option maxHeartbeats 0 in
/-- Rocq `pc_off`. -/
theorem AxSpinE8d.pcOff : (AxSpinE8d.rsOff .PC).toNat = AxSpinE8d.retOff := by decide +kernel

/-! # 4. THE TWIN -/

/-- Rocq `p_off`. -/
def AxSpinE8d.pOff (a : Int) (n : Nat) : Bool := a == (AxSpinE8d.retOff : Int) && n == 4

set_option maxHeartbeats 0 in
theorem AxSpinE8d.frbOffT :
    frb AxSpinE8d.img1 AxSpinE8d.pOff (fun _ => false) (riscvStep true)
      ⟨AxSpinE8d.rsOff, fun _ => none, testDevs⟩ = true := by decide +kernel

set_option maxHeartbeats 0 in
theorem AxSpinE8d.frbOffF :
    frb AxSpinE8d.img1 AxSpinE8d.pOff (fun _ => false) (riscvStep false)
      ⟨AxSpinE8d.rsOff, fun _ => none, testDevs⟩ = true := by decide +kernel

/-- Rocq `Coff`. -/
def AxSpinE8d.Coff (rs : RegFile) : Prop := regsAgree AxRunClose.pinReg rs AxSpinE8d.rsOff

/-- Rocq `Coff_seip`. -/
theorem AxSpinE8d.coffSeip (rs rs' : RegFile) :
    AxSpinE8d.Coff rs → regsAgree AxRunClose.pinReg rs' rs → AxSpinE8d.Coff rs' :=
  fun H1 H2 => regsAgreeTrans _ _ _ _ H2 H1

/-- Rocq `div_first_read`. -/
theorem AxSpinE8d.divFirstRead : ∀ rs, AxSpinE8d.Coff rs → ∀ (tick : Bool) (t : ExecSt),
    regsAgree AxRunClose.pinReg t.regs rs →
    FirstRd AxSpinE8d.img1 (fun a n => AxSpinE8d.pOff a n = true)
      (fun t' => AxSpinE8d.Coff t'.regs ∧ t'.regs .PC = AxSpinE8d.rsOff .PC)
      (riscvStep tick) t := by
  intro rs Hc tick t Hag
  have Hag' : regsAgree AxRunClose.pinReg t.regs AxSpinE8d.rsOff := regsAgreeTrans _ _ _ _ Hag Hc
  refine FirstRdMono AxSpinE8d.img1 _ _ (fun t' => (fun _ => false) t' = true) _ _ t
    (fun _ _ h => h) (fun _ h => absurd h Bool.false_ne_true) ?_
  apply frbSound
  rw [← frbAgree AxSpinE8d.img1 AxSpinE8d.pOff false (riscvStep tick)
    ⟨AxSpinE8d.rsOff, fun _ => none, testDevs⟩ t Hag']
  cases tick
  · exact AxSpinE8d.frbOffF
  · exact AxSpinE8d.frbOffT

/-- Rocq `div_stuck`: THE DIVERTED RETURN IS STUCK (its fetch has no image bytes). -/
theorem AxSpinE8d.divStuck (cpu : CPU) (ib : Ibch) :
    rowStuckR (WeakAxRealize.fetchPin AxSpinE8d.img1) AxSpinE8d.rowM
      (AxEpiRun.st cpu (.pure ()) AxSpinE8d.rsOff ib 4) := by
  refine offrowRowStuck AxSpinE8d.img1 AxSpinE8d.Coff AxSpinE8d.coffSeip
    (fun _ a n => AxSpinE8d.pOff a n = true) (AxSpinE8d.rsOff .PC) AxSpinE8d.divFirstRead
    (fun _ => True) trivial cpu 4 AxSpinE8d.rowM ?_ ?_ AxSpinE8d.rsOff ib
    (regsAgreeRefl _ _) trivial
  · intro lb aq pa n v Hlb _ Hp
    rw [AxSpinE8d.rowM4] at Hlb
    cases Hlb
    simp only [AxSpinE8d.pOff, Bool.and_eq_true, beq_iff_eq] at Hp
    obtain ⟨rfl, rfl⟩ := Hp
    simp only [aident, aidentRd, ne_eq, Option.some.injEq, Prod.mk.injEq, not_and]
    intro _ h
    exact absurd h (by decide)
  · rw [AxSpinE8d.rowMLen]; decide

/-- Rocq `nsd_ret`. -/
theorem AxSpinE8d.nsdRet (img : Image) (row : List Lbl) (f : Nat) (rs : RegFile) (ib : Ibch)
    (k : Nat) :
    AxSpinE8d.nsd img row (f + 1) (.pure ()) rs ib k =
      AxSpinE8d.nsd img row f (riscvStep false) rs ibNone k := by
  simp only [AxSpinE8d.nsd, AxSpinE8d.rdNode, nodeStep2, AxSpinE8d.lbAdminB, beq_self_eq_true,
    Bool.true_and]

set_option maxHeartbeats 0 in
/-- Rocq `nsd_on`. -/
theorem AxSpinE8d.nsdOn :
    AxSpinE8d.nsd AxSpinE8d.img1 AxSpinE8d.rowM AxSpinE8d.fuel0 (riscvStep false) AxSpinE8d.rsOn
      ibNone 4 = true := by decide +kernel

/-- Rocq `on_not_stuck`: ... and the MATCHING return is NOT stuck. -/
theorem AxSpinE8d.onNotStuck (cpu : CPU) (ib : Ibch) :
    ¬ rowStuckR (WeakAxRealize.fetchPin AxSpinE8d.img1) AxSpinE8d.rowM
      (AxEpiRun.st cpu (.pure ()) AxSpinE8d.rsOn ib 4) := by
  apply AxSpinE8d.nsdNotStuck AxSpinE8d.img1 AxSpinE8d.rowM cpu (AxSpinE8d.fuel0 + 1)
  rw [AxSpinE8d.nsdRet]
  exact AxSpinE8d.nsdOn

/-- Rocq `div_wpd`: the stuck twin at the WPd level — ANY instance, ANY postcondition. -/
theorem AxSpinE8d.divWpd {hlc : HasLC} {GF : BundledGFunctors} [InvGS_gen hlc GF] [AxirisG GF]
    [Axpol] (i : Agent) (cpu : CPU) (ib : Ibch) (G : Gdexec → Prop)
    (HG : ∀ GD, rvwmoCatConsistent GD → AxirisG.gconstInterp (GF := GF) GD ⊢ ⌜G GD⌝)
    (HGimg : ∀ GD, G GD → GD.gdG.gxImg = AxSpinE8d.img1)
    (Hrow : ∀ GD, G GD → AxOpsem.grow GD i = AxSpinE8d.rowM) (Φ : Athread → IProp GF) :
    ⊢ wpdM rvwmoCatConsistent .MaybeStuck i
      (AxEpiRun.st cpu (.pure ()) AxSpinE8d.rsOff ib 4) Φ :=
  wpdStuck i G HG (WeakAxRealize.fetchPin AxSpinE8d.img1)
    (fun GD l HGD Hp => by rw [← HGimg GD HGD]; exact Hp) Φ _
    (fun GD HGD => by unfold rowStuck; rw [Hrow GD HGD]; exact AxSpinE8d.divStuck cpu ib)

end Weak

