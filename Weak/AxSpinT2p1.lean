  (0, 0x8000c3a8, 8, 0x80012500, 36), (3, 0x80012500, 4, 0x1, 15)]

def rowB1 : List Lbl := encB1.map dec

/-- THE ROWS (harts 0, 1, 2 = A, B, phantom C). -/
def rows1 : List (List Lbl) := [rowA1, rowB1, []]

/-- THE INTERLEAVING: A's 101 memory events, then B's 38. -/
def il1 : List Geid := (List.range 101).map (fun k => (0, k)) ++ (List.range 38).map (fun k => (1, k))

theorem sizes1 : rowA1.length = 101 ∧ rowB1.length = 38 ∧ il1.length = 139 := by decide +kernel

/-- B's parameters: push_off's intena arm, holding's LONG arm (lock held by A), one failed spin. -/
def qB1 : T2Prm := ⟨true, true, 1, false⟩

/-- The row ends: A just after `sw nextpid`, B just after its first (failed) claim attempt. -/
theorem ends1 : rowA1.length = t2KBd q0 + 66 ∧ rowB1.length = t2KSp qB1 + 1 := by decide +kernel

/-! # 4. The graph -/

/-- THE PREFIX-WITNESS GRAPH, for any emission. -/
def gT1 (E : List (List Eitem)) : GdexecT := graphOfSc img rows1 il1 E

/-- The literal carries the SC values and timestamps: the graph's rows ARE the literal. -/
theorem rowsFixed1 : scProg rows1 (sim img rows1 il1).sOut = rows1 := by decide +kernel

theorem growR1 (E : List (List Eitem)) (h : Nat) :
    AxOpsem.grow (gtAdGd (gT1 E)) h = AxSpinT2p1.rowAt rows1 h :=
  AxSpinT2p1.growOf rows1 il1 E h rowsFixed1

theorem growA1 (E : List (List Eitem)) : AxOpsem.grow (gtAdGd (gT1 E)) 0 = rowA1 := growR1 E 0
theorem growB1 (E : List (List Eitem)) : AxOpsem.grow (gtAdGd (gT1 E)) 1 = rowB1 := growR1 E 1
theorem growC1 (E : List (List Eitem)) : AxOpsem.grow (gtAdGd (gT1 E)) 2 = [] := growR1 E 2

theorem shil1 : (shapesOkB rows1 && ilOkB rows1 il1) = true := by decide +kernel

/-- The phantom's (empty) emission check. -/
theorem okC1 : hartOkB rows1 2 [] = true := by decide +kernel

/-! # 5. The stage-2 row premises -/

theorem preLit1 : AxSpinT2p1.preB rowA1 q0 0 (sZ 0) (AxSpinT2a.pEx 0) = true ∧
    AxSpinT2p1.preB rowB1 qB1 1 (sZ 1) (AxSpinT2a.pEx 1) = true := by
  constructor <;> decide +kernel

theorem pinsLit1 : AxSpinT2p1.pins2B rowA1 q0 0 = true ∧ AxSpinT2p1.pins2B rowB1 qB1 1 = true := by
  constructor <;> decide +kernel

theorem clsLit1 : rowClsOkB rowA1 = true ∧ rowClsOkB rowB1 = true := by
  constructor <;> decide +kernel

theorem offLit1 : AxSpinT2p1.offCutsB 101 q0 = true ∧ AxSpinT2p1.offCutsB 38 qB1 = true := by
  constructor <;> decide +kernel

section prem
variable (E : List (List Eitem))

/-- **`allocPre`** for A (a prefix through `sw nextpid`). -/
theorem preA1 : allocPre (AxOpsem.grow (gtAdGd (gT1 E)) 0) q0 0 (sZ 0) (AxSpinT2a.pEx 0) := by
  rw [growA1]; exact AxSpinT2p1.preOfB _ _ _ _ _ preLit1.1

/-- **`allocPre`** for B (a prefix through one failed claim; holding's long arm passed). -/
theorem preB1G : allocPre (AxOpsem.grow (gtAdGd (gT1 E)) 1) qB1 1 (sZ 1) (AxSpinT2a.pEx 1) := by
  rw [growB1]; exact AxSpinT2p1.preOfB _ _ _ _ _ preLit1.2

/-- **`AllocPins2`** for A. -/
theorem pinsA1 : AllocPins2 (gtAdGd (gT1 E)) 0 q0 := by
  apply AxSpinT2p1.pins2OfB; rw [growA1]; exact pinsLit1.1

/-- **`AllocPins2`** for B. -/
theorem pinsB1 : AllocPins2 (gtAdGd (gT1 E)) 1 qB1 := by
  apply AxSpinT2p1.pins2OfB; rw [growB1]; exact pinsLit1.2

/-- **`¬ t2Cut`** for A (its row ends at no designated cut). -/
theorem notCutA1 : ¬ t2Cut (gtAdGd (gT1 E)) 0 (sZ 0) (AxSpinT2a.pEx 0) :=
  notCutOfLen (preA1 E) (by rw [growA1, sizes1.1]; exact (AxSpinT2p1.offCutsOf offLit1.1).1)
    (by rw [growA1, sizes1.1]; exact (AxSpinT2p1.offCutsOf offLit1.1).2)

/-- **`¬ t2Cut`** for B. -/
theorem notCutB1 : ¬ t2Cut (gtAdGd (gT1 E)) 1 (sZ 1) (AxSpinT2a.pEx 1) :=
  notCutOfLen (preB1G E) (by rw [growB1, sizes1.2.1]; exact (AxSpinT2p1.offCutsOf offLit1.2).1)
    (by rw [growB1, sizes1.2.1]; exact (AxSpinT2p1.offCutsOf offLit1.2).2)

/-- **A is INCOMPLETE** (`t2Complete` false). -/
theorem notCompleteA1 : ¬ t2Complete (gtAdGd (gT1 E)) 0 (sZ 0) (AxSpinT2a.pEx 0) :=
  AxSpinT2p1.notComplete (preA1 E) (by rw [growA1, sizes1.1]; decide)
    (by rw [growA1, sizes1.1]; decide)

/-- **B is INCOMPLETE** (`t2Complete` false). -/
theorem notCompleteB1 : ¬ t2Complete (gtAdGd (gT1 E)) 1 (sZ 1) (AxSpinT2a.pEx 1) :=
  AxSpinT2p1.notComplete (preB1G E) (by rw [growB1, sizes1.2.1]; decide)
    (by rw [growB1, sizes1.2.1]; decide)

/-- **`rowClsHonest`** for A and B. -/
theorem honest1 : rowClsHonest (AxOpsem.grow (gtAdGd (gT1 E)) 0) ∧
    rowClsHonest (AxOpsem.grow (gtAdGd (gT1 E)) 1) := by
  rw [growA1, growB1]
  exact ⟨rowClsHonestOfB _ clsLit1.1, rowClsHonestOfB _ clsLit1.2⟩

theorem readsOff1 : (List.range 3).all (fun h => AxSpinT2c5.readsOffB (AxSpinT2p1.rowAt rows1 h)) =
    true := by
  decide +kernel

/-- **`textFixed`** (`HfixA`/`HfixB`) on the prefix graph. -/
theorem textFixed1 (h : Agent) (hh : h < 3) :
    textFixed (gtAdGd (gT1 E)) h (imgS AxSpinT2c5.σX) := by
  refine ⟨fun a b hab => ?_, ?_⟩
  · have H := AxSpinT2c5.imgAgree [] a b hab
    rw [show (gtAdGd (AxSpinT2c1.gT3 [])).gdG.gxImg = fun a => some (img a) from rfl] at H
    rw [show (gtAdGd (gT1 E)).gdG.gxImg = fun a => some (img a) from rfl]
    exact H
  intro k lb aq base n vs hk hr hi
  rw [growR1] at hk
  have H := List.all_eq_true.1 (List.all_eq_true.1 readsOff1 h (List.mem_range.2 hh))
    lb (List.mem_of_getElem? hk)
  rw [hr] at H
  simp only [hi, Option.isNone_some] at H
  cases H

/-- `HimgNoff` on the prefix graph. -/
theorem imgNoff1 : HimgNoff (gtAdGd (gT1 E)).gdG.gxImg 0 1 := AxSpinT2p1.himgNoff 0 1

end prem

/-- The untagged prefix-witness graph. -/
def gR1 : Gexec := ⟨fun a => some (img a), rows1, il1⟩

theorem gtGEq1 (E : List (List Eitem)) : (gT1 E).gtG = gR1 := by
  show (⟨fun a => some (img a), scProg rows1 (sim img rows1 il1).sOut, il1⟩ : Gexec) = gR1
  rw [rowsFixed1]; rfl

theorem clAlLit1 : AxSpinT2p1.clAlB gR1 (clRange (AxSpinT2a.zLk + 16) 8) = true := by
  decide +kernel

/-- **Q-S2-B (option A's graph premise) holds**: every lk->cpu write of the prefix graph (A's
`sd` of its cpu in acquire) is full-width. -/
theorem clAl1 (E : List (List Eitem)) (L : Xlay) (hL : L.xlLk = AxSpinT2a.zLk) :
    clAligned (clb L) (gtAdGd (gT1 E)).gdG := by
  rw [AxSpinT2p1.clbEq L hL]
  show clAligned _ (gT1 E).gtG
  rw [gtGEq1]
  exact AxSpinT2p1.clAlOfB _ _ clAlLit1

end AxSpinT2p1

