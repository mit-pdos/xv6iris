/-! # 1. Sound checkers for the stage-2 row premises (generic, reused by `AxSpinT2p2`) -/

/-- `RowShXP 0` as a Bool (item by item; true once the row runs out). -/
def AxSpinT2p1.shGoP : List Lbl → List Rxitem → Bool
  | _, [] => true
  | [], _ :: _ => true
  | lb :: r, x :: s => xshapeB x lb && AxSpinT2p1.shGoP r s

theorem AxSpinT2p1.shGoPSound :
    ∀ (row : List Lbl) (sh : List Rxitem), AxSpinT2p1.shGoP row sh = true → RowShXP 0 row sh
  | _, [], _ => fun j x hx _ => by simp at hx
  | [], _ :: _, _ => fun j x _ hl => by simp at hl
  | lb :: r, x :: s, h => by
    simp only [AxSpinT2p1.shGoP, Bool.and_eq_true] at h
    intro j y hy hl
    cases j with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hy
      subst hy
      exact ⟨lb, rfl, xshapeOfB _ _ h.1⟩
    | succ j =>
      obtain ⟨lb', h1, h2⟩ := AxSpinT2p1.shGoPSound r s h.2 j y (by simpa using hy)
        (by simp only [List.length_cons] at hl; omega)
      exact ⟨lb', by simpa using h1, h2⟩

/-- `AxSpinT2f.spinValsP` as a Bool. -/
def AxSpinT2p1.spinValsPB (row : List Lbl) (u n : Nat) : Bool :=
  (List.range (n + 1)).all fun j =>
    !decide (u + j < row.length) ||
    match row[u + j]? with
    | some lb => match lblValue lb with
      | some vs => decide (aqFail vs = decide (j < n))
      | none => false
    | none => false

theorem AxSpinT2p1.spinValsPOfB {row : List Lbl} {u n : Nat} :
    AxSpinT2p1.spinValsPB row u n = true → AxSpinT2f.spinValsP row u n := by
  intro h j hj hl
  have h1 := List.all_eq_true.1 h j (List.mem_range.2 (by omega))
  simp only [hl, decide_true, Bool.not_true, Bool.false_or] at h1
  cases hr : row[u + j]? with
  | none => simp [hr] at h1
  | some lb =>
    cases hv : lblValue lb with
    | none => simp [hr, hv] at h1
    | some vs =>
      simp only [hr, hv, decide_eq_true_eq] at h1
      exact ⟨lb, vs, rfl, hv, h1⟩

/-- `AxSpinT2f.spinRmwP` as a Bool (stage 1's `spinRmwB` at each present position). -/
def AxSpinT2p1.spinRmwPB (row : List Lbl) (u n : Nat) (lk : Int) : Bool :=
  (List.range (n + 1)).all fun j => !decide (u + j < row.length) || spinRmwB row (u + j) 0 lk

theorem AxSpinT2p1.spinRmwPOfB {row : List Lbl} {u n : Nat} {lk : Int} :
    AxSpinT2p1.spinRmwPB row u n lk = true → AxSpinT2f.spinRmwP row u n lk := by
  intro h j hj hl
  have h1 := List.all_eq_true.1 h j (List.mem_range.2 (by omega))
  simp only [hl, decide_true, Bool.not_true, Bool.false_or] at h1
  have H := spinRmwOfB h1 0 (Nat.le_refl 0)
  simpa using H

/-- The five gates as Bools (`AxSpinT2f.rv` = the row value). -/
def AxSpinT2p1.gateB : T2Cj → List Lbl → T2Prm → Agent → Bool
  | .aq, row, q, i => !q.hb || optAll (AxSpinT2f.rv row (t2KHd q + 4))
      (fun vs => !decide (ldRes false 8 vs = cpuAddr (cpuOf i)))
  | .rlS, row, q, _ => optAll (AxSpinT2f.rv row (t2KRh q)) (fun vs => !decide (ldRes false 4 vs = 0#64))
  | .rlL, row, q, i => optAll (AxSpinT2f.rv row (t2KRh q + 4))
      (fun vs => decide (ldRes false 8 vs = cpuAddr (cpuOf i)))
  | .ppN, row, q, _ => optAll (AxSpinT2f.rv row (t2KPp q + 6))
      (fun vs => decide (zopz0zKzJ_s zero_reg (ldRes false 4 vs) = false))
  | .ppI, row, q, _ => q.c || optAll (AxSpinT2f.rv row (t2KPp q + 8))
      (fun vs => decide ((ldRes false 4 vs == zero_reg) = true))

theorem AxSpinT2p1.gateOfB (j : T2Cj) (row : List Lbl) (q : T2Prm) (i : Agent) :
    AxSpinT2p1.gateB j row q i = true → t2GateOk j row q i := by
  intro h
  cases j with
  | aq =>
    intro hb vs hv
    simp only [AxSpinT2p1.gateB, hb, Bool.not_true, Bool.false_or] at h
    simpa using optAllOf h vs hv
  | rlS => intro vs hv; simpa using optAllOf h vs hv
  | rlL => intro vs hv; simpa using optAllOf h vs hv
  | ppN => intro vs hv; simpa using optAllOf h vs hv
  | ppI =>
    intro hc vs hv
    simp only [AxSpinT2p1.gateB, hc, Bool.false_or] at h
    simpa using optAllOf h vs hv

/-- The gate conjunct of `allocPre` as a Bool. -/
def AxSpinT2p1.gatesB (row : List Lbl) (q : T2Prm) (i : Agent) : Bool :=
  [T2Cj.aq, .rlS, .rlL, .ppN, .ppI].all fun j =>
    !decide (cutPos j q < row.length) || AxSpinT2p1.gateB j row q i

theorem AxSpinT2p1.gatesOfB {row : List Lbl} {q : T2Prm} {i : Agent} :
    AxSpinT2p1.gatesB row q i = true → ∀ j, cutPos j q < row.length → t2GateOk j row q i := by
  intro h j hj
  have h1 := List.all_eq_true.1 h j (by cases j <;> simp)
  simp only [hj, decide_true, Bool.not_true, Bool.false_or] at h1
  exact AxSpinT2p1.gateOfB j row q i h1

/-- The 18 reloads, as a list. -/
def AxSpinT2p1.allRj : List T2Rj :=
  [.poMy1, .poMy2, .poMy3, .poRet, .poS1, .hdMy, .hdRet, .hdS1, .aqMy, .aqRet, .aqS1, .rhMy,
    .rhRet, .rhS1, .ppMy, .ppRet, .rlRet, .rlS1]

theorem AxSpinT2p1.memRj (x : T2Rj) : x ∈ AxSpinT2p1.allRj := by
  cases x <;> simp [AxSpinT2p1.allRj]

/-- One reload gate as a Bool. -/
def AxSpinT2p1.rlGateB (x : T2Rj) (row : List Lbl) (q : T2Prm) : Bool :=
  !rlOn x q || optAll (AxSpinT2f.rv row (rlKr x q)) (fun vs => decide (rlExp x row q = some vs))

theorem AxSpinT2p1.rlGateOfB (x : T2Rj) (row : List Lbl) (q : T2Prm) :
    AxSpinT2p1.rlGateB x row q = true → rlGateOk x row q := by
  intro h hon vs hv
  simp only [AxSpinT2p1.rlGateB, hon, Bool.not_true, Bool.false_or] at h
  simpa using optAllOf h vs hv

/-- The reload gate conjunct of `allocPre` as a Bool. -/
def AxSpinT2p1.rlGatesB (row : List Lbl) (q : T2Prm) : Bool :=
  AxSpinT2p1.allRj.all fun x => !decide (rlPos x q < row.length) || AxSpinT2p1.rlGateB x row q

theorem AxSpinT2p1.rlGatesOfB {row : List Lbl} {q : T2Prm} :
    AxSpinT2p1.rlGatesB row q = true → ∀ x, rlPos x q < row.length → rlGateOk x row q := by
  intro h x hx
  have h1 := List.all_eq_true.1 h x (AxSpinT2p1.memRj x)
  simp only [hx, decide_true, Bool.not_true, Bool.false_or] at h1
  exact AxSpinT2p1.rlGateOfB x row q h1

/-- push_off's branch bit `AxSpinT2f.poBranch` as a Bool. -/
def AxSpinT2p1.poBranchB (row : List Lbl) (q : T2Prm) : Bool :=
  !decide (t2KPo + 7 < row.length) ||
  match AxSpinT2f.rv row (t2KPo + 7) with
  | some vs => decide ((ldRes false 4 vs == zero_reg) = q.b)
  | none => false

theorem AxSpinT2p1.poBranchOfB {row : List Lbl} {q : T2Prm} :
    AxSpinT2p1.poBranchB row q = true → AxSpinT2f.poBranch row q := by
  intro h hl
  simp only [AxSpinT2p1.poBranchB, hl, decide_true, Bool.not_true, Bool.false_or] at h
  cases hv : AxSpinT2f.rv row (t2KPo + 7) with
  | none => simp [hv] at h
  | some vs =>
    simp only [hv, decide_eq_true_eq] at h
    exact ⟨vs, rfl, h⟩

/-- `allocPre` as a Bool. -/
def AxSpinT2p1.preB (row : List Lbl) (q : T2Prm) (i : Agent) (S p : Int) : Bool :=
  AxSpinT2p1.shGoP row (allocSeg q i S p) && (decide (row.length ≤ t2Len q) &&
  ((!decide (t2KHd q < row.length) || lkB row (t2KHd q) q.hb) &&
  (AxSpinT2p1.spinValsPB row (t2KSp q) q.n && (bodyB row (t2KBd q) AxSpinT2a.zNp &&
  (AxSpinT2p1.spinRmwPB row (t2KSp q) q.n AxSpinT2a.zLk && (cpuValsB row i &&
  (relValsB row q && (AxSpinT2p1.gatesB row q i &&
  (AxSpinT2p1.poBranchB row q && AxSpinT2p1.rlGatesB row q)))))))))

/-- **Soundness of `preB`.** -/
theorem AxSpinT2p1.preOfB (row : List Lbl) (q : T2Prm) (i : Agent) (S p : Int) :
    AxSpinT2p1.preB row q i S p = true → allocPre row q i S p := by
  intro h
  simp only [AxSpinT2p1.preB, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := h
  refine ⟨AxSpinT2p1.shGoPSound _ _ h1, h2, fun hl => ?_, AxSpinT2p1.spinValsPOfB h4,
    bodyOfB h5, AxSpinT2p1.spinRmwPOfB h6, cpuValsOfB h7, relValsOfB h8, AxSpinT2p1.gatesOfB h9,
    AxSpinT2p1.poBranchOfB h10, AxSpinT2p1.rlGatesOfB h11⟩
  simp only [hl, decide_true, Bool.not_true, Bool.false_or] at h3
  exact lkOfB h3

/-- A position-guarded value pin as a Bool. -/
def AxSpinT2p1.gv1 (row : List Lbl) (k : Nat) (x : Option (List (BitVec 8))) : Bool :=
  !decide (k < row.length) || decide (valAt row k = x)

theorem AxSpinT2p1.gv1Of {row : List Lbl} {k : Nat} {x : Option (List (BitVec 8))} :
    AxSpinT2p1.gv1 row k x = true → k < row.length → valAt row k = x := by
  intro h hk
  simp only [AxSpinT2p1.gv1, hk, decide_true, Bool.not_true, Bool.false_or,
    decide_eq_true_eq] at h
  exact h

/-- `AllocPins2` as a Bool, on the row (Q18b, `ppArm`, and the interim `rlEnd`). -/
def AxSpinT2p1.pins2B (row : List Lbl) (q : T2Prm) (_i : Agent) : Bool :=
  optAll (valAt row (t2KBd q)) (fun vs => !decide ((wordOfBytes 4 vs : BitVec 32) = 1000#32) &&
    decide ((wordOfBytes 4 vs : BitVec 32).toNat + 1 < 2 ^ 32)) &&
  optAll (valAt row (t2KBd q)) (fun vs => (List.range 64).all fun j =>
    optAll (valAt row (t2KBd q + 1 + j))
      (fun v => !decide ((wordOfBytes 4 v : BitVec 32) = wordOfBytes 4 vs))) &&
  optAll (valAt row (t2KPp q + 6)) (fun vn => decide ((addiwm1 (ldRes false 4 vn) != zero_reg) = q.c)) &&
  AxSpinT2p1.allRj.all fun x => !decide (row.length = rlPos x q) || AxSpinT2p1.rlGateB x row q

/-- **Soundness of `pins2B`.** -/
theorem AxSpinT2p1.pins2OfB (GD : Gdexec) (i : Agent) (q : T2Prm) :
    AxSpinT2p1.pins2B (AxOpsem.grow GD i) q i = true → AllocPins2 GD i q := by
  intro h
  simp only [AxSpinT2p1.pins2B, Bool.and_eq_true, and_assoc] at h
  obtain ⟨h9, h10, h13, h20⟩ := h
  have gv := gvRow GD i
  refine
    { npNowrap := fun vs hv => by
        have := optAllOf h9 vs (by rw [← gv]; exact hv)
        simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
          decide_eq_true_eq] at this
        exact this
      npNcoll := fun vs hv j hj v hv' => by
        have h1' := optAllOf h10 vs (by rw [← gv]; exact hv)
        have h2' := optAllOf (List.all_eq_true.1 h1' j (List.mem_range.2 hj)) v
          (by rw [← gv]; exact hv')
        simpa using h2'
      ppArm := fun vn hv => of_decide_eq_true (optAllOf h13 vn (by rw [← gv]; exact hv))
      rlEnd := fun x hx => by
        have h1 := List.all_eq_true.1 h20 x (AxSpinT2p1.memRj x)
        simp only [hx, decide_true, Bool.not_true, Bool.false_or] at h1
        exact AxSpinT2p1.rlGateOfB x _ q h1 }

/-- A family row that stops before release (`< t2KSp q + 108`) and passes holding's lock read
is NOT complete (for ANY parameters: push_off's arm and holding's lock bit are fixed by the row,
`AxSpinT2f.bDet`/`hbDet`, and every complete row is at least `t2KSp + 108` long). -/
theorem AxSpinT2p1.notComplete {GD : Gdexec} {i : Agent} {q : T2Prm} {S p : Int}
    (H : allocPre (AxOpsem.grow GD i) q i S p) (h1 : t2KHd q < (AxOpsem.grow GD i).length)
    (h2 : (AxOpsem.grow GD i).length < t2KSp q + 108) : ¬ t2Complete GD i S p := by
  rintro ⟨q', HF⟩
  have C := AxSpinT2f.coreOfPre H
  have C' := AxSpinT2f.coreOfFull HF
  have K := AxSpinT2f.kEqs q
  have hb := AxSpinT2f.bDet C C' (by omega)
  obtain ⟨b, hb0, n, c⟩ := q
  obtain ⟨b', hb', n', c'⟩ := q'
  simp only at hb
  subst hb
  have hh := AxSpinT2f.hbDet C C' h1
  subst hh
  have L := HF.2.1
  obtain ⟨-, -, k3, -, -, k6, -, -, k9⟩ := AxSpinT2f.kEqs ⟨b, hb0, n', c'⟩
  have e : t2KSp ⟨b, hb0, n', c'⟩ = t2KSp ⟨b, hb0, n, c⟩ := rfl
  omega

/-- The empty row is not complete. -/
theorem AxSpinT2p1.notCompleteNil {GD : Gdexec} {i : Agent} {S p : Int}
    (h : AxOpsem.grow GD i = []) : ¬ t2Complete GD i S p := by
  rintro ⟨q, HF⟩
  have L := HF.2.1
  rw [h] at L
  have := AxSpinT2f.cutPosLen .aq q
  simp only [List.length_nil] at L
  omega

/-- A row ending at no cut position (as a Bool over the five panic / `intr_on` cuts and the 18
reload cuts). -/
def AxSpinT2p1.offCutsB (len : Nat) (q : T2Prm) : Bool :=
  [T2Cj.aq, .rlS, .rlL, .ppN, .ppI].all (fun j => !decide (len = cutPos j q)) &&
  AxSpinT2p1.allRj.all fun x => !decide (len = rlPos x q)

theorem AxSpinT2p1.offCutsOf {len : Nat} {q : T2Prm} :
    AxSpinT2p1.offCutsB len q = true → (∀ j, len ≠ cutPos j q) ∧ ∀ x, len ≠ rlPos x q := by
  intro h
  simp only [AxSpinT2p1.offCutsB, Bool.and_eq_true] at h
  refine ⟨fun j hj => ?_, fun x hx => ?_⟩
  · have h1 := List.all_eq_true.1 h.1 j (by cases j <;> simp)
    simp [hj] at h1
  · have h1 := List.all_eq_true.1 h.2 x (AxSpinT2p1.memRj x)
    simp [hx] at h1

/-! # 2. Generic graph / run machinery over a literal schedule -/

section gen
variable (rows : List (List Lbl)) (il : List Geid)

/-- Hart `h`'s literal row. -/
def AxSpinT2p1.rowAt (h : Nat) : List Lbl := (rows[h]?).getD []

theorem AxSpinT2p1.growOf (E : List (List Eitem)) (h : Nat)
    (Hf : scProg rows (sim img rows il).sOut = rows) :
    AxOpsem.grow (gtAdGd (graphOfSc img rows il E)) h = AxSpinT2p1.rowAt rows h := by
  show ((scProg rows (sim img rows il).sOut)[h]?).getD [] = _
  rw [Hf]; rfl

theorem AxSpinT2p1.emsCtrlOf (a b c : List Eitem) (ha : hartOkB rows 0 a = true)
    (hb : hartOkB rows 1 b = true) (hc : hartOkB rows 2 c = true) :
    emsOkB rows [a, b, c] = true ∧ ctrlOkB rows [a, b, c] = true := by
  simp only [hartOkB, Bool.and_eq_true] at ha hb hc
  simp only [emsOkB, ctrlOkB, List.mapIdx_cons, List.mapIdx_nil, List.all_cons, List.all_nil,
    Bool.and_true, Bool.and_eq_true]
  exact ⟨⟨ha.1, hb.1, hc.1⟩, ⟨ha.2, hb.2, hc.2⟩⟩

/-- Consistency of a literal 3-hart graph, by the GENERIC SC lemma. -/
theorem AxSpinT2p1.catOf (a b c : List Eitem) (Hs : (shapesOkB rows && ilOkB rows il) = true)
    (ha : hartOkB rows 0 a = true) (hb : hartOkB rows 1 b = true)
    (hc : hartOkB rows 2 c = true) :
    rvwmoCatConsistentT (graphOfSc img rows il [a, b, c]) := by
  refine graphOfScCatT _ _ _ _ ?_
  unfold scInputsOkB
  rw [Hs, (AxSpinT2p1.emsCtrlOf rows a b c ha hb hc).1]

/-- Ctrl closure of a literal 3-hart graph, by the generic lemma. -/
theorem AxSpinT2p1.ctrlOf (a b c : List Eitem) (ha : hartOkB rows 0 a = true)
    (hb : hartOkB rows 1 b = true) (hc : hartOkB rows 2 c = true) :
    ctrlClosed (graphOfSc img rows il [a, b, c]) :=
  graphOfScCtrlClosed _ _ _ _ (AxSpinT2p1.emsCtrlOf rows a b c ha hb hc).2

end gen

/-- The drive of a row from an entry register file, then to the end of the last memory event's
instruction (`finish2`). -/
noncomputable def AxSpinT2p1.drvG (row : List Lbl) (rs0 : RegFile) :
    Option (SailM Unit × RegFile × Ibch × Nat × List Eitem) :=
  match drive2 (fun a => some (img a)) row row.length fuel (.pure ()) rs0 ibNone 0 with
  | some (m, rs, ib, k, es) =>
    (finish2 (fun a => some (img a)) row 1000 m rs ib k).map fun r =>
      (r.1, r.2.1, r.2.2.1, r.2.2.2, es)
  | none => none

/-- The per-hart check on a drive result: `hartOkB`, row end, instruction boundary. -/
def AxSpinT2p1.chkG (rows : List (List Lbl)) (h : Nat) (row : List Lbl)
    (o : Option (SailM Unit × RegFile × Ibch × Nat × List Eitem)) : Bool :=
  match o with
  | some r => hartOkB rows h r.2.2.2.2 && (pureB r.1 && decide (r.2.2.2.1 = row.length))
  | none => false

/-- The run statement of hart `h` on a literal schedule (to an instruction boundary). -/
def AxSpinT2p1.RunOk (rows : List (List Lbl)) (il : List Geid) (h : Nat) (rs0 : RegFile)
    (es : List Eitem) : Prop :=
  ∃ (u : Unit) (rs : RegFile) (ib : Ibch), hartOkB rows h es = true ∧
    ∀ E, ∃ n, ∀ (cpu : CPU) (N : Type) (nm : N),
      nsteps (tierAAstep (gtAdGd (graphOfSc img rows il E)) nm h) n
        (AxEpiRun.st cpu (.pure ()) rs0 ibNone 0)
        (AxEpiRun.st cpu (.pure u) rs ib
          (AxOpsem.grow (gtAdGd (graphOfSc img rows il E)) h).length)

/-- **READ-BACK of a per-hart drive check** (stated for a VARIABLE drive result `o`, so no proof
using it re-evaluates the drive). -/
theorem AxSpinT2p1.runOfChkG (rows : List (List Lbl)) (il : List Geid) (h : Nat)
    (row : List Lbl) (rs0 : RegFile) (o : Option (SailM Unit × RegFile × Ibch × Nat × List Eitem))
    (Hrow : ∀ E, AxOpsem.grow (gtAdGd (graphOfSc img rows il E)) h = row)
    (Hd : AxSpinT2p1.drvG row rs0 = o) (Hc : AxSpinT2p1.chkG rows h row o = true) :
    AxSpinT2p1.RunOk rows il h rs0 (emsOf o) := by
  unfold AxSpinT2p1.drvG at Hd
  cases Hd1 : drive2 (fun a => some (img a)) row row.length fuel (.pure ()) rs0 ibNone 0 with
  | none => simp only [Hd1] at Hd; subst Hd; cases Hc
  | some r =>
    obtain ⟨m1, rs1, ib1, k1, es⟩ := r
    simp only [Hd1] at Hd
    cases Hf : finish2 (fun a => some (img a)) row 1000 m1 rs1 ib1 k1 with
    | none => simp only [Hf, Option.map_none] at Hd; subst Hd; cases Hc
    | some r2 =>
      obtain ⟨m2, rs2, ib2, k2⟩ := r2
      simp only [Hf, Option.map_some] at Hd
      subst Hd
      simp only [AxSpinT2p1.chkG, Bool.and_eq_true, decide_eq_true_eq] at Hc
      obtain ⟨Hok, Hpure, Hk2⟩ := Hc
      cases m2 with
      | impure c kk => cases Hpure
      | pure u =>
        refine ⟨u, rs2, ib2, Hok, fun E => ?_⟩
        have Hd' : drive2 (gtAdGd (graphOfSc img rows il E)).gdG.gxImg
            (AxOpsem.grow (gtAdGd (graphOfSc img rows il E)) h) row.length fuel (.pure ()) rs0
            ibNone 0 = some (m1, rs1, ib1, k1, es) := by
          rw [Hrow]; exact Hd1
        have Hf' : finish2 (gtAdGd (graphOfSc img rows il E)).gdG.gxImg
            (AxOpsem.grow (gtAdGd (graphOfSc img rows il E)) h) 1000 m1 rs1 ib1 k1 =
            some (.pure u, rs2, ib2, k2) := by
          rw [Hrow]; exact Hf
        obtain ⟨-, n1, Hr1⟩ := drive2Sound _ h _ fuel _ _ _ _ _ _ _ _ _ Hd'
        obtain ⟨-, n2, Hr2⟩ := finish2Sound _ h 1000 _ _ _ _ _ _ _ _ Hf'
        refine ⟨n1 + n2, fun cpu N nm => ?_⟩
        rw [Hrow, ← Hk2]
        exact nsteps_trans (Hr1 cpu) (Hr2 cpu)

/-- An EMPTY row's run: zero steps from the entry state (a phantom hart). -/
theorem AxSpinT2p1.runNil (rows : List (List Lbl)) (il : List Geid) (h : Nat) (rs0 : RegFile)
    (Hrow : ∀ E, AxOpsem.grow (gtAdGd (graphOfSc img rows il E)) h = [])
    (Hok : hartOkB rows h [] = true) : AxSpinT2p1.RunOk rows il h rs0 [] :=
  ⟨(), rs0, ibNone, Hok, fun E => ⟨0, fun cpu N nm => by rw [Hrow]; exact nsteps_O _⟩⟩


/-! ## lk->cpu write alignment (Q-S2-B) as Bools -/

/-- `clAligned Cl G` (AxSpinProt5: every write touching a `Cl` byte touches all of `Cl`) as a
Bool over the graph's events. -/
def AxSpinT2p1.clAlB (G : Gexec) (Cl : List Int) : Bool :=
  (gevents G).all fun w => (gwrBytes G w).all fun x => !decide (x.1 ∈ Cl) || Cl.all (gwaB G w)

theorem AxSpinT2p1.clAlOfB (G : Gexec) (Cl : List Int) :
    AxSpinT2p1.clAlB G Cl = true → clAligned Cl G := by
  intro h w a v ha hw a' ha'
  have h1 := List.all_eq_true.1 h w (gwritesByteGevents G w a v hw)
  have h2 := List.all_eq_true.1 h1 (a, v) ((gwritesByteBytes G w a v).1 hw)
  simp only [ha, decide_true, Bool.not_true, Bool.false_or] at h2
  exact (gwaBSpec G w a').1 (List.all_eq_true.1 h2 a' ha')

/-- `AxSpinT2g.clSrcAligned Cl G r` (every write `r` takes a `Cl` byte from touches all of `Cl`)
as a Bool over `r`'s read bytes. -/
def AxSpinT2p1.srcAlB (G : Gexec) (Cl : List Int) (r : Geid) : Bool :=
  (grdBytes G r).all fun x => !decide (x.1.1 ∈ Cl) ||
    match gwriteAt G x.1.2 with
    | some w => Cl.all (gwaB G w)
    | none => true

theorem AxSpinT2p1.srcAlOfB (G : Gexec) (Cl : List Int) (r : Geid) :
    AxSpinT2p1.srcAlB G Cl r = true → AxSpinT2g.clSrcAligned Cl G r := by
  intro h a t v w ha hr hat a' ha'
  have h1 := List.all_eq_true.1 h ((a, t), v) ((greadsByteBytes G r a t v).1 hr)
  simp only [ha, decide_true, Bool.not_true, Bool.false_or, hat] at h1
  exact (gwaBSpec G w a').1 (List.all_eq_true.1 h1 a' ha')

/-- `clb L` of a layout at xv6's `pid_lock`. -/
theorem AxSpinT2p1.clbEq (L : Xlay) (hL : L.xlLk = AxSpinT2a.zLk) :
    clb L = clRange (AxSpinT2a.zLk + 16) 8 := by
  unfold clb; rw [hL]

/-! ## The graph image -/

/-- `cpus[h].noff` is 0 in the graph image (`noffImgOk` at `v = 0`), for every hart. -/
theorem AxSpinT2p1.imgNoff (h : Agent) : noffImgOk (fun a => some (img a)) h 0 := by
  refine ⟨by decide, by decide, ?_⟩
  intro j b hj
  have hz : WeakInterpProj.wbytes 4 (BitVec.ofInt 32 0) = [0#8, 0#8, 0#8, 0#8] := by
    decide +kernel
  rw [hz] at hj
  have hb0 : b = 0#8 := by
    have := List.mem_of_getElem? hj
    simpa using this
  have hj4 : j < 4 := by
    have := (List.getElem?_eq_some_iff.1 hj).1
    simpa using this
  have H : ∀ m : Nat, m < 8 → ∀ j : Nat, j < 4 →
      img ((KernelSyms.«cpus» : Int) + 128 * (m : Int) + 120 + (j : Int)) = 0#8 := by
    decide +kernel
  unfold cpuZ
  rw [hb0]
  exact congrArg some (H _ (show (cpuOf h).val < 8 from (cpuOf h).isLt) j hj4)

/-- `HimgNoff` for any two harts, on the graph image. -/
theorem AxSpinT2p1.himgNoff (A B : Agent) : HimgNoff (fun a => some (img a)) A B :=
  fun i _ => ⟨0, AxSpinT2p1.imgNoff i⟩

namespace AxSpinT2p1

/-! # 3. The literal -/

/-- A's row: the first 101 items of (a′)'s (through the `sw nextpid` at `t2KBd q0 + 65`). -/
def rowA1 : List Lbl := (encA.take 101).map dec

/-- B's row (encoded; `AxSpinT2c1.dec`): through its first, FAILED, `amoswap.w.aq`. -/
def encB1 : List (Nat × Int × Nat × Nat × Nat) := [
