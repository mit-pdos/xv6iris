/-! ### EXHAUSTIVENESS: every load position of the flat text walk is in the table above, so
no load site escaped the census. -/

def pinPcs : List Int := pins.map Prod.fst

def pinsCoverb : Bool :=
  textPcs.all (fun pc => if roleIsLoad (krole pc) then pinPcs.any (fun q => pc == q) else true)

/-- The load positions of the flat text walk, in walk order (added: the proof route of
`pinsCover`, deviation 3). -/
def loadPcs : List Int := textPcs.filter (fun pc => roleIsLoad (krole pc))

/-- The table lists exactly the load positions, in walk order: one linear `decide +kernel`
comparison, where the Rocq sweep searches the table at every position. -/
theorem loadPcsEq : loadPcs = pinPcs := by decide +kernel

theorem pinsCover : pinsCoverb = true := by
  unfold pinsCoverb
  rw [List.all_eq_true]
  intro pc hpc
  split
  · next h =>
    rw [List.any_eq_true]
    exact ⟨pc, loadPcsEq ▸ List.mem_filter.2 ⟨hpc, h⟩, beq_self_eq_true pc⟩
  · rfl

end Weak
