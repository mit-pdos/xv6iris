  bug-reports: "https://github.com/ocaml/dune/issues"
  depends: [
    "dune" {>= "3.23"}
    "ocaml" {>= "4.08"}
    "odoc" {with-doc}
  ]
  build: [
    ["dune" "subst"] {dev}
    ["dune" "build" "-p" name "-j" jobs "@install" "@doc" {with-doc}]
  ]
