  | .CTZ (rs1, rd) => (execute_CTZ rs1 rd)
  | .CTZW (rs1, rd) => (execute_CTZW rs1 rd)
  | .CLMUL (rs2, rs1, rd) => (execute_CLMUL rs2 rs1 rd)
