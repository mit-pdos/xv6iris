  let data ← do (pure (Sail.BitVec.extractLsb (← (rX_bits rs2)) ((width *i 8) -i 1) 0))
  match (← (vmem_write rs1 (zeros (n := 64)) width data (StoreConditional (aq, rl, Data))
      (aq && rl) rl true)) with
  | .Ok b =>
    (do
      (wX_bits rd (zero_extend (m := 64) (bool_bit_forwards (! b))))
      (cancel_reservation ())
      (pure RETIRE_SUCCESS))
  | .Err e => (pure e)

