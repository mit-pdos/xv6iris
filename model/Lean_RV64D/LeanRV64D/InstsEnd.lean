  | .C_MUL (rsdc, rsc2) => (pure (execute_C_MUL rsdc rsc2))
  | .HLVTYPE (width, op, is_unsigned, rs1, rd) => (execute_HLVTYPE width op is_unsigned rs1 rd)
  | .HSV (width, rs1, rs2) => (execute_HSV width rs1 rs2)
  | .HFENCE_VVMA (rs1, rs2) => (execute_HFENCE_VVMA rs1 rs2)
