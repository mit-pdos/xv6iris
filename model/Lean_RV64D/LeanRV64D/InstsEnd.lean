/-- Type quantifiers: width : Nat, k_ex1174124_ : Bool, k_ex1174123_ : Bool, List.elem width
  [1, 2, 4, 8, 16] -/
def execute_AMO (op : amoop) (aq : Bool) (rl : Bool) (rs2 : regidx) (rs1 : regidx) (width : Nat) (rd : regidx) : SailM ExecutionResult := SailME.run do
  let width := width
  sail_assert (width ≤b (xlen_bytes *i 2)) "extensions/A/zaamo_insts.sail:73.32-73.33"
  let access := (Atomic (op, aq, rl, Data, Data))
  let access_info ← do (default_access_info access)
  let eff_priv := access_info.eff_privilege
  let vaddr ← (( do
    match (← (get_transformed_data_addr rs1 (zeros (n := 64)) access access_info width)) with
    | .Ext_DataAddr_Error e => SailME.throw ((Ext_DataAddr_Check_Failure e) : ExecutionResult)
    | .Ext_DataAddr_OK vaddr => (pure vaddr) ) : SailME ExecutionResult virtaddr )
  match (← (match_memory_trigger_before (← readReg cur_privilege)
      (TriggerAddress (TriggerAddress_AMO, (bits_of_virtaddr vaddr), width)))) with
  | .some pti => SailME.throw ((PendingTrigger pti) : ExecutionResult)
  | none => (pure ())
  if ((not (is_aligned_vaddr vaddr width)) : Bool)
  then
    (do
      match (plat_misaligned_exception access false) with
      | .some .AccessFault =>
        SailME.throw (← do
            (memory_exception (E_SAMO_Access_Fault ()) (bits_of_virtaddr vaddr) access_info))
      | .some .AlignmentException =>
        SailME.throw (← do
            (memory_exception (E_SAMO_Addr_Align ()) (bits_of_virtaddr vaddr) access_info))
      | none => (pure ()))
  else (pure ())
  let (addr, pbmt) ← (( do
    match (← (translateAddr vaddr access eff_priv)) with
    | .Err (e, _) =>
      SailME.throw (← do
          (trap e))
    | .Ok (addr, pbmt, _) => (pure (addr, pbmt)) ) : SailME ExecutionResult
    (physaddr × page_based_mem_type) )
  let loaded ← (( do
    match (← (mem_write_ea addr width eff_priv access pbmt (aq && rl) rl true)) with
    | .Err (exc_addr, e) =>
      SailME.throw (← do
          sail_assert (exc_addr == addr) "extensions/A/zaamo_insts.sail:115.29-115.30"
          let exc_vaddr ← do (exception_vaddr access_info vaddr addr exc_addr)
          (memory_exception e exc_vaddr access_info))
    | .Ok _ =>
      (do
        match (← (mem_read access pbmt eff_priv addr width aq (aq && rl) true)) with
        | .Err (exc_addr, e) =>
          SailME.throw (← do
              sail_assert (exc_addr == addr) "extensions/A/zaamo_insts.sail:122.31-122.32"
              let exc_vaddr ← do (exception_vaddr access_info vaddr addr exc_addr)
              (memory_exception e exc_vaddr access_info))
        | .Ok loaded => (pure loaded)) ) : SailME ExecutionResult (BitVec (8 * width)) )
  let rs2_val ← (( do
    if ((width ≤b xlen_bytes) : Bool)
    then (pure (trunc (m := (8 *i width)) (← (rX_bits rs2))))
    else (pure (trunc (m := (8 *i width)) (← (rX_pair_bits rs2)))) ) : SailME ExecutionResult
    (BitVec (8 * width)) )
  let stored : (BitVec (8 * width)) :=
    match op with
    | .AMOSWAP => rs2_val
    | .AMOADD => (rs2_val + loaded)
    | .AMOXOR => (rs2_val ^^^ loaded)
    | .AMOAND => (rs2_val &&& loaded)
    | .AMOOR => (rs2_val ||| loaded)
    | .AMOMIN =>
      (if ((zopz0zI_s rs2_val loaded) : Bool)
      then rs2_val
      else loaded)
    | .AMOMAX =>
      (if ((zopz0zK_s rs2_val loaded) : Bool)
      then rs2_val
      else loaded)
    | .AMOMINU =>
      (if ((zopz0zI_u rs2_val loaded) : Bool)
      then rs2_val
      else loaded)
    | .AMOMAXU =>
      (if ((zopz0zK_u rs2_val loaded) : Bool)
      then rs2_val
      else loaded)
    | .AMOCAS => rs2_val
  let res ← do
    if ((← do
         if ((op == AMOCAS) : Bool)
         then
           (pure (loaded != (← do
                 if ((width ≤b xlen_bytes) : Bool)
                 then (pure (trunc (m := (8 *i width)) (← (rX_bits rd))))
                 else (pure (trunc (m := (8 *i width)) (← (rX_pair_bits rd)))))))
         else (pure false)) : Bool)
    then
      (do
        if ((width ≤b xlen_bytes) : Bool)
        then (wX_bits rd (sign_extend (m := 64) loaded))
        else (wX_pair_bits rd (sign_extend (m := (64 *i 2)) loaded))
        (pure RETIRE_SUCCESS))
    else
      (do
        match (← (mem_write_value addr width (sign_extend (m := (8 *i width)) stored) eff_priv
            access pbmt (aq && rl) rl true)) with
        | .Ok true =>
          (do
            if ((width ≤b xlen_bytes) : Bool)
            then (wX_bits rd (sign_extend (m := 64) loaded))
            else (wX_pair_bits rd (sign_extend (m := (64 *i 2)) loaded))
            (pure RETIRE_SUCCESS))
        | .Ok false =>
          (internal_error "extensions/A/zaamo_insts.sail" 166 "AMO got false from mem_write_value")
        | .Err (exc_addr, e) =>
          (do
            sail_assert (exc_addr == addr) "extensions/A/zaamo_insts.sail:169.29-169.30"
            let exc_vaddr ← do (exception_vaddr access_info vaddr addr exc_addr)
            (memory_exception e exc_vaddr access_info)))
  match res with
  | .Retire_Success () =>
    (match_memory_trigger_after (← readReg cur_privilege)
      (TriggerAMOData
        ((bits_of_virtaddr vaddr), (zero_extend (m := (8 *i 16)) loaded), (zero_extend
          (m := (8 *i 16)) stored), width)))
  | _ => (pure ())
  (pure res)

def execute_ADDIW (imm : (BitVec 12)) (rs1 : regidx) (rd : regidx) : SailM ExecutionResult := do
  let result ← do (pure ((← (rX_bits rs1)) + (sign_extend (m := 64) imm)))
  (wX_bits rd (sign_extend (m := 64) (Sail.BitVec.extractLsb result 31 0)))
  (pure RETIRE_SUCCESS)

def execute (merge_var : instruction) : SailM ExecutionResult := do
  match merge_var with
  | .ZICBOP (cbop, rs1, offset) => (execute_ZICBOP cbop rs1 offset)
  | .NTL g__28 => (pure (execute_NTL g__28))
  | .C_NTL g__29 => (pure (execute_C_NTL g__29))
  | .PAUSE arg0 => (pure (execute_PAUSE arg0))
  | .LPAD lpl => (execute_LPAD lpl)
  | .UTYPE (imm, rd, op) => (execute_UTYPE imm rd op)
  | .JAL (imm, rd) => (execute_JAL imm rd)
  | .BTYPE (imm, rs2, rs1, op) => (execute_BTYPE imm rs2 rs1 op)
  | .ITYPE (imm, rs1, rd, op) => (execute_ITYPE imm rs1 rd op)
  | .SHIFTIOP (shamt, rs1, rd, op) => (execute_SHIFTIOP shamt rs1 rd op)
  | .RTYPE (rs2, rs1, rd, op) => (execute_RTYPE rs2 rs1 rd op)
  | .LOAD (imm, rs1, rd, is_unsigned, width) => (execute_LOAD imm rs1 rd is_unsigned width)
  | .STORE (imm, rs2, rs1, width) => (execute_STORE imm rs2 rs1 width)
  | .ADDIW (imm, rs1, rd) => (execute_ADDIW imm rs1 rd)
  | .RTYPEW (rs2, rs1, rd, op) => (execute_RTYPEW rs2 rs1 rd op)
  | .SHIFTIWOP (shamt, rs1, rd, op) => (execute_SHIFTIWOP shamt rs1 rd op)
  | .FENCE_TSO arg0 => (execute_FENCE_TSO arg0)
  | .FENCE (_fm, pred, succ, _rs, _rd) => (execute_FENCE _fm pred succ _rs _rd)
  | .ECALL arg0 => (execute_ECALL arg0)
  | .MRET arg0 => (execute_MRET arg0)
  | .SRET arg0 => (execute_SRET arg0)
  | .EBREAK arg0 => (execute_EBREAK arg0)
  | .WFI arg0 => (execute_WFI arg0)
  | .SFENCE_VMA (rs1, rs2) => (execute_SFENCE_VMA rs1 rs2)
  | .JALR (imm, rs1, rd) => (execute_JALR imm rs1 rd)
  | .AMO (op, aq, rl, rs2, rs1, width, rd) => (execute_AMO op aq rl rs2 rs1 width rd)
  | .LOADRES (aq, rl, rs1, width, rd) => (execute_LOADRES aq rl rs1 width rd)
  | .STORECON (aq, rl, rs2, rs1, width, rd) => (execute_STORECON aq rl rs2 rs1 width rd)
  | .MUL (rs2, rs1, rd, mul_op) => (execute_MUL rs2 rs1 rd mul_op)
  | .DIV (rs2, rs1, rd, is_unsigned) => (execute_DIV rs2 rs1 rd is_unsigned)
  | .REM (rs2, rs1, rd, is_unsigned) => (execute_REM rs2 rs1 rd is_unsigned)
  | .MULW (rs2, rs1, rd) => (execute_MULW rs2 rs1 rd)
  | .DIVW (rs2, rs1, rd, is_unsigned) => (execute_DIVW rs2 rs1 rd is_unsigned)
  | .REMW (rs2, rs1, rd, is_unsigned) => (execute_REMW rs2 rs1 rd is_unsigned)
  | .SLLIUW (shamt, rs1, rd) => (execute_SLLIUW shamt rs1 rd)
  | .ZBA_RTYPEUW (rs2, rs1, rd, shamt) => (execute_ZBA_RTYPEUW rs2 rs1 rd shamt)
  | .ZBA_RTYPE (rs2, rs1, rd, shamt) => (execute_ZBA_RTYPE rs2 rs1 rd shamt)
  | .RORIW (shamt, rs1, rd) => (execute_RORIW shamt rs1 rd)
  | .RORI (shamt, rs1, rd) => (execute_RORI shamt rs1 rd)
  | .ZBB_RTYPEW (rs2, rs1, rd, op) => (execute_ZBB_RTYPEW rs2 rs1 rd op)
  | .ZBB_RTYPE (rs2, rs1, rd, op) => (execute_ZBB_RTYPE rs2 rs1 rd op)
  | .ZBB_EXTOP (rs1, rd, op) => (execute_ZBB_EXTOP rs1 rd op)
  | .REV8 (rs1, rd) => (execute_REV8 rs1 rd)
  | .ORCB (rs1, rd) => (execute_ORCB rs1 rd)
  | .CPOP (rs1, rd) => (execute_CPOP rs1 rd)
  | .CPOPW (rs1, rd) => (execute_CPOPW rs1 rd)
  | .CLZ (rs1, rd) => (execute_CLZ rs1 rd)
