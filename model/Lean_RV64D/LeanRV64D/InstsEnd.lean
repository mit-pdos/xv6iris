/-- Type quantifiers: width : Nat, k_ex673559_ : Bool, k_ex673558_ : Bool, width ∈ {1, 2, 4, 8} -/
def execute_SSAMOSWAP (aq : Bool) (rl : Bool) (rs2 : regidx) (rs1 : regidx) (width : Nat) (rd : regidx) : SailM ExecutionResult := SailME.run do
  match (← readReg cur_privilege) with
  | .Machine =>
    (do
      if ((not (← (currentlyEnabled Ext_S))) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else (pure ()))
  | .Supervisor =>
    (do
      if (((_get_MEnvcfg_SSE (← readReg menvcfg)) == 0#1) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else (pure ()))
  | .User =>
    (do
      if (((not (← (currentlyEnabled Ext_S))) || ((_get_SEnvcfg_SSE (← (read_senvcfg ()))) == 0#1)) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else (pure ()))
  | .VirtualSupervisor =>
    (internal_error "extensions/cfi/zicfiss_insts.sail" 164 "Hypervisor extension not supported")
  | .VirtualUser =>
    (do
      if (((_get_MEnvcfg_SSE (← readReg menvcfg)) == 0#1) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else
        (do
          if (((_get_SEnvcfg_SSE (← (read_senvcfg ()))) == 0#1) : Bool)
          then SailME.throw ((Virtual_Instruction ()) : ExecutionResult)
          else (pure ())))
  let access := (Atomic (AMOSWAP, aq, rl, ShadowStack, ShadowStack))
  let vaddr ← (( do
    match (← (get_transformed_data_addr rs1 (zeros (n := 64)) access width)) with
    | .Ext_DataAddr_Error e => SailME.throw ((Ext_DataAddr_Check_Failure e) : ExecutionResult)
    | .Ext_DataAddr_OK vaddr => (pure vaddr) ) : SailME ExecutionResult virtaddr )
  if ((not (is_aligned_vaddr vaddr width)) : Bool)
  then
    (do
      match (plat_misaligned_exception access false) with
      | .some .AccessFault =>
        SailME.throw (← do
            (memory_exception vaddr (E_SAMO_Access_Fault ())))
      | .some .AlignmentException =>
        SailME.throw (← do
            (memory_exception vaddr (E_SAMO_Addr_Align ())))
      | none => (pure ()))
  else (pure ())
  let (paddr, pbmt) ← (( do
    match (← (translateAddr vaddr access)) with
    | .Ok (addr, pbmt, _) => (pure (addr, pbmt))
    | .Err (e, _) =>
      SailME.throw (← do
          (memory_exception vaddr e)) ) : SailME ExecutionResult (physaddr × page_based_mem_type) )
  let width := width
  let mem_val ← (( do
    match (← (mem_write_ea paddr width access pbmt (aq && rl) rl true)) with
    | .Err (exc_addr, e) =>
      SailME.throw (← do
          assert (exc_addr == paddr) "extensions/cfi/zicfiss_insts.sail:206.30-206.31"
          (memory_exception vaddr e))
    | .Ok _ =>
      (do
        match (← (mem_read access pbmt paddr width aq (aq && rl) true)) with
        | .Err (exc_addr, e) =>
          SailME.throw (← do
              assert (exc_addr == paddr) "extensions/cfi/zicfiss_insts.sail:212.32-212.33"
              (memory_exception vaddr e))
        | .Ok v => (pure v)) ) : SailME ExecutionResult (BitVec (width * 8)) )
  assert ((width == 4) || ((xlen == 64) && (width == 8))) "extensions/cfi/zicfiss_insts.sail:220.48-220.49"
  let write_val ← (( do (pure (Sail.BitVec.extractLsb (← (rX_bits rs2)) ((width *i 8) -i 1) 0))
    ) : SailME ExecutionResult (BitVec (width * 8)) )
  match (← (mem_write_value paddr width write_val access pbmt (aq && rl) rl true)) with
  | .Ok true => (wX_bits rd (sign_extend (m := 64) mem_val))
  | .Ok false =>
    (internal_error "extensions/cfi/zicfiss_insts.sail" 227
      "AMOSWAP_SS got false from mem_write_value")
  | .Err (exc_addr, e) =>
    SailME.throw (← do
        assert (exc_addr == paddr) "extensions/cfi/zicfiss_insts.sail:230.30-230.31"
        (memory_exception vaddr e))
  (pure RETIRE_SUCCESS)

def execute_SRET (_ : Unit) : SailM ExecutionResult := do
  let sret_illegal ← (( do
    match (← readReg cur_privilege) with
    | .User => (pure true)
    | .Supervisor =>
      (pure ((not (← (currentlyEnabled Ext_S))) || ((_get_Mstatus_TSR (← readReg mstatus)) == 1#1)))
    | .Machine => (pure (not (← (currentlyEnabled Ext_S))))
    | .VirtualUser =>
      (internal_error "extensions/I/base_insts.sail" 607 "Hypervisor extension not supported")
    | .VirtualSupervisor =>
      (internal_error "extensions/I/base_insts.sail" 608 "Hypervisor extension not supported") ) :
    SailM Bool )
  if (sret_illegal : Bool)
  then (pure (Illegal_Instruction ()))
  else
    (do
      if ((not (ext_check_xret_priv Supervisor)) : Bool)
      then (pure (Ext_XRET_Priv_Failure ()))
      else
        (do
          let prev_priv ← do readReg cur_privilege
          writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 1 1
            (_get_Mstatus_SPIE (← readReg mstatus)))
          writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 5 5 1#1)
          writeReg cur_privilege (← do
            if (((_get_Mstatus_SPP (← readReg mstatus)) == 1#1) : Bool)
            then (pure Supervisor)
            else (pure User))
          writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 8 8 0#1)
          if ((bne (← readReg cur_privilege) Machine) : Bool)
          then writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 17 17 0#1)
          else (pure ())
          if ((hartSupports Ext_Zicfilp) : Bool)
          then (zicfilp_restore_elp_on_xret sRET (← readReg cur_privilege))
          else (pure ())
          (long_csr_write_callback "mstatus" "mstatush" (← readReg mstatus))
          if ((get_config_print_exception ()) : Bool)
          then
            (discard <| pure (print_endline
                (HAppend.hAppend "ret-ing from "
                  (HAppend.hAppend (← (privLevel_to_str prev_priv))
                    (HAppend.hAppend " to " (← (privLevel_to_str (← readReg cur_privilege))))))))
          else (pure ())
          (set_next_pc (← (prepare_xret_target Supervisor)))
          let _ : Unit := (xret_callback false)
          (pure RETIRE_SUCCESS)))

