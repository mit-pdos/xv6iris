/-- Type quantifiers: width : Nat, k_ex1241152_ : Bool, k_ex1241151_ : Bool, List.elem width
  [1, 2, 4, 8] -/
def execute_SSAMOSWAP (aq : Bool) (rl : Bool) (rs2 : regidx) (rs1 : regidx) (width : Nat) (rd : regidx) : SailM ExecutionResult := SailME.run do
  match (← readReg cur_privilege) with
  | .Machine =>
    (do
      if ((not (← (currentlyEnabled Ext_S))) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else (pure ()))
  | .Supervisor =>
    (do
      if (((_get_MEnvcfg_SSE (← readReg menvcfg)) == 0#1) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else (pure ()))
  | .User =>
    (do
      if ((← do
           if ((not (← (currentlyEnabled Ext_S))) : Bool)
           then (pure true)
           else (pure ((_get_SEnvcfg_SSE (← (read_senvcfg ()))) == 0#1))) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else (pure ()))
  | .VirtualSupervisor =>
    (do
      if (((_get_MEnvcfg_SSE (← readReg menvcfg)) == 0#1) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else
        (do
          if (((_get_HEnvcfg_SSE (← (read_henvcfg ()))) == 0#1) : Bool)
          then SailME.throw ((Virtual_Instruction ()) : ExecutionResult)
          else (pure ())))
  | .VirtualUser =>
    (do
      if (((_get_MEnvcfg_SSE (← readReg menvcfg)) == 0#1) : Bool)
      then SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
      else
        (do
          if (((_get_SEnvcfg_SSE (← (read_senvcfg ()))) == 0#1) : Bool)
          then SailME.throw ((Virtual_Instruction ()) : ExecutionResult)
          else (pure ())))
  let access := (Atomic (AMOSWAP, aq, rl, ShadowStack, ShadowStack))
  let access_info ← do (default_access_info access)
  let eff_priv := access_info.eff_privilege
  let vaddr ← (( do
    match (← (get_transformed_data_addr rs1 (zeros (n := 64)) access access_info width)) with
    | .Ext_DataAddr_Error e => SailME.throw ((Ext_DataAddr_Check_Failure e) : ExecutionResult)
    | .Ext_DataAddr_OK vaddr => (pure vaddr) ) : SailME ExecutionResult virtaddr )
  match (← (match_memory_trigger_before (← readReg cur_privilege)
      (TriggerAddress (TriggerAddress_AMO, (bits_of_virtaddr vaddr), width)))) with
  | .some pti => SailME.throw ((PendingTrigger pti) : ExecutionResult)
  | none => (pure ())
  if ((not (is_aligned_vaddr vaddr width)) : Bool)
  then
    (do
      match (plat_misaligned_exception access false) with
      | .some .AccessFault =>
        SailME.throw (← do
            (memory_exception (E_SAMO_Access_Fault ()) (bits_of_virtaddr vaddr) access_info))
      | .some .AlignmentException =>
        SailME.throw (← do
            (memory_exception (E_SAMO_Addr_Align ()) (bits_of_virtaddr vaddr) access_info))
      | none => (pure ()))
  else (pure ())
  let (paddr, pbmt) ← (( do
    match (← (translateAddr vaddr access eff_priv)) with
    | .Ok (addr, pbmt, _) => (pure (addr, pbmt))
    | .Err (e, _) =>
      SailME.throw (← do
          (trap e)) ) : SailME ExecutionResult (physaddr × page_based_mem_type) )
  let width := width
  let mem_val ← (( do
    match (← (mem_write_ea paddr width eff_priv access pbmt (aq && rl) rl true)) with
    | .Err (exc_addr, e) =>
      SailME.throw (← do
          sail_assert (exc_addr == paddr) "extensions/cfi/zicfiss_insts.sail:222.30-222.31"
          let exc_vaddr ← do (exception_vaddr access_info vaddr paddr exc_addr)
          (memory_exception e exc_vaddr access_info))
    | .Ok _ =>
      (do
        match (← (mem_read access pbmt eff_priv paddr width aq (aq && rl) true)) with
        | .Err (exc_addr, e) =>
          SailME.throw (← do
              sail_assert (exc_addr == paddr) "extensions/cfi/zicfiss_insts.sail:229.32-229.33"
              let exc_vaddr ← do (exception_vaddr access_info vaddr paddr exc_addr)
              (memory_exception e exc_vaddr access_info))
        | .Ok v => (pure v)) ) : SailME ExecutionResult (BitVec (8 * width)) )
  sail_assert ((width == 4) || ((xlen == 64) && (width == 8))) "extensions/cfi/zicfiss_insts.sail:238.48-238.49"
  let write_val ← (( do (pure (Sail.BitVec.extractLsb (← (rX_bits rs2)) ((width *i 8) -i 1) 0))
    ) : SailME ExecutionResult (BitVec (8 * width)) )
  match (← (mem_write_value paddr width write_val eff_priv access pbmt (aq && rl) rl true)) with
  | .Ok true => (wX_bits rd (sign_extend (m := 64) mem_val))
  | .Ok false =>
    (internal_error "extensions/cfi/zicfiss_insts.sail" 245
      "AMOSWAP_SS got false from mem_write_value")
  | .Err (exc_addr, e) =>
    SailME.throw (← do
        sail_assert (exc_addr == paddr) "extensions/cfi/zicfiss_insts.sail:248.30-248.31"
        let exc_vaddr ← do (exception_vaddr access_info vaddr paddr exc_addr)
        (memory_exception e exc_vaddr access_info))
  (match_memory_trigger_after (← readReg cur_privilege)
    (TriggerAMOData
      ((bits_of_virtaddr vaddr), (zero_extend (m := (8 *i 16)) mem_val), (zero_extend
        (m := (8 *i 16)) write_val), width)))
  (pure RETIRE_SUCCESS)

def execute_SRET (_ : Unit) : SailM ExecutionResult := do
  let sret_illegal ← (( do
    match (← readReg cur_privilege) with
    | .User => (pure true)
    | .Supervisor =>
      (do
        if ((not (← (currentlyEnabled Ext_S))) : Bool)
        then (pure true)
        else (pure ((_get_Mstatus_TSR (← readReg mstatus)) == 1#1)))
    | .Machine => (pure (not (← (currentlyEnabled Ext_S))))
    | .VirtualUser => (pure false)
    | .VirtualSupervisor => (pure false) ) : SailM Bool )
  let sret_virtual ← (( do
    match (← readReg cur_privilege) with
    | .VirtualUser => (pure true)
    | .VirtualSupervisor => (pure ((_get_Hstatus_VTSR (← readReg hstatus)) == 1#1))
    | _ => (pure false) ) : SailM Bool )
  if (sret_illegal : Bool)
  then (pure (Illegal_Instruction ()))
  else
    (do
      if (sret_virtual : Bool)
      then (pure (Virtual_Instruction ()))
      else
        (do
          if ((not (ext_check_xret_priv Supervisor)) : Bool)
          then (pure (Ext_XRET_Priv_Failure ()))
          else
            (do
              let prev_priv ← do readReg cur_privilege
              let ret ← do
                if ((← (inVirtualPrivilege ())) : Bool)
                then
                  (do
                    let new_priv ← do
                      if (((_get_Mstatus_SPP (← readReg vsstatus)) == 1#1) : Bool)
                      then (pure VirtualSupervisor)
                      else (pure VirtualUser)
                    writeReg vsstatus (Sail.BitVec.updateSubrange (← readReg vsstatus) 8 8 0#1)
                    writeReg vsstatus (Sail.BitVec.updateSubrange (← readReg vsstatus) 1 1
                      (_get_Mstatus_SPIE (← readReg vsstatus)))
                    writeReg vsstatus (Sail.BitVec.updateSubrange (← readReg vsstatus) 5 5 1#1)
                    writeReg cur_privilege new_priv
                    (pure VirtualSupervisor))
                else
                  (do
                    let new_priv ← do
                      (privLevel_bits_forwards
                        ((0#1 +++ (_get_Mstatus_SPP (← readReg mstatus))), ((_get_Hstatus_SPV
                            (← readReg hstatus)) &&& (bool_to_bit (← (currentlyEnabled Ext_H))))))
                    writeReg hstatus (Sail.BitVec.updateSubrange (← readReg hstatus) 7 7 0#1)
                    writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 8 8 0#1)
                    writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 1 1
                      (_get_Mstatus_SPIE (← readReg mstatus)))
                    writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 5 5 1#1)
                    if ((bne new_priv Machine) : Bool)
                    then
                      writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 17 17 0#1)
                    else (pure ())
                    writeReg cur_privilege new_priv
                    (pure Supervisor))
              (xret_clear_dbltrp prev_priv (← readReg cur_privilege))
              if ((hartSupports Ext_Zicfilp) : Bool)
              then (zicfilp_restore_elp_on_xret sRET prev_priv (← readReg cur_privilege))
              else (pure ())
              (long_csr_write_callback "mstatus" "mstatush" (← (read_mstatus ())))
              if ((← do
                   if ((privLevel_is_virtual prev_priv) : Bool)
                   then (pure true)
                   else (xret_modifies_vsstatus prev_priv (← readReg cur_privilege))) : Bool)
              then
                (csr_name_write_callback "vsstatus"
                  (Sail.BitVec.extractLsb (← readReg vsstatus) (xlen -i 1) 0))
              else
                (do
                  if ((← (currentlyEnabled Ext_H)) : Bool)
                  then
                    (csr_name_write_callback "hstatus"
                      (Sail.BitVec.extractLsb (← readReg hstatus) (xlen -i 1) 0))
                  else (pure ()))
              if ((get_config_print_exception ()) : Bool)
              then
                (discard <| pure (print_endline
                    (HAppend.hAppend "ret-ing from "
                      (HAppend.hAppend (← (privLevel_to_str prev_priv))
                        (HAppend.hAppend " to " (← (privLevel_to_str (← readReg cur_privilege))))))))
              else (pure ())
              (set_next_pc (← (prepare_xret_target ret)))
              let _ : Unit := (xret_callback false)
              (pure RETIRE_SUCCESS))))

