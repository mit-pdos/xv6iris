def execute_ZICBOZ (rs1 : regidx) : SailM ExecutionResult := SailME.run do
  match (← (feature_enabled_for_priv (← readReg cur_privilege)
      (_get_MEnvcfg_CBZE (← readReg menvcfg)) (_get_SEnvcfg_CBZE (← (read_senvcfg ())))
      (_get_HEnvcfg_CBZE (← (read_henvcfg ()))))) with
  | .FEATURE_ENABLED => (pure ())
  | .FEATURE_ILLEGAL => SailME.throw ((Illegal_Instruction ()) : ExecutionResult)
  | .FEATURE_VIRTUAL => SailME.throw ((Virtual_Instruction ()) : ExecutionResult)
  let rs1_val ← do (rX_bits rs1)
  let cache_block_size := (2 ^i plat_cache_block_size_exp)
  let access : (MemoryAccessType mem_payload) := (CacheAccess (CB_zero ()))
  let access_info ← do (default_access_info access)
  let eff_priv := access_info.eff_privilege
  let negative_offset :=
    ((rs1_val &&& (Complement.complement
          (zero_extend (m := 64) (ones (n := plat_cache_block_size_exp))))) - rs1_val)
  match (← (get_transformed_data_addr rs1 negative_offset access access_info cache_block_size)) with
  | .Ext_DataAddr_Error e => (pure (Ext_DataAddr_Check_Failure e))
  | .Ext_DataAddr_OK vaddr =>
    (do
      match (← (match_memory_trigger_before (← readReg cur_privilege)
          (TriggerAddress (TriggerAddress_Store, (bits_of_virtaddr vaddr), cache_block_size)))) with
      | .some pti => SailME.throw ((PendingTrigger pti) : ExecutionResult)
      | none => (pure ())
      let vaddr_for_error := (sub_virtaddr_xlenbits vaddr negative_offset)
      match (← (translateAddr vaddr access eff_priv)) with
      | .Err (e, _) => (trap { e with excinfo := (bits_of_virtaddr vaddr_for_error) })
      | .Ok (paddr, pbmt, _) =>
        (do
          let paddr_for_error := (sub_physaddr_xlenbits paddr negative_offset)
          match (← (mem_write_ea paddr cache_block_size eff_priv access pbmt false false false)) with
          | .Err (exc_addr, e) =>
            (do
              sail_assert (exc_addr == paddr) "extensions/Zicboz/zicboz_insts.sail:73.38-73.39"
              let exc_vaddr ← do
                (exception_vaddr access_info vaddr_for_error paddr_for_error paddr_for_error)
              (memory_exception e exc_vaddr access_info))
          | .Ok _ =>
            (do
              match (← (mem_write_value paddr cache_block_size
                  (zeros (n := (8 *i (2 ^i plat_cache_block_size_exp)))) eff_priv access pbmt false
                  false false)) with
              | .Ok true => (pure RETIRE_SUCCESS)
              | .Ok false =>
                (internal_error "extensions/Zicboz/zicboz_insts.sail" 81
                  "store got false from mem_write_value")
              | .Err (exc_addr, e) =>
                (do
                  sail_assert (exc_addr == paddr) "extensions/Zicboz/zicboz_insts.sail:84.42-84.43"
                  let exc_vaddr ← do
                    (exception_vaddr access_info vaddr_for_error paddr_for_error paddr_for_error)
                  (memory_exception e exc_vaddr access_info)))))

