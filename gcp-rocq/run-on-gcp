#!/usr/bin/env bash
# Run a command against the shared Rocq build VM as if it were local.
#
#   cd ~/work/perennial
#   run-on-gcp make -j 36
#
# Starts the VM if preemption stopped it, mirrors the current directory to a
# per-directory work tree on the persistent disk, then runs the command there
# and streams the output back. Exit status is the remote command's.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=config.sh
source "$HERE/config.sh"

say()  { [[ -n "${QUIET:-}" ]] || printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m warn:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

g() { gcloud --project="$PROJECT" "$@"; }

usage() {
  cat <<EOF
usage: run-on-gcp [options] <command> [args...]

  Runs <command> on the shared Rocq VM, in a remote mirror of \$PWD.

options:
  --proofs             build the Rocq proofs, safely (see below). Takes make
                       arguments: --proofs -k, --proofs SomeFile.vo
  --shell              open an interactive shell in the remote work tree
  --sync-only          push the tree and exit, running nothing
  --no-sync            skip the push (use the tree as it already is remotely)
  --pull PATH          after the command, copy PATH back from remote (repeatable)
  --pull-vo            after the command, copy build artifacts (.vo/.glob/...)
                       back, so a local single-file rocq compile can find its
                       dependencies. Works standalone too.
  --no-checksum        decide what to send by mtime+size rather than content
                       (faster on huge trees, see the note in config.sh)
  --check-dumps        verify the VM's tracked generated sources match this
                       checkout, then exit
  --status             show VM state and idle timer, then exit
  --start / --stop     power the VM on or off, then exit
  --where              print the remote path for \$PWD, then exit
  -q, --quiet          suppress progress chatter
  -h, --help           this message

examples:
  run-on-gcp --proofs                 # the whole tree
  run-on-gcp --proofs -k              # ... don't stop at the first error
  run-on-gcp --pull doc/ make doc
  run-on-gcp --shell

Use --proofs rather than 'make': a top-level make on the VM reaches the dump
rules, which regenerate the tracked kernel-rocq/user-rocq sources from whatever
ELF the VM has and clobber the image the sync just pushed. --proofs drives each
sub-tree through its own CoqMakefile, so no dump rule can run, and it verifies
the tracked dumps are byte-identical afterwards anyway.
EOF
}

# ------------------------------------------------------------------ options
declare -a PULL_PATHS=()
DO_SYNC=1; SHELL_MODE=0; SYNC_ONLY=0; PULL_VO=0; PROOFS=0
ACTION=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --proofs)      PROOFS=1; shift; break ;;
    --shell)       SHELL_MODE=1; shift ;;
    --sync-only)   SYNC_ONLY=1; shift ;;
    --no-sync)     DO_SYNC=0; shift ;;
    --pull)        [[ $# -ge 2 ]] || die "--pull needs a path"; PULL_PATHS+=("$2"); shift 2 ;;
    --pull-vo)     PULL_VO=1; shift ;;
    --no-checksum) USE_CHECKSUM=0; shift ;;
    --check-dumps) ACTION=check-dumps; shift ;;
    --status)      ACTION=status; shift ;;
    --start)       ACTION=start; shift ;;
    --stop)        ACTION=stop; shift ;;
    --where)       ACTION=where; shift ;;
    -q|--quiet)    QUIET=1; shift ;;
    -h|--help)     usage; exit 0 ;;
    --)            shift; break ;;
    -*)            die "unknown option: $1 (use -- to pass flags to the command)" ;;
    *)             break ;;
  esac
done

# ------------------------------------------------------------------ zone/ssh
resolve_zone() {
  [[ -n "$ZONE" ]] && return
  ZONE="$(g compute instances list --filter="name~^$INSTANCE\$" \
            --format='value(zone.basename())' 2>/dev/null | head -n1)"
  [[ -n "$ZONE" ]] || die "cannot find instance $INSTANCE; run provision-gcp.sh first"
}

mkdir -p "$STATE_DIR"
# HostKeyAlias is what makes the changing external IP a non-issue: the host key
# is recorded against the instance name, so a restart on a new address does not
# look like a man-in-the-middle.
SSH_OPTS=(
  -i "$SSH_KEY"
  -o "HostKeyAlias=$INSTANCE"
  -o "UserKnownHostsFile=$STATE_DIR/known_hosts"
  -o StrictHostKeyChecking=accept-new
  -o ControlMaster=auto
  -o "ControlPath=$STATE_DIR/cm-$INSTANCE"
  -o ControlPersist=10m
  -o ServerAliveInterval=30
  -o LogLevel=ERROR
)

ssh_e_string() {
  local s=ssh o
  for o in "${SSH_OPTS[@]}"; do s+=" $(printf %q "$o")"; done
  printf '%s' "$s"
}

instance_status() {
  g compute instances describe "$INSTANCE" --zone="$ZONE" --format='value(status)' 2>/dev/null
}

instance_ip() {
  g compute instances describe "$INSTANCE" --zone="$ZONE" \
    --format='value(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null
}

# Spot capacity is not guaranteed at start time. Retry a few times before
# giving up, and tell the user exactly how to fall back rather than silently
# converting the instance to on-demand and quietly changing what they pay.
ensure_running() {
  local status attempt=0
  status="$(instance_status)"
  [[ -n "$status" ]] || die "instance $INSTANCE not found in $ZONE"

  while [[ "$status" != "RUNNING" ]]; do
    case "$status" in
      TERMINATED|STOPPED)
        # NOT (( attempt++ )): post-increment evaluates to the old value, so on
        # the first pass the arithmetic yields 0, which bash reports as exit
        # status 1 -- and under set -e that aborts the script instead of
        # retrying. This is the preemption-recovery path; it must not be clever.
        attempt=$(( attempt + 1 ))
        (( attempt > 3 )) && die "could not start $INSTANCE after 3 attempts.
Spot capacity in $ZONE may be exhausted. To run on-demand instead (the
instance must be TERMINATED, and all three flags are required -- the legacy
preemptible field and the Spot-only termination action both have to go):
  gcloud compute instances set-scheduling $INSTANCE --zone=$ZONE \\
    --no-preemptible --provisioning-model=STANDARD --clear-instance-termination-action
(it is set-scheduling, NOT 'instances update', which has no such flag.
See claude-notes/remote-build-gcp.md for the errors each flag answers.)"
        say "instance is $status; starting (attempt $attempt)"
        if ! g compute instances start "$INSTANCE" --zone="$ZONE" 2>"$STATE_DIR/start.err"; then
          warn "start failed: $(tail -n2 "$STATE_DIR/start.err" | tr '\n' ' ')"
          sleep 20
        fi
        ;;
      SUSPENDED)
        say "instance suspended; resuming"
        g compute instances resume "$INSTANCE" --zone="$ZONE" ;;
      PROVISIONING|STAGING|STOPPING|SUSPENDING)
        say "instance is $status; waiting"; sleep 5 ;;
      *)
        die "unexpected instance status: $status" ;;
    esac
    status="$(instance_status)"
  done
}

wait_for_ssh() {
  local ip deadline
  ip="$1"
  deadline=$(( SECONDS + 300 ))
  while (( SECONDS < deadline )); do
    ssh "${SSH_OPTS[@]}" -o ConnectTimeout=5 "$SSH_USER@$ip" true 2>/dev/null && return 0
    sleep 5
  done
  die "timed out waiting for ssh on $ip"
}

# ------------------------------------------------------------------ mapping
# Flatten the local path into a single remote directory name, the same trick
# Claude Code uses for its own project dirs: /root/work/perennial becomes
# _root_work_perennial. Flattening is lossy (/a/b_c and /a/b/c collide), so
# each remote tree records the local path it came from in .source-path.
remote_dir_for() {
  local p="${1%/}"
  printf '%s/%s' "$TREES_DIR" "${p//\//_}"
}

LOCAL_DIR="$PWD"
REMOTE_DIR="$(remote_dir_for "$LOCAL_DIR")"

if [[ "$ACTION" == "where" ]]; then
  printf '%s\n' "$REMOTE_DIR"; exit 0
fi

# Syncing a home directory or / is almost never intended and would be slow
# and destructive enough to be worth blocking outright.
case "$LOCAL_DIR" in
  / | "$HOME") die "refusing to sync $LOCAL_DIR; cd into a project directory first" ;;
esac

# ------------------------------------------------------------------ actions
resolve_zone

case "$ACTION" in
  status)
    st="$(instance_status)"
    printf 'instance : %s (%s)\n' "$INSTANCE" "$st"
    printf 'zone     : %s\n' "$ZONE"
    if [[ "$st" == "RUNNING" ]]; then
      ip="$(instance_ip)"
      printf 'address  : %s\n' "$ip"
      ssh "${SSH_OPTS[@]}" -o ConnectTimeout=5 "$SSH_USER@$ip" \
        'now=$(date +%s); last=$(cat /run/rocq-last-active 2>/dev/null || echo "$now");
         echo "idle for : $(( now - last ))s";
         echo "uptime   : $(uptime -p)";
         echo "load     : $(cut -d" " -f1-3 /proc/loadavg)";
         [ -e '"$DATA_MOUNT"'/.keep-awake ] && echo "keep-awake: SET (will not auto-stop)"' 2>/dev/null || true
    fi
    exit 0 ;;
  start)
    ensure_running; say "running at $(instance_ip)"; exit 0 ;;
  stop)
    say "stopping $INSTANCE"; g compute instances stop "$INSTANCE" --zone="$ZONE"; exit 0 ;;
esac

if (( SYNC_ONLY == 0 && SHELL_MODE == 0 && PULL_VO == 0 && PROOFS == 0 )) \
   && [[ $# -eq 0 && "$ACTION" != check-dumps ]]; then
  usage; exit 2
fi

ensure_running
IP="$(instance_ip)"
[[ -n "$IP" ]] || die "instance has no external IP"
wait_for_ssh "$IP"

# ------------------------------------------------------------------ sync
# Delete the build artifacts of every .v the push just replaced.
#
# --checksum --no-times gets the common case right, but not this one: if a file
# is edited WHILE a remote build is running, the .vo that build produces is
# stamped with a later remote clock than the .v the next sync writes, so make
# considers it up to date and the edit is silently never compiled -- the file
# simply stops appearing in any compile line while its errors are still in the
# source. Removing the artifacts of exactly the files we just transferred makes
# that impossible, and costs nothing when nothing changed.
drop_stale_artifacts() {
  local -a vs=()
  local f
  for f in "$@"; do [[ "$f" == *.v ]] && vs+=( "$f" ); done
  (( ${#vs[@]} )) || return 0

  local script='cd "$1" || exit 0; shift
    for v in "$@"; do b="${v%.v}"; rm -f "$b".vo "$b".vos "$b".vok "$b".glob \
      "$(dirname "$b")/.$(basename "$b").aux"; done'
  say "dropping stale artifacts for ${#vs[@]} changed .v"
  ssh "${SSH_OPTS[@]}" "$SSH_USER@$IP" \
    "bash -s -- $(printf %q "$REMOTE_DIR") $(printf '%q ' "${vs[@]}")" \
    <<<"$script" || warn "could not drop stale artifacts"
}

sync_tree() {
  local -a excl=() rsync_args=()
  local x
  for x in "${ROCQ_EXCLUDES[@]}"; do excl+=( --exclude="$x" ); done
  (( SYNC_GIT )) || excl+=( --exclude='.git/' )
  # Per-directory .gitignore merge. Anything git ignores is either a build
  # artifact or something the VM produces itself, and in both cases it must be
  # neither sent nor deleted by --delete.
  (( USE_GITIGNORE )) && excl+=( --filter=':- .gitignore' )

  ssh "${SSH_OPTS[@]}" "$SSH_USER@$IP" \
    "mkdir -p $(printf %q "$REMOTE_DIR")"
  printf '%s\n' "$LOCAL_DIR" | ssh "${SSH_OPTS[@]}" "$SSH_USER@$IP" \
    "cat > $(printf %q "$REMOTE_DIR/.source-path")"

  # --checksum --no-times is the pair that makes incremental make correct.
  #
  # --checksum decides what to send by content, so mtimes play no part in the
  # transfer decision. --no-times then leaves each transferred file stamped
  # with its remote write time, and leaves untransferred files alone entirely.
  # The result is exactly what make wants: edited files come out newer than
  # their .vo, untouched files stay older, and every timestamp involved comes
  # from the VM's clock -- so skew against the local machine cannot cause a
  # missed or spurious rebuild.
  #
  # Plain -a would be wrong here: it fixes up mtimes even on files it does not
  # transfer, so remote timestamps would track the *local* clock, and a file
  # whose content changed while its mtime moved backwards (restore from
  # backup, cp -p, tar extract) would land older than its .vo and be silently
  # skipped by make.
  rsync_args=( -a --delete --out-format='%i %n' )
  if (( USE_CHECKSUM )); then
    rsync_args+=( --checksum --no-times )
  fi

  local out rc=0
  out="$(mktemp)"
  say "syncing $LOCAL_DIR -> $REMOTE_DIR"
  rsync "${rsync_args[@]}" "${excl[@]}" \
        -e "$(ssh_e_string)" \
        "$LOCAL_DIR/" "$SSH_USER@$IP:$REMOTE_DIR/" > "$out" 2>&1 || rc=$?
  if (( rc != 0 )); then
    cat "$out" >&2; rm -f "$out"; die "rsync failed (exit $rc)"
  fi

  local -a changed=()
  mapfile -t changed < <(awk '$1 ~ /^[<>]f/ { sub(/^[^ ]+ /, ""); print }' "$out")
  rm -f "$out"

  if (( ${#changed[@]} )); then
    say "updated ${#changed[@]} file(s)"
    drop_stale_artifacts "${changed[@]}"
  else
    say "already up to date"
  fi

  if (( ! USE_CHECKSUM )); then
    # In mtime mode rsync preserves source timestamps, so a file whose content
    # changed while its mtime moved backwards will land older than its .vo and
    # make will skip it. Rare, but silent when it happens.
    warn "--no-checksum: an edit whose mtime moves backwards can be missed by make"
  fi
}

(( DO_SYNC )) && sync_tree
(( SYNC_ONLY )) && exit 0

# ------------------------------------------------------------------ run
# bash -l so /etc/profile.d/rocq-opam.sh puts the shared switch on PATH.
run_remote() {
  local inner tty=()
  [[ -t 0 && -t 1 ]] && tty=(-t)

  if (( SHELL_MODE )); then
    inner="cd $(printf %q "$REMOTE_DIR") && exec bash -l"
    tty=(-t)
  else
    inner="cd $(printf %q "$REMOTE_DIR") && $(printf '%q ' "$@")"
  fi

  local rc=0
  ssh "${SSH_OPTS[@]}" "${tty[@]}" "$SSH_USER@$IP" \
      "bash -lc $(printf %q "$inner")" || rc=$?
  return $rc
}

# Bring the VM-built artifacts back so a single file can be rechecked locally
# without rebuilding the tree here.
pull_artifacts() {
  local -a filt=( --include='*/' )
  local p
  for p in "${ARTIFACT_PATTERNS[@]}"; do filt+=( --include="$p" ); done
  filt+=( --exclude='*' )

  say "pulling build artifacts from $REMOTE_DIR"
  # -a preserves the VM's build times on purpose: a pulled .vo then stays
  # newer than the .v it was built from, so neither make nor rocq considers it
  # stale here. It also keeps the quick-check meaningful, so repeat pulls only
  # move what actually changed. No --delete -- local files the VM has never
  # heard of are not its business.
  # --no-owner --no-group: -a would try to reproduce the VM's uid/gid here, and
  # when the local side is root in a user namespace that cannot represent them
  # every file draws a chown failure. Ownership of build artifacts is not
  # something we want to carry across machines anyway.
  local rc=0
  rsync -a --no-owner --no-group --prune-empty-dirs "${filt[@]}" \
        -e "$(ssh_e_string)" \
        "$SSH_USER@$IP:$REMOTE_DIR/" "$LOCAL_DIR/" || rc=$?
  if (( rc != 0 )); then
    warn "artifact pull failed (rsync exit $rc)"
    return $rc
  fi
  say "pulled $(find "$LOCAL_DIR" -name '*.vo' | wc -l) .vo into $LOCAL_DIR"
}

# ------------------------------------------------------------------ proofs
# Prove the VM's copies of the generated-and-tracked dumps are byte-identical
# to the ones in this checkout.
#
# This is the check that used to be a line of documentation asking the user to
# run md5sum by hand after every remote build. Comparing REMOTE against LOCAL,
# rather than before against after, is what makes it catch a tree some earlier
# run already poisoned -- which is the case that actually bites, because the
# damage surfaces far away and much later, as a bogus address failure at the
# bottom of the tree.
dump_sums_local() {
  local d
  for d in "${DUMP_GUARD_DIRS[@]:-}"; do
    [[ -d "$LOCAL_DIR/$d" ]] || continue
    ( cd "$LOCAL_DIR" && md5sum "$d"/*.v 2>/dev/null )
  done | sort
}

dump_sums_remote() {
  local -a dirs=("${DUMP_GUARD_DIRS[@]:-}")
  (( ${#dirs[@]} )) || return 0
  local script='cd "$1" || exit 0; shift
    for d in "$@"; do [ -d "$d" ] && md5sum "$d"/*.v 2>/dev/null; done | sort'
  ssh "${SSH_OPTS[@]}" "$SSH_USER@$IP" \
    "bash -s -- $(printf %q "$REMOTE_DIR") $(printf '%q ' "${dirs[@]}")" \
    <<<"$script" 2>/dev/null || true
}

check_dumps() {
  local want have
  want="$(dump_sums_local)"
  [[ -n "$want" ]] || return 0
  have="$(dump_sums_remote)"
  [[ "$want" == "$have" ]] && return 0
  warn "THE VM'S TRACKED DUMPS DO NOT MATCH THIS CHECKOUT -- a dump rule ran there."
  diff <(printf '%s\n' "$want") <(printf '%s\n' "$have") >&2 || true
  warn "every proof built against them is about a different image."
  die "re-sync and rebuild: run-on-gcp --proofs (never a bare remote 'make')"
}

# The safe build: each sub-tree through its OWN generated CoqMakefile, in
# dependency order. No dump rule exists on this path, so the tracked image
# cannot move -- and the guard below proves it rather than trusting it.
run_proofs() {
  local jobs="${ROCQ_BUILD_JOBS:-}"   # empty => the remote picks nproc
  local rc=0

  local script
  script=$(cat <<'REMOTE'
set -uo pipefail
tree="$1"; jobs="${2:-$(nproc)}"; main="$3"; shift 3
cd "$tree" || exit 1
command -v rocq >/dev/null || { echo "rocq not on PATH: re-run provision-gcp.sh" >&2; exit 1; }
subs=(); while [ "$1" != "--" ]; do subs+=("$1"); shift; done; shift
for d in "${subs[@]}" "$main"; do
  [ -d "$d" ] || continue
  ( cd "$d" && { [ -f CoqMakefile ] || coq_makefile -f _CoqProject -o CoqMakefile >/dev/null; }     && make -f CoqMakefile -j"$jobs" "$@" ) || exit $?
done
REMOTE
)
  # bash -ls, not bash -s: a LOGIN shell is what sources
  # /etc/profile.d/rocq-opam.sh and puts the switch on PATH.
  say "building proofs (${PROOF_SUBTREES[*]} then $PROOF_MAIN_SUBTREE)"
  ssh "${SSH_OPTS[@]}" "$SSH_USER@$IP" \
    "bash -ls -- $(printf %q "$REMOTE_DIR") $(printf %q "$jobs") \
     $(printf %q "$PROOF_MAIN_SUBTREE") $(printf '%q ' "${PROOF_SUBTREES[@]}") -- \
     $(printf '%q ' "$@")" <<<"$script" || rc=$?

  check_dumps
  return $rc
}

if [[ "$ACTION" == check-dumps ]]; then
  check_dumps
  say "the VM's tracked dumps match this checkout"
  exit 0
fi

RC=0
if (( PROOFS )); then
  run_proofs "$@" || RC=$?
elif (( SHELL_MODE )) || [[ $# -gt 0 ]]; then
  run_remote "$@" || RC=$?
fi

(( PULL_VO )) && pull_artifacts

# ------------------------------------------------------------------ pull
for p in "${PULL_PATHS[@]:-}"; do
  [[ -n "$p" ]] || continue
  say "pulling $p"
  # --no-owner --no-group for the same reason pull_artifacts uses them: -a
  # would try to reproduce the VM's uid/gid here and every file draws a
  # chown failure ("Value too large for defined data type").
  rsync -a --no-owner --no-group -e "$(ssh_e_string)" \
    "$SSH_USER@$IP:$REMOTE_DIR/${p%/}" "$LOCAL_DIR/$(dirname "${p%/}")/" \
    || warn "pull of $p failed"
done

exit $RC
