#!/usr/bin/env bash
# gcp-rocq/vo -- compile individual iris/*.vo targets on the build VM.
#
#   gcp-rocq/vo ProofUvmalloc.vo ProofUvmfree.vo
#   JOBS=8 gcp-rocq/vo ProofFoo.vo
#
# `make proofs` wraps every rocq call in `opam exec --switch=$(PWD)`; a bare
# `make -C iris -f CoqMakefile <target>` does NOT, and fails with "Cannot find
# a physical path bound to logical path stdpp".  This does the wrapping, on
# the remote side, where $PWD is the mirror tree (so the switch it names is
# the remote switch, not this machine's).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
exec "$HERE/run-on-gcp" -q bash -c \
  'opam exec --switch=/shared/xv6rocq -- make -k -C iris -f CoqMakefile -j"${JOBS:-8}" "$@"' \
  _ "$@"
