/-
MachCSL: lean-sail's integer-range loop, and the byte-vector round trips of the memory interface.

Concurrency interface v2 moves memory data as byte vectors: the generated `read_ram` answers
`from_bytes_le` of the vector lean-sail's `sail_mem_read` makes from the answered bits
(`bitvec_to_vecbytes`), and `write_ram` hands `sail_mem_write` the vector `to_bytes_le data`, which
lean-sail folds back into the event's bits (`vecbytes_to_bitvec`).  The language answers and
records bits, so the memory rules need the two round trips; they are proved here, per access width
(1, 2, 4, 8 bytes), by unrolling the generated loops (`IntRange.loop_unfold`), rewriting
lean-sail's `Int`-indexed vector lookup to the `Nat` one, and `bv_decide`.

The two `IntRange` lemmas moved here from `MachCSL/WpPmpDefs.lean` (same names), so that this
file, below the program logic, can use them.
-/
import LeanRV64D.Vector

noncomputable section

namespace MachCSL

open Sail LeanRV64D LeanRV64D.Functions

/-! ## lean-sail's integer-range loop -/

theorem IntRange.forIn'_eq {m : Type → Type} [Monad m] {β : Type} (range : IntRange) (init : β)
    (f : (i : Int) → i ∈ range → β → m (ForInStep β)) :
    IntRange.forIn' range init f = IntRange.forIn'.loop range f init range.start (by simp) := rfl

/-- One unrolling of the loop. -/
theorem IntRange.loop_unfold {m : Type → Type} [Monad m] {β : Type} (range : IntRange)
    (f : (i : Int) → i ∈ range → β → m (ForInStep β)) (b : β) (i : Int) (hs) :
    IntRange.forIn'.loop range f b i hs =
      (if h : i ∈ range then
        f i h b >>= fun r =>
          match r with
          | .done b => (Pure.pure b : m β)
          | .yield b => IntRange.forIn'.loop range f b (i + range.step)
              (by rw [Int.add_comm, Int.add_sub_assoc]; simp_all)
      else (Pure.pure b : m β)) := by
  rw [IntRange.forIn'.loop]; rfl

/-! ## The byte-vector round trips -/

/-- lean-sail's `Int`-indexed lookup (its `GetElem?` instance over `Int`) is the `Nat` one. -/
theorem vec_getElem_int {α : Type} {n : Nat} (c : Vector α n) (i : Int) (h : i.toNat < n) :
    c[i]'h = c[i.toNat]'h := rfl

theorem id_pure {α : Type} (a : α) : (pure a : Id α) = a := rfl

/-- Unroll a generated byte loop of a concrete width. -/
local macro "bytes_unroll" : tactic => `(tactic| (
  simp only [from_bytes_le, to_bytes_le, bitvec_to_vecbytes, Id.run, forIn, forIn',
    IntRange.forIn'_eq]
  (repeat (rw [IntRange.loop_unfold]; simp (config := {decide := true})))
  simp only [id_pure]))

local macro "bytes_rd" : tactic => `(tactic| (
  bytes_unroll
  try simp only [vec_getElem_int, Vector.getElem_ofFn]
  simp [Sail.BitVec.updateSubrange, Sail.BitVec.updateSubrange', Sail.BitVec.slice, vec_getElem_int,
    Vector.getElem_ofFn]
  try bv_decide))

local macro "bytes_wr" : tactic => `(tactic| (
  bytes_unroll
  simp only [vecbytes_to_bitvec, vectorUpdate, vectorInit, Vector.set!, Vector.foldl, Vector.replicate,
    ← Array.foldl_toList]
  simp [List.replicate, List.set, Sail.BitVec.extractLsb]
  try bv_decide))

/-- A read of `n` bytes hands the program back the bits the memory answered. -/
theorem from_bytes_le_vecbytes_1 (w : BitVec 8) :
    from_bytes_le (n := 1) (bitvec_to_vecbytes (n := 1) w) = w := by bytes_rd
theorem from_bytes_le_vecbytes_2 (w : BitVec 16) :
    from_bytes_le (n := 2) (bitvec_to_vecbytes (n := 2) w) = w := by bytes_rd
theorem from_bytes_le_vecbytes_4 (w : BitVec 32) :
    from_bytes_le (n := 4) (bitvec_to_vecbytes (n := 4) w) = w := by bytes_rd
theorem from_bytes_le_vecbytes_8 (w : BitVec 64) :
    from_bytes_le (n := 8) (bitvec_to_vecbytes (n := 8) w) = w := by bytes_rd

/-- A write of `n` bytes puts the program's bits in the event. -/
theorem vecbytes_to_bitvec_to_bytes_le_1 (w : BitVec 8) :
    vecbytes_to_bitvec (to_bytes_le (n := 1) w) = w := by bytes_wr
theorem vecbytes_to_bitvec_to_bytes_le_2 (w : BitVec 16) :
    vecbytes_to_bitvec (to_bytes_le (n := 2) w) = w := by bytes_wr
theorem vecbytes_to_bitvec_to_bytes_le_4 (w : BitVec 32) :
    vecbytes_to_bitvec (to_bytes_le (n := 4) w) = w := by bytes_wr
theorem vecbytes_to_bitvec_to_bytes_le_8 (w : BitVec 64) :
    vecbytes_to_bitvec (to_bytes_le (n := 8) w) = w := by bytes_wr

end MachCSL
